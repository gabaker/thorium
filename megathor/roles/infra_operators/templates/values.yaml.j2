# infra-operators chart values generated by megathor from the inventory (see roles/infra_operators/defaults)
global:
  # moves every operator image (Scylla, ECK, Kubegres) to the mirror
  imageRegistry: {{ (offline_registry if offline | bool else '') | to_json }}
scylla-operator:
  enabled: {{ scylla_operator_enabled | bool | to_json }}
  replicas: {{ scylla_operator_replicas | int }}
  webhookServerReplicas: {{ scylla_operator_replicas | int }}
eck-operator:
  enabled: {{ elastic_operator_enabled | bool | to_json }}
kubegres:
  enabled: {{ kubegres_operator_enabled | bool | to_json }}
