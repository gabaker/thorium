# thorium chart values generated by megathor from the inventory (see roles/thorium/defaults)
global:
  imageRegistry: {{ (offline_registry if offline | bool else '') | to_json }}

secrets:
  clusterName: {{ thorium_deployment_name | to_json }}
  consumers:
    seaweedfs: {{ seaweedfs_enabled | bool | to_json }}
    redis: {{ redis_enabled | bool | to_json }}
    quickwit: {{ quickwit_enabled | bool | to_json }}
  quickwitS3Endpoint: {{ s3_endpoint | to_json }}
  credentials:
    thoriumSecretKey: {{ thorium_secret | to_json }}
    redisPassword: {{ redis_password | to_json }}
    scyllaUsername: {{ scylla_username | to_json }}
    scyllaPassword: {{ scylla_password | to_json }}
    elasticUsername: {{ elastic_username | to_json }}
    elasticPassword: {{ elastic_password | to_json }}
    s3AccessKey: {{ s3_access_key | to_json }}
    s3SecretKey: {{ s3_secret_key | to_json }}
    postgresPassword: {{ quickwit_postgres_super_password | to_json }}
    adminUsername: {{ thorium_admin_username | to_json }}
    adminPassword: {{ thorium_admin_password | to_json }}

infra:
  storageClass: {{ storage_class | default('') | to_json }}
  redis:
    enabled: {{ redis_enabled | bool | to_json }}
    storage: {{ redis_volume_size | to_json }}
    resources:
      requests: { cpu: {{ redis_cpu_requests | to_json }}, memory: {{ redis_memory_requests | to_json }} }
      limits: { cpu: {{ redis_cpu_limits | to_json }}, memory: {{ redis_memory_limits | to_json }} }
  seaweedfs:
    enabled: {{ seaweedfs_enabled | bool | to_json }}
    storage: {{ seaweedfs_volume_size | to_json }}
    buckets: [{{ quickwit_bucket | to_json }}]
    resources:
      requests: { cpu: {{ seaweedfs_cpu_requests | to_json }}, memory: {{ seaweedfs_memory_requests | to_json }} }
      limits: { cpu: {{ seaweedfs_cpu_limits | to_json }}, memory: {{ seaweedfs_memory_limits | to_json }} }
  scylla:
    enabled: {{ scylla_enabled | bool | to_json }}
    members: {{ scylla_members | int }}
    developerMode: {{ scylla_developer_mode | bool | to_json }}
    storage: {{ scylla_storage_size | to_json }}
    resources:
      requests: { cpu: {{ scylla_cpu_requests | to_json }}, memory: {{ scylla_memory_requests | to_json }} }
      limits: { cpu: {{ scylla_cpu_limits | to_json }}, memory: {{ scylla_memory_limits | to_json }} }
  elastic:
    enabled: {{ elastic_enabled | bool | to_json }}
    count: {{ elastic_search_node_count | int }}
    # let Elasticsearch size its heap from the container memory limit
    javaOpts: ""
    storage: {{ elastic_search_volume_size | to_json }}
    resources:
      requests: { cpu: {{ elastic_search_cpu_requests | to_json }}, memory: {{ elastic_search_memory_requests | to_json }} }
      limits: { cpu: {{ elastic_search_cpu_limits | to_json }}, memory: {{ elastic_search_memory_limits | to_json }} }
    kibana:
      enabled: {{ kibana_enabled | bool | to_json }}
      resources:
        requests: { cpu: {{ kibana_cpu_requests | to_json }}, memory: {{ kibana_memory_requests | to_json }} }
        limits: { cpu: {{ kibana_cpu_limits | to_json }}, memory: {{ kibana_memory_limits | to_json }} }
  postgres:
    enabled: {{ quickwit_enabled | bool | to_json }}
    replicas: {{ quickwit_postgres_replicas | int }}
    storage: {{ quickwit_postgress_storage_size | to_json }}
    resources:
      requests: { cpu: {{ quickwit_postgres_cpu_requests | to_json }}, memory: {{ quickwit_postgres_memory_requests | to_json }} }
      limits: { cpu: {{ quickwit_postgres_cpu_limits | to_json }}, memory: {{ quickwit_postgres_memory_limits | to_json }} }
  jaeger:
    enabled: {{ jaeger_enabled | bool | to_json }}
    resources:
      requests: { cpu: {{ jaeger_cpu_requests | to_json }}, memory: {{ jaeger_memory_requests | to_json }} }
      limits: { cpu: {{ jaeger_cpu_limits | to_json }}, memory: {{ jaeger_memory_limits | to_json }} }

quickwit:
  enabled: {{ quickwit_enabled | bool | to_json }}
  config:
    default_index_root_uri: {{ ('s3://' ~ quickwit_bucket ~ '/quickwit-indexes') | to_json }}
    storage:
      s3:
        region: {{ s3_region | to_json }}
{% if s3_flavor | length > 0 %}
        flavor: {{ s3_flavor | to_json }}
{% endif %}
  metastore:
    replicaCount: {{ quickwit_metastore_replica_count | int }}
  searcher:
    replicaCount: {{ quickwit_searcher_replica_count | int }}

operator:
  image:
    repository: {{ ('ghcr.io/' ~ thorium_image) | to_json }}
{% if thorium_version | length > 0 %}
    tag: {{ thorium_version | to_json }}
{% endif %}
{% if thorium_image_pull_secret | length > 0 %}
  imagePullSecret:
    create: true
    dockerconfigjson: {{ thorium_image_pull_secret | to_json | to_json }}
{% endif %}
  banner: {{ thorium_ui_banner | to_json }}
  operator:
    resources:
      requests: { cpu: {{ thorium_operator_cpu_requests | to_json }}, memory: {{ thorium_operator_memory_requests | to_json }} }
      limits: { cpu: {{ thorium_operator_cpu_limits | to_json }}, memory: {{ thorium_operator_memory_limits | to_json }} }
  cluster:
    name: {{ thorium_deployment_name | to_json }}
{% if not thorium_scaler_enabled | bool %}
    components:
      scaler: null
{% endif %}
    scaler:
      nodes: {{ thorium_nodes | to_json }}
  backends:
    scylla:
      replication: {{ scylla_replication_factor | int }}
    s3:
      endpoint: {{ s3_endpoint | to_json }}
      region: {{ s3_thorium_region | to_json }}
      usePathStyle: {{ s3_use_path_style | bool | to_json }}
  ingress:
    type: {{ ('traefik' if thorium_ingress_enabled | bool else 'none') | to_json }}
    host: {{ (thorium_ingress_hostname | default('') if thorium_ingress_hostname | default('') != '*' else '') | to_json }}
    tls:
      secretName: {{ thorium_tls_cert_secret_name | default('') | to_json }}
      # Traefik allows a single default TLSStore, so only the deployment running Traefik sets it
      defaultStore: {{ traefik_enabled | bool | to_json }}
