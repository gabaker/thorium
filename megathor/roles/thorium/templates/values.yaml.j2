# thorium chart values generated by megathor from the inventory (see roles/thorium/defaults)
{# an external Scylla or Elastic without an admin secret already holds Thorium's role or user #}
{% set scylla_external_creds = not scylla_enabled | bool and thorium_scylla_admin_secret | default('', true) | length == 0 %}
{% set elastic_external_creds = not elastic_enabled | bool and thorium_elastic_admin_secret | default('', true) | length == 0 %}
global:
  imageRegistry: {{ (offline_registry if offline | bool else '') | to_json }}
  clusterCIDRs: {{ thorium_cluster_cidrs | to_json }}
  managed:
    scylla: {{ scylla_enabled | bool | to_json }}
    elastic: {{ elastic_enabled | bool | to_json }}
    redis: {{ redis_enabled | bool | to_json }}
    # rook and external S3 stores aren't deployed by the chart, only SeaweedFS is
    s3: {{ seaweedfs_enabled | bool | to_json }}
    # the chart's Postgres only backs the Quickwit metastore, so it's skipped without Quickwit or
    # with an external metastore
    postgres: {{ (quickwit_enabled | bool and quickwit_metastore_uri | default('', true) | length == 0) | to_json }}
  quickwit:
    enabled: {{ quickwit_enabled | bool | to_json }}
    s3Endpoint: {{ s3_endpoint | to_json }}
    metastoreUri: {{ quickwit_metastore_uri | default('', true) | to_json }}

secrets:
  credentials:
    thoriumSecretKey: {{ thorium_secret | to_json }}
    redisPassword: {{ redis_password | to_json }}
    scyllaUsername: {{ (thorium_external_scylla_username if scylla_external_creds else scylla_username) | to_json }}
    scyllaPassword: {{ (thorium_external_scylla_password if scylla_external_creds else scylla_password) | to_json }}
    elasticUsername: {{ (thorium_external_elastic_username if elastic_external_creds else elastic_username) | to_json }}
    elasticPassword: {{ (thorium_external_elastic_password if elastic_external_creds else elastic_password) | to_json }}
    s3AccessKey: {{ s3_access_key | to_json }}
    s3SecretToken: {{ s3_secret_key | to_json }}
    postgresPassword: {{ quickwit_postgres_super_password | to_json }}
    adminUsername: {{ thorium_admin_username | to_json }}
    adminPassword: {{ thorium_admin_password | to_json }}

infra:
  storageClass: {{ storage_class | default('', true) | to_json }}
  redis:
    storage: {{ redis_volume_size | to_json }}
    resources:
      requests: { cpu: {{ redis_cpu_requests | to_json }}, memory: {{ redis_memory_requests | to_json }} }
      limits: { cpu: {{ redis_cpu_limits | to_json }}, memory: {{ redis_memory_limits | to_json }} }
  seaweedfs:
    storage: {{ seaweedfs_volume_size | to_json }}
    buckets: [{{ quickwit_bucket | to_json }}]
    resources:
      requests: { cpu: {{ seaweedfs_cpu_requests | to_json }}, memory: {{ seaweedfs_memory_requests | to_json }} }
      limits: { cpu: {{ seaweedfs_cpu_limits | to_json }}, memory: {{ seaweedfs_memory_limits | to_json }} }
  scylla:
    members: {{ scylla_members | int }}
    developerMode: {{ scylla_developer_mode | bool | to_json }}
    storage: {{ scylla_storage_size | to_json }}
    resources:
      requests: { cpu: {{ scylla_cpu_requests | to_json }}, memory: {{ scylla_memory_requests | to_json }} }
      limits: { cpu: {{ scylla_cpu_limits | to_json }}, memory: {{ scylla_memory_limits | to_json }} }
  elastic:
    count: {{ elastic_search_node_count | int }}
    # let Elasticsearch size its heap from the container memory limit
    javaOpts: ""
    storage: {{ elastic_search_volume_size | to_json }}
    resources:
      requests: { cpu: {{ elastic_search_cpu_requests | to_json }}, memory: {{ elastic_search_memory_requests | to_json }} }
      limits: { cpu: {{ elastic_search_cpu_limits | to_json }}, memory: {{ elastic_search_memory_limits | to_json }} }
    kibana:
      enabled: {{ kibana_enabled | bool | to_json }}
      resources:
        requests: { cpu: {{ kibana_cpu_requests | to_json }}, memory: {{ kibana_memory_requests | to_json }} }
        limits: { cpu: {{ kibana_cpu_limits | to_json }}, memory: {{ kibana_memory_limits | to_json }} }
  postgres:
    replicas: {{ quickwit_postgres_replicas | int }}
    storage: {{ quickwit_postgres_storage_size | to_json }}
    resources:
      requests: { cpu: {{ quickwit_postgres_cpu_requests | to_json }}, memory: {{ quickwit_postgres_memory_requests | to_json }} }
      limits: { cpu: {{ quickwit_postgres_cpu_limits | to_json }}, memory: {{ quickwit_postgres_memory_limits | to_json }} }
  jaeger:
    # Jaeger only reads traces from the chart's Quickwit
    enabled: {{ (jaeger_enabled | bool and quickwit_enabled | bool) | to_json }}
    resources:
      requests: { cpu: {{ jaeger_cpu_requests | to_json }}, memory: {{ jaeger_memory_requests | to_json }} }
      limits: { cpu: {{ jaeger_cpu_limits | to_json }}, memory: {{ jaeger_memory_limits | to_json }} }

quickwit:
  config:
    default_index_root_uri: {{ ('s3://' ~ quickwit_bucket ~ '/quickwit-indexes') | to_json }}
    storage:
      s3:
        region: {{ s3_region | to_json }}
{% if s3_flavor | default('', true) | length > 0 %}
        flavor: {{ s3_flavor | to_json }}
{% endif %}
  metastore:
    replicaCount: {{ quickwit_metastore_replica_count | int }}
  searcher:
    replicaCount: {{ quickwit_searcher_replica_count | int }}

operator:
  image:
    repository: {{ (thorium_container_registry ~ '/' ~ thorium_image if thorium_container_registry | default('', true) | length > 0 else thorium_image) | to_json }}
{% if thorium_version | default('', true) | length > 0 %}
    tag: {{ thorium_version | to_json }}
{% endif %}
    pullPolicy: {{ thorium_image_pull_policy | to_json }}
{% if thorium_image_pull_secret | default({}, true) | length > 0 %}
  createImagePullSecret: true
  dockerConfigJson: {{ thorium_image_pull_secret | to_json | to_json }}
{% endif %}
  banner: {{ thorium_ui_banner | to_json }}
  controller:
    resources:
      requests: { cpu: {{ thorium_operator_cpu_requests | to_json }}, memory: {{ thorium_operator_memory_requests | to_json }} }
      limits: { cpu: {{ thorium_operator_cpu_limits | to_json }}, memory: {{ thorium_operator_memory_limits | to_json }} }
  cluster:
    name: {{ thorium_deployment_name | to_json }}
{% if not thorium_scaler_enabled | bool %}
    components:
      scaler: null
{% endif %}
    scaler:
      k8s:
        nodes: {{ thorium_nodes | to_json }}
    upgrade:
      targetRevision: {{ thorium_upgrade_target_revision | to_json }}
      approvals: {{ thorium_upgrade_approvals | to_json }}
{% if thorium_scylla_admin_secret | default('', true) | length > 0 or thorium_elastic_admin_secret | default('', true) | length > 0 %}
    bootstrap:
{% if thorium_scylla_admin_secret | default('', true) | length > 0 %}
      scylla:
        enabled: true
        adminSecret:
          name: {{ thorium_scylla_admin_secret | to_json }}
          usernameKey: username
          passwordKey: password
{% endif %}
{% if thorium_elastic_admin_secret | default('', true) | length > 0 %}
      elastic:
        adminSecret:
          name: {{ thorium_elastic_admin_secret | to_json }}
          usernameKey: username
          passwordKey: password
{% endif %}
{% endif %}
  backends:
    redis:
      host: {{ thorium_external_redis_host | to_json }}
      port: {{ thorium_external_redis_port | int }}
    scylla:
      nodes: {{ thorium_external_scylla_nodes | to_json }}
      replication: {{ scylla_replication_factor | int }}
    elastic:
      node: {{ thorium_external_elastic_node | to_json }}
    s3:
      endpoint: {{ s3_endpoint | to_json }}
      region: {{ s3_thorium_region | to_json }}
      usePathStyle: {{ s3_use_path_style | bool | to_json }}
    tracing:
      grpcEndpoint: {{ thorium_tracing_endpoint | default('', true) | to_json }}
  ingress:
    type: {{ ('traefik' if thorium_ingress_enabled | bool else 'none') | to_json }}
    host: {{ (thorium_ingress_hostname | default('', true) if thorium_ingress_hostname | default('', true) != '*' else '') | to_json }}
    tls:
      secretName: {{ thorium_tls_cert_secret_name | default('', true) | to_json }}
      # Traefik allows a single default TLSStore, so only set it when megathor deploys Traefik
      traefikDefaultStore: {{ traefik_enabled | bool | to_json }}
