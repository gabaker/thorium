---
# S3 identities read by `weed mini`; more identities or per-bucket actions
# (e.g. "Read:bucket") can be declared here
apiVersion: v1
kind: Secret
metadata:
  name: seaweedfs-s3-config
  namespace: "{{ seaweedfs_namespace }}"
type: Opaque
stringData:
  s3.json: {{ {"identities": [{"name": seaweedfs_s3_identity, "credentials": [{"accessKey": s3_access_key, "secretKey": s3_secret_key}], "actions": ["Admin", "Read", "Write", "List", "Tagging"]}]} | to_json | to_json }}

---
# `weed mini` runs the master, volume, filer, and S3 gateway in one process, so
# this StatefulSet always runs a single replica
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: seaweedfs
  labels:
    app: seaweedfs
  namespace: "{{ seaweedfs_namespace }}"
spec:
  serviceName: seaweedfs
  replicas: 1
  selector:
    matchLabels:
      app: seaweedfs
  template:
    metadata:
      labels:
        app: seaweedfs
      annotations:
        # roll the pod when the S3 identities change since they are only read at startup
        checksum/s3-config: "{{ (s3_access_key ~ s3_secret_key ~ seaweedfs_s3_identity) | hash('sha256') }}"
    spec:
      containers:
        - name: seaweedfs
          image: "{{ seaweedfs_container_registry }}/{{ seaweedfs_image }}:{{ seaweedfs_version }}"
          # the image entrypoint chowns /data and drops to the seaweed user;
          # only S3 is needed so the admin UI, WebDAV, Iceberg, and Lance endpoints are disabled
          args:
            - mini
            - -dir=/data
            - -s3.config=/etc/seaweedfs/s3.json
            - -admin.ui=false
            - -webdav=false
            - -s3.port.iceberg=0
            - -s3.port.lance=0
          resources:
            requests:
              cpu: "{{ seaweedfs_cpu_requests }}"
              memory: "{{ seaweedfs_memory_requests }}"
            limits:
              cpu: "{{ seaweedfs_cpu_limits }}"
              memory: "{{ seaweedfs_memory_limits }}"
          ports:
            - containerPort: 8333
              name: s3
            - containerPort: 9333
              name: master
            - containerPort: 19333
              name: master-grpc
            - containerPort: 8888
              name: filer
            - containerPort: 18888
              name: filer-grpc
          readinessProbe:
            httpGet:
              path: /healthz
              port: 8333
            periodSeconds: 5
            failureThreshold: 3
          volumeMounts:
            - mountPath: /data
              name: seaweedfs-data
            - mountPath: /etc/seaweedfs
              name: s3-config
              readOnly: true
      volumes:
        - name: s3-config
          secret:
            secretName: seaweedfs-s3-config
  volumeClaimTemplates:
    - metadata:
        name: seaweedfs-data
      spec:
        storageClassName: "{{ seaweedfs_storage_class }}"
        accessModes:
          - ReadWriteOnce
        resources:
          requests:
            storage: "{{ seaweedfs_volume_size }}"

---
# The master and filer ports are exposed so the bucket creation job can reach
# them with `weed shell`; the NetworkPolicy below keeps them from other pods
apiVersion: v1
kind: Service
metadata:
  name: seaweedfs
  namespace: "{{ seaweedfs_namespace }}"
spec:
  selector:
    app: seaweedfs
  ports:
  - port: 8333
    targetPort: 8333
    name: s3
    protocol: TCP
  - port: 9333
    targetPort: 9333
    name: master
    protocol: TCP
  - port: 19333
    targetPort: 19333
    name: master-grpc
    protocol: TCP
  - port: 8888
    targetPort: 8888
    name: filer
    protocol: TCP
  - port: 18888
    targetPort: 18888
    name: filer-grpc
    protocol: TCP
  type: ClusterIP

---
# The master and filer ports have no authentication (the filer serves every
# object), so other pods, including Thorium's analysis jobs, may only reach the
# S3 port. Only the bucket creation job (app=seaweedfs-admin) and SeaweedFS
# itself may reach the rest. Requires a CNI that enforces NetworkPolicy.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: seaweedfs-ingress
  namespace: "{{ seaweedfs_namespace }}"
spec:
  podSelector:
    matchLabels:
      app: seaweedfs
  policyTypes:
    - Ingress
  ingress:
    # S3 is authenticated by s3.json and open to the cluster
    - ports:
        - port: 8333
          protocol: TCP
    - from:
        - podSelector:
            matchLabels:
              app: seaweedfs-admin
        - podSelector:
            matchLabels:
              app: seaweedfs
