---
# `s3.bucket.create` fails if the bucket already exists, so the listing is
# checked first to keep redeploys idempotent and each bucket is verified after.
# The app=seaweedfs-admin label is what the seaweedfs-ingress NetworkPolicy
# lets through to the master/filer ports.
apiVersion: batch/v1
kind: Job
metadata:
  name: create-s3-buckets
  namespace: "{{ seaweedfs_namespace }}"
spec:
  backoffLimit: 4
  template:
    metadata:
      labels:
        app: seaweedfs-admin
    spec:
      restartPolicy: Never
      containers:
      - name: weed-shell
        image: "{{ seaweedfs_container_registry }}/{{ seaweedfs_image }}:{{ seaweedfs_version }}"
        command:
        - /bin/sh
        - -c
        - |
          set -e
          shell() { echo "$1" | weed shell -master=seaweedfs.{{ seaweedfs_namespace }}.svc.cluster.local:9333 -filer=seaweedfs.{{ seaweedfs_namespace }}.svc.cluster.local:8888; }
          # match the exact bucket name (the first field of each listing line)
          has_bucket() { shell "s3.bucket.list" | awk -v b="$1" '$1 == b { found = 1 } END { exit !found }'; }
          for bucket in {{ seaweedfs_buckets | map('quote') | join(' ') }}; do
            if has_bucket "$bucket"; then
              echo "Bucket $bucket already exists"
            else
              shell "s3.bucket.create -name $bucket"
            fi
            has_bucket "$bucket"
          done
