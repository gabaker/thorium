{
  "format_version": 2,
  "name": "Small legacy toolbox",
  "registry": "ghcr.io/example",
  "tools": {
    "clamav": {
      "kind": "Image",
      "groups": [
        "static"
      ],
      "versions": {
        "latest": {
          "dir": "images/clamav",
          "spec": {
            "Image": {
              "data": {
                "child_filters": {
                  "file_extension": [],
                  "file_name": [],
                  "mime": [],
                  "submit_non_matches": false
                },
                "dependencies": {
                  "cache": {
                    "enabled": true,
                    "generic": {
                      "kwarg": null,
                      "strategy": "Disabled"
                    },
                    "location": "/tmp/thorium/cache",
                    "use_parent_cache": false
                  },
                  "children": {
                    "enabled": false,
                    "kwarg": null,
                    "location": "/tmp/thorium/prior-children",
                    "strategy": "Paths",
                    "tools": []
                  },
                  "ephemeral": {
                    "kwarg": null,
                    "location": "/tmp/thorium/ephemeral",
                    "names": [],
                    "strategy": "Paths"
                  },
                  "filesystems": {
                    "enabled": false,
                    "kwarg": null,
                    "location": "/tmp/thorium/prior-filesystems",
                    "strategy": "Paths",
                    "tools": []
                  },
                  "repos": {
                    "kwarg": null,
                    "location": "/tmp/thorium/repos",
                    "strategy": "Paths"
                  },
                  "results": {
                    "kwarg": "None",
                    "location": "/tmp/thorium/prior-results",
                    "names": [],
                    "strategy": "Paths",
                    "tools": []
                  },
                  "samples": {
                    "kwarg": null,
                    "location": "/tmp/thorium/samples",
                    "naming": "Sha256",
                    "strategy": "Paths"
                  },
                  "tags": {
                    "enabled": false,
                    "kwarg": null,
                    "location": "/tmp/thorium/prior-tags",
                    "strategy": "Paths"
                  }
                },
                "display_type": "Custom",
                "output_collection": {
                  "as_filesystem": false,
                  "auto_tag": {},
                  "children": "/tmp/thorium/children",
                  "files": {
                    "entities": "/tmp/thorium/entities.json",
                    "names": [],
                    "result_files": "/tmp/thorium/result-files",
                    "results": "/tmp/thorium/results",
                    "tags": "/tmp/thorium/tags"
                  },
                  "groups": [],
                  "handler": "Files"
                }
              },
              "environment": {
                "K8s": {
                  "env": {},
                  "image": "ghcr.io/example/clamav:latest",
                  "network_policies": [],
                  "scheduling": {
                    "lifetime": null,
                    "resources": {
                      "amd_gpu": 0,
                      "burstable": {
                        "cpu": 0,
                        "memory": 0
                      },
                      "cpu": 1000,
                      "ephemeral_storage": 0,
                      "memory": 4096,
                      "nvidia_gpu": 0,
                      "worker_slots": 1
                    },
                    "spawn_limit": "Unlimited"
                  },
                  "security_context": {
                    "allow_privilege_escalation": false,
                    "group": null,
                    "user": null
                  },
                  "volumes": []
                }
              },
              "execution": {
                "args": {
                  "command": null,
                  "commit": null,
                  "entrypoint": null,
                  "output": "None",
                  "output_files": "None",
                  "reaction": null,
                  "repo": null
                },
                "collect_logs": true,
                "generator": false,
                "modifiers": null,
                "timeout": 300
              }
            }
          },
          "build": {
            "dir": "images/clamav",
            "build_path": "images/clamav",
            "build_image": true,
            "image_tags": [
              "ghcr.io/example/clamav:latest"
            ]
          }
        }
      }
    }
  },
  "builds": {
    "base": {
      "1": {
        "dir": "images/base",
        "build_path": "images/base",
        "build_image": true,
        "image_tags": [
          "ghcr.io/example/base:1"
        ]
      }
    }
  },
  "pipelines": {
    "antivirus": {
      "versions": {
        "latest": {
          "dir": "pipelines/static/antivirus",
          "description": "",
          "config": {
            "group": "static",
            "name": "antivirus",
            "order": [
              [
                "clamav"
              ]
            ],
            "sla": 640800,
            "triggers": {
              "RunOnNewSamples": "NewSample"
            },
            "description": null
          },
          "stage_tools": {
            "clamav": {
              "tool": "clamav",
              "version": "latest"
            }
          }
        }
      }
    }
  }
}
