CREATE TABLE IF NOT EXISTS {ns}.schema_migrations (kind text, id text, fingerprint text, apply_key text, layouts map<text, bigint>, revision text, version text, entry text, result text, value text, status text, attempt text, lease text, started timestamp, finished timestamp, job text, backup text, counts text, report text, updated timestamp, PRIMARY KEY ((kind), id)) WITH CLUSTERING ORDER BY (id ASC);
CREATE TABLE IF NOT EXISTS {ns}.schema_migration_issues (migration text, transform text, reason text, worker text, attempt text, checkpoint text, lease text, class text, count bigint, first_seen timestamp, last_seen timestamp, samples set<text>, resolved_count bigint, accepted boolean, updated timestamp, PRIMARY KEY ((migration), transform, reason, worker)) WITH CLUSTERING ORDER BY (transform ASC, reason ASC, worker ASC);
CREATE TABLE IF NOT EXISTS {ns}.associations (group text, year int, bucket int, source text, created timestamp, target text, direction text, kind text, submitter text, extra_source text, extra_target text, submissions_source uuid, submissions_other uuid, PRIMARY KEY ((group, year, bucket, source), created, target, direction)) WITH CLUSTERING ORDER BY (created DESC, target ASC, direction ASC);
CREATE TABLE IF NOT EXISTS {ns}.entities (kind text, group text, year int, bucket int, created timestamp, id uuid, name text, submitter text, kind_data text, description text, image text, PRIMARY KEY ((kind, group, year, bucket), created, id)) WITH CLUSTERING ORDER BY (created ASC, id ASC);
CREATE MATERIALIZED VIEW IF NOT EXISTS {ns}.entities_by_id AS SELECT id, group, kind, created, year, bucket, name, submitter, kind_data, description, image FROM {ns}.entities WHERE id IS NOT NULL AND group IS NOT NULL AND kind IS NOT NULL AND created IS NOT NULL AND year IS NOT NULL AND bucket IS NOT NULL AND name IS NOT NULL PRIMARY KEY ((id), group, kind, created, year, bucket, name) WITH CLUSTERING ORDER BY (group ASC, kind ASC, created ASC, year ASC, bucket ASC, name ASC);
CREATE TABLE IF NOT EXISTS {ns}.comments (group text, sha256 text, uploaded timestamp, id uuid, author text, comment text, files text, PRIMARY KEY ((group, sha256), uploaded, id)) WITH CLUSTERING ORDER BY (uploaded ASC, id ASC);
CREATE MATERIALIZED VIEW IF NOT EXISTS {ns}.comments_by_id AS SELECT id, sha256, group, uploaded FROM {ns}.comments WHERE id IS NOT NULL AND sha256 IS NOT NULL AND group IS NOT NULL AND uploaded IS NOT NULL PRIMARY KEY ((id), sha256, group, uploaded) WITH CLUSTERING ORDER BY (sha256 ASC, group ASC, uploaded ASC);
CREATE TABLE IF NOT EXISTS {ns}.commitishes (kind text, group text, repo text, key text, timestamp timestamp, data text, repo_data text, PRIMARY KEY ((kind, group, repo, key)));
CREATE TABLE IF NOT EXISTS {ns}.commitish_list (kind text, group text, year int, bucket int, repo text, timestamp timestamp, key text, repo_data text, PRIMARY KEY ((kind, group, year, bucket, repo), timestamp, key)) WITH CLUSTERING ORDER BY (timestamp DESC, key DESC);
CREATE MATERIALIZED VIEW IF NOT EXISTS {ns}.committed_repo_data AS SELECT repo_data, year, bucket, kind, group, repo, key, timestamp FROM {ns}.commitish_list WHERE repo_data IS NOT NULL AND year IS NOT NULL AND bucket IS NOT NULL AND kind IS NOT NULL AND group IS NOT NULL AND repo IS NOT NULL AND key IS NOT NULL AND timestamp IS NOT NULL PRIMARY KEY ((repo_data, year, bucket), kind, group, repo, key, timestamp) WITH CLUSTERING ORDER BY (kind ASC, group ASC, repo ASC, key ASC, timestamp ASC);
CREATE TABLE IF NOT EXISTS {ns}.logs (reaction uuid, stage text, bucket int, position bigint, line text, PRIMARY KEY ((reaction, stage, bucket), position)) WITH CLUSTERING ORDER BY (position ASC) AND default_time_to_live = 2592000;
CREATE TABLE IF NOT EXISTS {ns}.network_policies (group text, name text, id uuid, k8s_name text, created timestamp, ingress text, egress text, forced_policy boolean, default_policy boolean, PRIMARY KEY ((group), name)) WITH CLUSTERING ORDER BY (name ASC);
CREATE MATERIALIZED VIEW IF NOT EXISTS {ns}.network_policies_default AS SELECT group, name, default_policy, id FROM {ns}.network_policies WHERE group IS NOT NULL AND name IS NOT NULL AND default_policy = true PRIMARY KEY ((group), name, default_policy) WITH CLUSTERING ORDER BY (name ASC, default_policy ASC);
CREATE MATERIALIZED VIEW IF NOT EXISTS {ns}.network_policies_by_name AS SELECT name, group, id, k8s_name, created, ingress, egress, forced_policy, default_policy FROM {ns}.network_policies WHERE name IS NOT NULL AND group IS NOT NULL PRIMARY KEY ((name), group) WITH CLUSTERING ORDER BY (group ASC);
CREATE TABLE IF NOT EXISTS {ns}.nodes (cluster text, node text, health text, resources text, heart_beat timestamp, PRIMARY KEY ((cluster), node)) WITH CLUSTERING ORDER BY (node ASC);
CREATE TABLE IF NOT EXISTS {ns}.notifications (kind text, key text, created timestamp, id uuid, msg text, level text, ban_id uuid, PRIMARY KEY ((kind, key), created, id)) WITH CLUSTERING ORDER BY (created ASC, id ASC) AND default_time_to_live = 2592000;
CREATE TABLE IF NOT EXISTS {ns}.repo_data (repo text, hash text, PRIMARY KEY ((repo), hash)) WITH CLUSTERING ORDER BY (hash ASC);
CREATE TABLE IF NOT EXISTS {ns}.repos_list (group text, year int, bucket int, uploaded timestamp, id uuid, url text, provider text, user text, name text, creator text, scheme text, default_checkout text, earliest timestamp, PRIMARY KEY ((group, year, bucket), uploaded, id)) WITH CLUSTERING ORDER BY (uploaded DESC, id DESC);
CREATE MATERIALIZED VIEW IF NOT EXISTS {ns}.repos AS SELECT url, group, uploaded, year, bucket, id, provider, user, name, creator, scheme, default_checkout, earliest FROM {ns}.repos_list WHERE url IS NOT NULL AND group IS NOT NULL AND uploaded IS NOT NULL AND year IS NOT NULL AND bucket IS NOT NULL AND id IS NOT NULL PRIMARY KEY ((url), group, uploaded, year, bucket, id) WITH CLUSTERING ORDER BY (group ASC, uploaded DESC, year DESC, bucket DESC, id DESC);
CREATE TABLE IF NOT EXISTS {ns}.results (id uuid, uploaded timestamp, tool text, tool_version text, cmd text, result text, files set<text>, display_type text, children map<text, uuid>, entities map<text, bigint>, PRIMARY KEY ((id), uploaded)) WITH CLUSTERING ORDER BY (uploaded DESC);
CREATE TABLE IF NOT EXISTS {ns}.results_stream (kind text, group text, year int, bucket int, uploaded timestamp, id uuid, key text, tool text, tool_version text, display_type text, cmd text, PRIMARY KEY ((kind, group, year, bucket), uploaded, id, key)) WITH CLUSTERING ORDER BY (uploaded DESC, id ASC, key ASC);
CREATE MATERIALIZED VIEW IF NOT EXISTS {ns}.results_auth AS SELECT key, kind, group, tool, id, year, bucket, uploaded, tool_version, display_type, cmd FROM {ns}.results_stream WHERE key IS NOT NULL AND kind IS NOT NULL AND group IS NOT NULL AND tool IS NOT NULL AND id IS NOT NULL AND year IS NOT NULL AND bucket IS NOT NULL AND uploaded IS NOT NULL PRIMARY KEY ((key), kind, group, tool, id, year, bucket, uploaded) WITH CLUSTERING ORDER BY (kind ASC, group ASC, tool ASC, id ASC, year ASC, bucket ASC, uploaded ASC);
CREATE MATERIALIZED VIEW IF NOT EXISTS {ns}.results_ids AS SELECT key, id, kind, group, year, bucket, uploaded, tool FROM {ns}.results_stream WHERE key IS NOT NULL AND id IS NOT NULL AND kind IS NOT NULL AND group IS NOT NULL AND year IS NOT NULL AND bucket IS NOT NULL AND uploaded IS NOT NULL PRIMARY KEY ((key), id, kind, group, year, bucket, uploaded) WITH CLUSTERING ORDER BY (id ASC, kind ASC, group ASC, year ASC, bucket ASC, uploaded ASC);
CREATE TABLE IF NOT EXISTS {ns}.s3_ids (type text, id uuid, sha256 text, PRIMARY KEY ((type, id), sha256)) WITH CLUSTERING ORDER BY (sha256 ASC);
CREATE MATERIALIZED VIEW IF NOT EXISTS {ns}.s3_sha256s AS SELECT sha256, type, id FROM {ns}.s3_ids WHERE sha256 IS NOT NULL AND type IS NOT NULL AND id IS NOT NULL PRIMARY KEY ((sha256), type, id) WITH CLUSTERING ORDER BY (type ASC, id ASC);
CREATE TABLE IF NOT EXISTS {ns}.samples_list (group text, year int, bucket int, uploaded timestamp, id uuid, sha256 text, sha1 text, md5 text, name text, description text, submitter text, origin text, PRIMARY KEY ((group, year, bucket), uploaded, id)) WITH CLUSTERING ORDER BY (uploaded DESC, id DESC);
CREATE MATERIALIZED VIEW IF NOT EXISTS {ns}.samples AS SELECT sha256, group, uploaded, id, year, bucket, sha1, md5, name, description, submitter, origin FROM {ns}.samples_list WHERE sha256 IS NOT NULL AND group IS NOT NULL AND uploaded IS NOT NULL AND id IS NOT NULL AND year IS NOT NULL AND bucket IS NOT NULL PRIMARY KEY ((sha256), group, uploaded, id, year, bucket) WITH CLUSTERING ORDER BY (group ASC, uploaded DESC, id DESC, year ASC, bucket ASC);
CREATE TABLE IF NOT EXISTS {ns}.tags (type text, group text, year int, bucket int, key text, value text, uploaded timestamp, item text, key_lower text, value_lower text, PRIMARY KEY ((type, group, year, bucket, key, value), uploaded, item, key_lower, value_lower)) WITH CLUSTERING ORDER BY (uploaded DESC, item ASC, key_lower ASC, value_lower ASC);
CREATE MATERIALIZED VIEW IF NOT EXISTS {ns}.tags_by_item AS SELECT type, item, group, year, bucket, uploaded, key, value, key_lower, value_lower FROM {ns}.tags WHERE type IS NOT NULL AND item IS NOT NULL AND group IS NOT NULL AND year IS NOT NULL AND bucket IS NOT NULL AND uploaded IS NOT NULL AND key IS NOT NULL AND value IS NOT NULL AND key_lower IS NOT NULL AND value_lower IS NOT NULL PRIMARY KEY ((type, item), group, year, bucket, uploaded, key, value, key_lower, value_lower) WITH CLUSTERING ORDER BY (group ASC, year ASC, bucket ASC, uploaded ASC, key ASC, value ASC, key_lower ASC, value_lower ASC);
CREATE MATERIALIZED VIEW IF NOT EXISTS {ns}.tags_case_insensitive AS SELECT type, group, year, bucket, key_lower, value_lower, uploaded, item, key, value FROM {ns}.tags WHERE type IS NOT NULL AND group IS NOT NULL AND year IS NOT NULL AND bucket IS NOT NULL AND key_lower IS NOT NULL AND value_lower IS NOT NULL AND uploaded IS NOT NULL AND item IS NOT NULL AND key IS NOT NULL AND value IS NOT NULL PRIMARY KEY ((type, group, year, bucket, key_lower, value_lower), uploaded, item, key, value) WITH CLUSTERING ORDER BY (uploaded ASC, item ASC, key ASC, value ASC);
