[0.002, "o", "\u001b[5;1H\u001b[93m- IsDebuggerPresent (b64-ciphertext prefix gljMaWsL)\r\n- CheckRemoteDebuggerPresent (iEPtb2Is)\u001b[39m                                                                             \r\n\u001b[93m- NtQueryInformationProcess (hV/ZeWwM)\r\n- GetTickCount (jE78WGAd)\r\n- Qu\u001b[CryPer\u001b[Corma\u001b[CceCounter (ml7tfnAu)\u001b[39m                         \r\n\u001b[93m- VMware (nWb/bXsb)\u001b[39m                                                                                          \r\n\u001b[93m- CreateMutexA/W, OpenMutexA/W (iFntbX0bj2Tc, hFvtYkQL)\u001b[39m                                                                \r\n                                                                                                                    \r\n\u001b[93m(The\u001b[2Crefix-derivat\u001b[Con m\u001b[Cthod was\u001b[Cvalidated on a known\u001b[Cpair: the\u001b[Ck\u001b[Cystream applied to G\u001b[CtUserDefaultLangID reproduces\u001b[39m  \r\n\u001b[93mthe stored literal jE78WXob... \u001b[Cxactly.)\u001b[39m                                                                     \r\n                                                                                                                    \r\n\u001b[93mAlso no cmp eax,0x419-style hardcod\u001b[Cd \u001b[Cnti-VM constants \u001b[Cls\u001b[Cwhere, no SMBIOS/registry VM-artifact strings, no\r\ncpuid-based checks surfaced by the detectors. This matches the verified Stealc-v2 profile in family-intel-stealc-v1-v2:\r\n\"No VM/sandbox/debugger checks (IsD\u001b[CbuggerPres\u001b[Cnt hits are s\u001b[Catic-CRT n\u001b[Ci\u001b[Ce)\".\u001b[39m                                        \r\n                                                                                                              \r\n\u001b[93m\u001b[1mFamily attribution context:\u001b(B\u001b[m\u001b[93m this s\u001b[Cmple IS Stealc\u001b[Cv2 — \u001b[Che wid\u001b[C builder-path tell C:\\builder_v2\\stealc\\ is present at\u001b[39m \r\n\u001b[93mfile offset 0x7e756, string tab\u001b[3Cuses th\u001b[C single global\u001b[CRC4\u001b[Ckey layout, an\u001b[C \u001b[Che build/campaign ID 512e7bd984984fb6\u001b[39m  \r\n\u001b[93msits next\u001b[Cto\u001b[5Ck\u001b[Cy in init_rc4_keys_and_d\u001b[Ccrypt_api_names.\u001b[39m                       \u001b[24;63H\u001b[36m\u001b[1m⠸ \u001b(B\u001b[m\u001b[90mThinking…\u001b[39m \u001b[35m\u001b[1mRev\u001b[CrseEngineer(Elar\u001b[26;2H\u001b(B\u001b[m"]
[0.015, "o", "\u001b[4;1H\u001b[93m- CheckRemoteDebuggerPresent (iEPtb2Is)\u001b[5;3HNtQueryInfo\u001b[CmationProcess (hV/ZeWwM)\u001b[39m              \u001b[6;3H\u001b[93mGetTickC\u001b[Cunt (jE78WGAd)\u001b[39m              \u001b[7;3H\u001b[93mQueryPerformanceCounter (ml7tfnAu)\u001b[39m  \u001b[8;3H\u001b[93mVMware (nWb/bXsb)\u001b[39m      \u001b[9;3H\u001b[93mCr\u001b[CateMutexA/W, Ope\u001b[CMutexA/W (iFntbX0bj2Tc, hFvtYkQL)\r\n\u001b[39m                   \r\n\u001b[93m(The pr\u001b[Cfix-derivatio\u001b[C method was validated on a known pair: the keystream applied to GetUserDefaultLangID reproduces\r\nthe stored literal jE78WXob... exactly.)\r\n\u001b[39m                                                                                                                     \r\n\u001b[93mAlso n\u001b[C cmp eax,0x419-style hardcoded anti-VM constants elsewhere, no SMBIOS/registry VM-artifact strings, no\r\ncpuid-based checks surfaced by the detectors. This matches the verified Stealc-v2 profile in family-intel-stealc-v1-v2:\r\n\"No VM/sandbox/debugger ch\u001b[Ccks (IsD\u001b[CbuggerPresent hits are static-CRT\u001b[Cnoise)\".\u001b[39m                               \r\n                                                                                                                       \r\n\u001b[93m\u001b[1mFamily attribution context:\u001b(B\u001b[m\u001b[93m this \u001b[Cample IS Stealc\u001b[Cv2 —\u001b[Cth\u001b[2Cwide builder-path tell C:\\builder_v2\\stealc\\ is present at\r\nfile offset 0x7e756, string table uses the single global RC4 key layout, and the build/campaign ID 512e7bd984984fb6\r\nsits next to the key in init_rc4_keys_and_decrypt_api_nam\u001b[Cs.\u001b[39m                                                         \r\n                                                                                                                   \r\n\u001b[31m\u001b[1m⚠ ReverseEngineer(Elara) context warning (flush findings to the forum): ~160992 of 200000 tokens\u001b[24;63H\u001b[36m⠼\u001b[26;2H\u001b(B\u001b[m"]
