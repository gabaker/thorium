[0.008, "o", "\u001b[4;1H\u001b[97m(plaintext).\u001b[39m                                                                                                                               \r\n                                                                                                                                                   \r\n\u001b[36m\u001b[1m## 6. Anti-analysis\u001b[8;1H\u001b(B\u001b[m\u001b[97m- \u001b[1mCIS kill-switch\u001b(B\u001b[m\u001b[97m: exits on LANGIDs 0x419/0x422/0x423/0x43F/0x443 (RU/UA/BY/KZ/UZ), before any C2 contact\r\n- \u001b[1mNamed-event single-instance guard\u001b(B\u001b[m\u001b[97m (\u001b[93m<%p>_<Computer>_<User>\u001b[97m, with a developer bug formatting a function pointer)\u001b[10;3H\u001b[1mDate ki\u001b[Cl-switch\u001b(B\u001b[m\u001b[97m: hardc\u001b[Cded expiry \u001b[1m11 April 2025\u001b(B\u001b[m\u001b[97m assembled from\u001b[C4 RC4 blobs (@ 0x14002a774)\u001b[39m            \u001b[11;3H\u001b[97mNo anti-VM, no HAL9TH/JohnDoe check, no anti-debug beyond CRT (verifi\u001b[Cd n\u001b[Cgatives)\u001b[39m                            \r\n                                                                                             \r\n\u001b[36m\u001b[1m## 7. Injection\u001b(B\u001b[m                                                                     \u001b[15;1H\u001b[97m\u001b[1mEarly-Bird APC injection\u001b(B\u001b[m\u001b[97m (@ 0x14003a048): CreateProcess suspended → VirtualAllocEx RWX → WriteProcessMemory of the embedded 64-bit helper DLL\r\n(pre-mapped, sRDI reflective loader appended) → QueueUserAPC. The helper uses the\u001b[1m IElevator COM service\u001b(B\u001b[m\u001b[97m to decrypt Chrome's app-bound key and returns\r\nit over a volume-serial-derived named pipe. Op\u001b[Cional\u001b[93m runas\u001b[97m elevation for loader tasks;\u001b[Cno oth\u001b[Cr privil\u001b[Cge escalation.\u001b[39m                        \r\n                                                                                                                                                     \r\n\u001b[36m\u001b[1m## 8–9. IOCs & Attribution\u001b(B\u001b[m                                                                                           "]
[0.000, "o", "\u001b[21;1H\u001b[97mFull list in forum post\u001b[1m #final-iocs\u001b(B\u001b[m\u001b[97m; attribution evidence (YARA ×3, protocol, builder path, typo\u001b[93m Error dumping proccess list\u001b[97m) in\u001b[1m #final-verdict\u001b(B\u001b[m\u001b[97m.\r\nNote: the oft-cited \"GetCerrentProcessId\" typo is\u001b[1m not\u001b(B\u001b[m\u001b[97m in this build — the earlier claim was corrected by byte-level re-verification.\r\n\u001b[39m                                                                                                                                                \r\n\u001b[97mAll 15 questions raised w\u001b[2Ce solved with byte-level ev\u001b[Cdence;\u001b[Cdetector false positives (r\u001b[Cnsomware, fake\u001b[CADD/XOR decodes) were explicitly refuted,\r\nand low-confidence items (IElevator GUID naming, event-name %p bug) were flagged for analyst review.\r\n\u001b[39m                                                                                                                                                  \r\n\u001b[97m🤖\u001b[39m   "]
[0.000, "o", "                                                                                               \r\n\u001b[97mWriting report to report.md…\r\n\u001b[39m \r\n\u001b[97m🤖\u001b[39m                          \r\n\u001b[97mReport written to report.md (also saved in the session store as report.md)\u001b[32;117H\u001b[39m           \u001b[C                      \u001b[34;2H"]
