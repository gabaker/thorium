[0.001, "o", "\u001b[4;1H\u001b[94m5.\u001b[93m\u001b[1m Single-instance gate (named EVENT, not mutex)\u001b(B\u001b[m\u001b[93m: while (OpenEventW(0x1F0003 /*EVENT_ALL_ACCESS*/,\r\nname=ComputerName+UserName)) { CloseHandle; Sleep; } then CreateEventW; ExitProcess(0) on failure.\r\n\u001b[94m6\u001b[C\u001b[93m\u001b[1m Build-expiry date kill-switch\u001b(B\u001b[m\u001b[93m: build_expiry_date_string_from_table @\u001b[1m 0x14002a4c0\u001b(B\u001b[m\u001b[93m (co\u001b[Ccatenates 4 decrypted\r\nstring-table entries \u001b[Cnto a date string) → stealc_main_operation @\u001b[1m 0x14002a774\u001b(B\u001b[m\u001b[93m, which parse\u001b[2Cit via\u001b[39m                 \r\n\u001b[93mparse_exp\u001b[Cry_date_pct_d_m_Y @\u001b[1m 0x14002a298\u001b(B\u001b[m\u001b[93m using format \"%d/%m/%Y\" (day/month/year — literal confirmed both in decompile\r\nand by raw byte read: ASCII 25 64 2f 25 6d 2f 25 59 at file offset 0x80698) and compares mktime(expiry) < mktime(now).\r\nParse failure → ExitProcess(0).\u001b[39m                                                                                   \r\n\u001b[94m7. \u001b[93mIf\u001b[C\u001b[1mnot expired\u001b(B\u001b[m\u001b[93m →\u001b[Cstealc_orchestrator_collect_exfil_selfdelete @ \u001b[1m0x140029f68\u001b(B\u001b[m\u001b[93m (the entire payload; next comment).\r\n\u001b[94m8\u001b[C \u001b[93mCloseHandle(event), dtors, return 0.\u001b[39m                                                           \r\n                                                                                                  \r\n\u001b[93mNote: stealc_main_operation's return value t\u001b[Cue = \"expiry date is in the past\"; the\u001b[Corches\u001b[Crator only runs on false.\r\n\u001b[39m                                                                                                   \r\n\u001b[97m🤖\u001b[36m\u001b[1m Developer(Sinope)\u001b(B\u001b[m                                                                                                   \r\n\u001b[97mBoth scans succeeded:\u001b[1m 270 decoded strings\u001b(B\u001b[m\u001b[97m, and the keyword audit gives explicit per-keyword counts. Before posting,\u001b[39m   \r\n\u001b[97mI'll harden the negative: (a) re-run the keyword audit at minlen 4 to cover short tokens, (b) independently verify key\r\ndecodes via the pure-Rhai\u001b[93m b64rc4\u001b[97m (second decode route, not the native pipeline), and (c) grep the raw file for\u001b[39m    \r\n\u001b[97m\u001b[3mplaintext\u001b(B\u001b[m\u001b[97m persistence keywords so the absence claim covers unencrypted strings too.\u001b[22;1H\u001b[90m○\u001b[39m \u001b[90mDeveloper(Sinope) · ▸ run_script(persist_kw_grep) · …running\u001b[39m                                                      \u001b[24;60H           \u001b[C\u001b[36m\u001b[1m⠋ \u001b(B\u001b[m\u001b[90mThinking…\u001b[39m \u001b[35m\u001b[1mD\u001b[Cveloper(Sinope)\u001b(B\u001b[m\u001b[37m: calling run_scrip\u001b[26;2H\u001b(B\u001b[m"]
[0.080, "o", "\u001b[24;72H\u001b[36m\u001b[1m⠙\u001b[26;2H\u001b(B\u001b[m"]
[0.102, "o", "\u001b[24;72H\u001b[36m\u001b[1m⠹\u001b[26;2H\u001b(B\u001b[m"]
[0.040, "o", "\u001b[4;1H\u001b[94m6\u001b[2C\u001b[93m\u001b[1mBuild-expiry date kill-switch\u001b(B\u001b[m\u001b[93m: build_expiry_date_string_from_table @\u001b[1m 0x14002a4c0\u001b(B\u001b[m\u001b[93m (concatenates 4 decrypted\r\nstring-tabl\u001b[C entrie\u001b[C into a date string) → stealc_main_operation @\u001b[1m 0x14002a774\u001b(B\u001b[m\u001b[93m, which parses it via\r\nparse_expiry_date_pct_d_m_Y @\u001b[1m 0x14002a298\u001b(B\u001b[m\u001b[93m using forma\u001b[C \"%d/%m/%Y\" (day/month/year —\u001b[Cliter\u001b[Cl confirme\u001b[C both in decompile\r\nand by r\u001b[Cw byte \u001b[Cead: ASCII\u001b[C25 64 2f 25 6d\u001b[C2f 25 59 at file offset 0x80698) and\u001b[Ccompares mktime(expiry) < mktime(now).\r\nP\u001b[4C failure → ExitProcess(0).\u001b[39m                                                                                        \r\n\u001b[94m7. \u001b[93mIf \u001b[1mnot expired\u001b(B\u001b[m\u001b[93m → stealc_orchestrator_collect_exfil_selfdelete @\u001b[C\u001b[1m0x140029f68\u001b(B\u001b[m\u001b[93m (the entire payload; next comment).\u001b[39m    \r\n\u001b[94m8. \u001b[93mCloseHandle(even\u001b[C), dtors, return 0.\r\n\u001b[39m                                                                                                                  \r\n\u001b[93mNote: \u001b[Cte\u001b[Clc_main_operati\u001b[Cn's\u001b[8Cvalue true = \"expiry date is in the past\"; the orchestrator only runs on false.\u001b[14;1H\u001b[97m🤖\u001b[36m\u001b[1m Developer(Sinope)\u001b(B\u001b[m                                                                                                \r\n\u001b[97mBoth scans succeeded:\u001b[1m 270 decoded strings\u001b(B\u001b[m\u001b[97m, and the keyword audit gives explicit per-keyword counts. Before posting,\r\nI'll harden the negative: (a) re-run the keyword audit at minlen 4 to cover short tokens, (b) independently verify key\r\ndecodes via the pure-Rhai\u001b[93m b64rc4\u001b[97m (second deco\u001b[Ce rout\u001b[C, not\u001b[Cthe nat\u001b[3C pipe\u001b[2Cne), and (c) grep the raw \u001b[Cil\u001b[2Cf\u001b[Cr\u001b[39m     \r\n\u001b[97m\u001b[3mplaintext\u001b(B\u001b[m\u001b[97m persist\u001b[Cnce k\u001b[Cywords so the absence claim covers u\u001b[Cencryp\u001b[Ced strings too.\u001b[39m                                   \r\n                                                                                                              \r\n\u001b[90m○\u001b[39m \u001b[90mDeveloper(Sinope) · ▸ run_script(persist_kw_grep) · …running\u001b[39m                     \r\n\u001b[90m\u001b[3m  decrypted strings: 276\r\n  ↳ 1 log lines ·\u001b[4;1H\u001b(B\u001b[m\u001b[93mParse failure \u001b[22;18H\u001b[90m\u001b[3m click to enlarge\u001b(B\u001b[m                            \u001b[4;15H\u001b[93m→ ExitProcess(0).\u001b[39m                                                                              \r\n\u001b[94m7. \u001b[93mIf \u001b[1mnot expired\u001b(B\u001b[m\u001b[93m → stealc_orch\u001b[Cstrator_collect_exfil_selfdelete\u001b[2C \u001b[7C\u001b[1m9f68\u001b(B\u001b[m\u001b[93m (t\u001b[Ce enti\u001b[Ce payload; next comment).\r\n\u001b[94m8. \u001b[93mCloseHandle(event), dtors, return 0.\u001b[39m                                                                                \r\n                                                                                                                      \r\n\u001b[93mNote:\u001b[Cstealc_main_ope\u001b[Cation's return value true = \"expiry date is in the past\"; the orchestrator only runs on false.\r\n\u001b[39m                                                                                                                  \r\n\u001b[97m🤖\u001b[36m\u001b[1m Developer(Sinope)\u001b(B\u001b[m                   \r\n\u001b[97mBoth scans succeeded:\u001b[1m 270 decoded strings\u001b(B\u001b[m\u001b[97m, and the keyword audit gives explicit per-keyword counts. Before posting,\r\nI'll harden the negative: (a) re-run the keyword audit at minlen 4 to cover short tokens, (b) independently verify key\r\ndecodes via the pure-Rhai\u001b[93m b64rc4\u001b[97m (second decode route, not the native pipeline), and (c) grep the raw file for\r\n\u001b[3mplaintext\u001b(B\u001b[m\u001b[97m persistence keywords so the absence claim covers unencrypted strings too.\r\n\u001b[39m                                                                                                                   \r\n\u001b[90m○\u001b[39m \u001b[90mDeveloper(Sinope) · ▸ run_script(persist_kw_grep) · …running\u001b[39m                                                        \r\n\u001b[90m\u001b[3m  keyword \"schtasks\": 0 hit(s)\u001b(B\u001b[m                                                                                \r\n\u001b[90m\u001b[3m  keyword \"Task\": 0 hit(s)\u001b(B\u001b[m                                                         \r\n\u001b[90m\u001b[3m  keyword \"Service\": 0 hit(s)\r"]
