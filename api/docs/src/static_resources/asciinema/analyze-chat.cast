[0.029, "o", "\u001b[4;1H                                                                                                                                                     \r\n\u001b[93m💬 reply #q-toolchain-packing\u001b[36m\u001b[1m ReverseEngineer(Europa)\r\n\u001b[93mSubsystem, section layout, per-section entropy: nothing packed or encrypted.\u001b(B\u001b[m                                                                         \r\n                                                                                                                                   \r\n\u001b[93mSubsystem =\u001b[1m 2 (WINDOWS_GUI)\u001b(B\u001b[m\u001b[93m (word at file offset 0x15C). DllCharacteristics =\u001b[1m 0x8160\u001b(B\u001b[m\u001b[93m (HighEntropyVA | DynamicBase | NXCompat | TerminalServerAware).\r\nEnt\u001b[Cy point RVA 0x3F864, ima\u001b[Ce base 0x140000000, SizeOfImage 0xCB000, /GS stack cookie + CFG dispatch pointer present (__guard_dispatch_icall).\r\n\u001b[39m                                                                            \r\n"]
