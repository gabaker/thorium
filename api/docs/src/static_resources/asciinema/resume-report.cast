[1.005, "o", "\u001b[10A\u001b[37m\u001b[48;5;237m┌──────────────────────────────────────── Commands ────────────────────────────────────────┐\u001b[25;2H│\u001b[97m\u001b[100m\u001b[1m \u001b[33m/report <path> [template]\u001b[97m    Write an LLM-generated markdown report \u001b(B\u001b[m\u001b[97m\u001b[48;5;237m                     \u001b[37m│\u001b[26;2H│\u001b[97m \u001b[33m\u001b[1m/promote <script> <description…>\u001b(B\u001b[m\u001b[97m\u001b[48;5;237m    Promote a session script into the persistent library \u001b[37m│\u001b[27;2H│\u001b[97m \u001b[33m\u001b[1m/btw <name>\u001b(B\u001b[m\u001b[97m\u001b[48;5;237m    Open or switch to a named side conversation                               \u001b[37m│\u001b[28;2H│\u001b[97m \u001b[33m\u001b[1m/done\u001b(B\u001b[m\u001b[97m\u001b[48;5;237m    Summarize this \u001b(B\u001b[m\u001b[97m\u001b[48;5;237mside conversation back to the main chat                          \u001b[37m│\u001b[29;2H│\u001b[97m \u001b[33m\u001b[1m/close\u001b(B\u001b[m\u001b[97m\u001b[48;5;237m    Close this side conversation without returning anything                        \u001b[37m│\u001b[30;3H\u001b[97m \u001b[33m\u001b[1m/retry\u001b(B\u001b[m\u001b[97m\u001b[48;5;237m    Probe the provider now while the session is paused                             \u001b[37m│\u001b[31;2H│\u001b[97m \u001b[33m\u001b[1m/abort\u001b(B\u001b[m\u001b[97m\u001b[48;5;237m    Abort the provider pause; parked requests surface errors                       \u001b[37m│\u001b[32;2H└──────────────────────────────────────────────────────────────────────────────────────────┘\u001b[34;2H\u001b[49m\u001b[97m/                                                                                                                                                   \u001b[35;2H                                                                                                                                                    \u001b[36;2H                                                                                                                                                    \u001b[37;2H                                                                                                                                                    \u001b[38;2H                                                                                                                                                    \u001b[39;2H                                                                                                                                                    \u001b[34;3H\u001b(B\u001b[m"]
