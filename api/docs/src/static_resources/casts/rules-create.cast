[0.353, "o", "rule demo_keylogger_strings\r\n{\r\n    meta:\r\n        author = \"Thorium Demo\"\r\n        description = \"Detects the demo keylogger's window-hook strings\"\r\n    strings:\r\n        $hook = \"SetWindowsHookExW\" ascii wide\r\n        $log = \"THORIUM-DEMO-KEYLOG\"\r\n    condition:\r\n        all of them\r\n}\r\n"]
