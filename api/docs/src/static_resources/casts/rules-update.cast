[0.412, "o", "\u001b[97m\u001b[1mdemo_persistence_check\u001b[0m\u001b[39m \u001b[2m(demolab)\u001b[0m\r\n\u001b[36m\u001b[1mEngine:\u001b[0m\u001b[39m yara\r\n\u001b[36m\u001b[1mID:\u001b[0m\u001b[39m 5182b255-2048-4252-96a4-1b738c2bb469\r\n\u001b[36m\u001b[1mScore:\u001b[0m\u001b[39m 65\r\n\u001b[36m\u001b[1mApplies To:\u001b[0m\u001b[39m Samples\r\n\u001b[36m\u001b[1mCreated:\u001b[0m\u001b[39m 2026-10-22T19:48:28Z\r\n\u001b[36m\u001b[1mSubmitter:\u001b[0m\u001b[39m test\r\n\u001b[36m\u001b[1mTags:\u001b[0m\u001b[39m\r\n  YaraRuleAuthor=Thorium Demo\r\n  YaraRuleDescription=Flags the demo implant's run-key persistence marker\r\n  YaraRuleHash=e1635e11ff087380175546945c8af060c8b780c0044003cb6c1bd55b5610ba81\r\n  YaraRuleName=demo_persistence_check\r\n  submitter=test\r\n\u001b[36m\u001b[1mRule:\u001b[0m\u001b[39m\r\nrule demo_persistence_check\r\n{\r\n    meta:\r\n        author = \"Thorium Demo\"\r\n        description = \"Flags the demo implant's run-key persistence marker\"\r\n    strings:\r\n        $runkey = \"Software\\\\Microsoft\\\\Windows\\\\CurrentVersion\\\\Run\" ascii wide\r\n        $marker = \"THORIUM-DEMO-PERSIST\"\r\n    condition:\r\n        all of them\r\n}\r\n"]
