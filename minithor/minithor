    ########################################
    # Scylla
    ########################################
    CURRENT_SECTION="Scylla"

    log "Deploying cert-manager"
    helm_install_pinned cert-manager jetstack/cert-manager "$CERT_MANAGER_CHART_VERSION" \
        cert-manager --set crds.enabled=true
    wait_for_resource crd certificates.cert-manager.io "" "$deploy_timeout"
    wait_for_resource crd issuers.cert-manager.io "" "$deploy_timeout"
    kctl wait --for condition=established \
        crd/certificates.cert-manager.io crd/issuers.cert-manager.io --timeout="${deploy_timeout}s"
    kctl -n cert-manager rollout status deployment.apps/cert-manager-webhook -w --timeout="${deploy_timeout}s"
    # A rolled-out webhook still rejects requests until the cainjector has
    # written its CA bundle, so retry a dry-run Issuer until it is admitted
    local webhook_ready=false
    for attempt in $(seq 1 30); do
        if kctl apply --dry-run=server -f - >/dev/null 2>&1 <<'EOF'
apiVersion: cert-manager.io/v1
kind: Issuer
metadata:
  name: cert-manager-readiness-check
  namespace: cert-manager
spec:
  selfSigned: {}
EOF
        then
            webhook_ready=true
            break
        fi
        echo "Waiting for the cert-manager webhook to accept requests (attempt $attempt/30)..."
        sleep 10
    done
    if [ "$webhook_ready" = false ]; then
        echo "ERROR: the cert-manager webhook did not start accepting requests" >&2
        exit 1
    fi

    log "Deploying Scylla Operator"
    helm_install_pinned scylla-operator scylla/scylla-operator "$SCYLLA_OPERATOR_CHART_VERSION" \
        "$SCYLLA_OPERATOR_NAMESPACE"
    wait_for_resource crd scyllaclusters.scylla.scylladb.com "" "$deploy_timeout"
    kctl wait --for condition=established \
        crd/scyllaclusters.scylla.scylladb.com --timeout="${deploy_timeout}s"
    kctl -n "$SCYLLA_OPERATOR_NAMESPACE" rollout status deployment.apps/scylla-operator -w --timeout="${deploy_timeout}s"
    kctl -n "$SCYLLA_OPERATOR_NAMESPACE" rollout status deployment.apps/webhook-server -w --timeout="${deploy_timeout}s"
    sleep 10

    log "Deploying Scylla Cluster"
    kctl apply -f - <<EOF
---
apiVersion: v1
kind: Namespace
metadata:
  name: $SCYLLA_NAMESPACE
EOF
    # The racks reference the scylla-agent-config agent config, so the operator
    # mounts the agent auth token from this secret rather than generating one,
    # and the Scylla pod can't start without it. It's only created when missing
    # so a redeploy keeps the token the running agent already uses; the manifest
    # is piped so the token stays off the command line.
    if ! kctl get secret scylla-auth-token -n "$SCYLLA_NAMESPACE" &>/dev/null; then
        kctl apply -f - <<EOF
apiVersion: v1
kind: Secret
metadata:
  name: scylla-auth-token
  namespace: $SCYLLA_NAMESPACE
type: Opaque
stringData:
  auth-token.yaml: "auth_token: $(generate_password)"
EOF
    fi
    kctl apply -f - <<EOF
---
apiVersion: scylla.scylladb.com/v1
kind: ScyllaCluster
metadata:
  labels:
    controller-tools.k8s.io: "1.0"
  name: scylla
  namespace: $SCYLLA_NAMESPACE
spec:
  version: 6.2.3
  agentVersion: 3.4.2
  developerMode: true
  datacenter:
    name: us-east-1
    racks:
      - name: us-east-1a
        scyllaConfig: "scylla-config"
        scyllaAgentConfig: "scylla-agent-config"
        members: 1
        storage:
          capacity: 32Gi
          storageClassName: csi-hostpath-sc
        resources:
          requests:
            cpu: 0
            memory: 0
          limits:
            cpu: 2
            memory: 4Gi
        volumes:
          - name: coredumpfs
            hostPath:
              path: /tmp/coredumps
        volumeMounts:
          - mountPath: /tmp/coredumps
            name: coredumpfs
EOF
    wait_for_resource statefulset scylla-us-east-1-us-east-1a "$SCYLLA_NAMESPACE" "$deploy_timeout"
    wait_for_pods_ready "$SCYLLA_NAMESPACE" scylla/cluster=scylla "$deploy_timeout"

    kctl apply -f - <<EOF
apiVersion: v1
kind: ConfigMap
metadata:
  name: scylla-config
  namespace: $SCYLLA_NAMESPACE
data:
  scylla.yaml: |
    num_tokens: 256
    commitlog_sync: periodic
    commitlog_sync_period_in_ms: 10000
    commitlog_segment_size_in_mb: 32
    seed_provider:
        - class_name: org.apache.cassandra.locator.SimpleSeedProvider
          parameters:
              - seeds: "127.0.0.1"
    listen_address: 0.0.0.0
    broadcast_address: 10.233.13.110
    native_transport_port: 9042
    native_shard_aware_transport_port: 19042
    read_request_timeout_in_ms: 5000
    write_request_timeout_in_ms: 2000
    cas_contention_timeout_in_ms: 1000
    endpoint_snitch: SimpleSnitch
    rpc_address: localhost
    rpc_port: 9160
    api_port: 10000
    api_address: 127.0.0.1
    batch_size_warn_threshold_in_kb: 128
    batch_size_fail_threshold_in_kb: 1024
    authenticator: PasswordAuthenticator
    authorizer: CassandraAuthorizer
    partitioner: org.apache.cassandra.dht.Murmur3Partitioner
    commitlog_total_space_in_mb: -1
    developer_mode: true
    murmur3_partitioner_ignore_msb_bits: 12
    force_schema_commit_log: true
EOF
    kctl rollout restart -n "$SCYLLA_NAMESPACE" statefulset.apps/scylla-us-east-1-us-east-1a
    # wait on the rollout itself; a pod wait would return on the old Ready pod
    wait_for_rollout statefulset/scylla-us-east-1-us-east-1a "$SCYLLA_NAMESPACE" "$deploy_timeout"

    ########################################
    # SeaweedFS (S3)
    ########################################
    CURRENT_SECTION="SeaweedFS"
    log "Deploying SeaweedFS"
    # `weed mini` runs master, volume, filer, and S3 in a single process; the
    # admin UI, WebDAV, Iceberg, and Lance endpoints are disabled since only
    # S3 is needed. S3 identities come from the s3.json secret so additional
    # users can be declared there. The master/filer ports have no auth (the
    # filer serves every object), so a NetworkPolicy limits other pods to the S3
    # port; only pods labelled app=seaweedfs-admin (the bucket creation job) may
    # reach master/filer with `weed shell`. Port-forwards enter through the pod's
    # own network namespace and are unaffected.
    kctl apply -f - <<EOF
---
apiVersion: v1
kind: Namespace
metadata:
  name: $SEAWEEDFS_NAMESPACE
---
apiVersion: v1
kind: Secret
metadata:
  name: seaweedfs-s3-config
  namespace: $SEAWEEDFS_NAMESPACE
type: Opaque
stringData:
  s3.json: |
    {
      "identities": [
        {
          "name": "thorium",
          "credentials": [
            {"accessKey": "$S3_AK", "secretKey": "$S3_SK"}
          ],
          "actions": ["Admin", "Read", "Write", "List", "Tagging"]
        }
      ]
    }
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: seaweedfs
  namespace: $SEAWEEDFS_NAMESPACE
  labels:
    app: seaweedfs
spec:
  serviceName: seaweedfs
  replicas: 1
  selector:
    matchLabels:
      app: seaweedfs
  template:
    metadata:
      labels:
        app: seaweedfs
      annotations:
        # rolls the pod when the S3 keys change (s3.json is only read at start)
        minithor/config-hash: "$(config_hash "$S3_AK:$S3_SK")"
    spec:
      containers:
        - name: seaweedfs
          image: $SEAWEEDFS_IMAGE
          args:
            - mini
            - -dir=/data
            - -s3.config=/etc/seaweedfs/s3.json
            - -admin.ui=false
            - -webdav=false
            - -s3.port.iceberg=0
            - -s3.port.lance=0
          resources:
            requests:
              cpu: 256m
              memory: 512Mi
            limits:
              cpu: 1
              memory: 1Gi
          ports:
            - containerPort: 8333
              name: s3
          readinessProbe:
            httpGet:
              path: /healthz
              port: 8333
            periodSeconds: 5
            failureThreshold: 3
          volumeMounts:
            - mountPath: /data
              name: seaweedfs-data
            - mountPath: /etc/seaweedfs
              name: s3-config
              readOnly: true
      volumes:
        - name: s3-config
          secret:
            secretName: seaweedfs-s3-config
  volumeClaimTemplates:
    - metadata:
        name: seaweedfs-data
      spec:
        storageClassName: csi-hostpath-sc
        accessModes:
          - ReadWriteOnce
        resources:
          requests:
            storage: 8Gi
---
apiVersion: v1
kind: Service
metadata:
  name: seaweedfs
  namespace: $SEAWEEDFS_NAMESPACE
spec:
  selector:
    app: seaweedfs
  ports:
  - port: 8333
    targetPort: 8333
    name: s3
    protocol: TCP
  - port: 9333
    targetPort: 9333
    name: master
    protocol: TCP
  - port: 19333
    targetPort: 19333
    name: master-grpc
    protocol: TCP
  - port: 8888
    targetPort: 8888
    name: filer
    protocol: TCP
  - port: 18888
    targetPort: 18888
    name: filer-grpc
    protocol: TCP
  type: ClusterIP
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: seaweedfs-ingress
  namespace: $SEAWEEDFS_NAMESPACE
spec:
  podSelector:
    matchLabels:
      app: seaweedfs
  policyTypes:
    - Ingress
  ingress:
    # S3 is authenticated by s3.json and open to the cluster
    - ports:
        - port: 8333
          protocol: TCP
    # master/filer admin ports only for the bucket job and the pod itself
    - from:
        - podSelector:
            matchLabels:
              app: seaweedfs-admin
        - podSelector:
            matchLabels:
              app: seaweedfs
EOF

    ########################################
    # Jaeger
    ########################################
    CURRENT_SECTION="Jaeger"
    log "Deploying Jaeger"
    kctl apply -f - <<EOF
---
apiVersion: v1
kind: Namespace
metadata:
  name: $JAEGER_NAMESPACE
---
