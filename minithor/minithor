cmd_minikube_install() {
    local certs_path=""
    local force_node_config=false
    local total_cpus="" total_memory_gib="" node_cpus="" node_memory_gib=""
    local install_nodes=1

    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) usage_minikube_install; return 0 ;;
            --nodes)
                shift
                if [ $# -eq 0 ] || ! [[ "$1" =~ ^[1-9][0-9]*$ ]]; then
                    echo "ERROR: --nodes requires a positive numeric argument" >&2; exit 1
                fi
                install_nodes="$1"
                ;;
            --cpus)
                shift
                if [ $# -eq 0 ] || ! [[ "$1" =~ ^[0-9]+$ ]]; then
                    echo "ERROR: --cpus requires a numeric argument" >&2; exit 1
                fi
                total_cpus="$1"
                ;;
            --memory)
                shift
                if [ $# -eq 0 ] || ! [[ "$1" =~ ^[0-9]+$ ]]; then
                    echo "ERROR: --memory requires a numeric argument (GiB)" >&2; exit 1
                fi
                total_memory_gib="$1"
                ;;
            --node-cpus)
                shift
                if [ $# -eq 0 ] || ! [[ "$1" =~ ^[0-9]+$ ]]; then
                    echo "ERROR: --node-cpus requires a numeric argument" >&2; exit 1
                fi
                node_cpus="$1"
                ;;
            --node-memory)
                shift
                if [ $# -eq 0 ] || ! [[ "$1" =~ ^[0-9]+$ ]]; then
                    echo "ERROR: --node-memory requires a numeric argument (GiB)" >&2; exit 1
                fi
                node_memory_gib="$1"
                ;;
            --certs)
                shift
                if [ $# -eq 0 ]; then
                    echo "ERROR: --certs requires an argument" >&2; exit 1
                fi
                certs_path="$1"
                ;;
            --force-node-config)
                force_node_config=true
                ;;
            *) echo "Unknown option: $1"; usage_minikube_install; exit 1 ;;
        esac
        shift
    done

    # A cluster total and a per-node size for the same resource can't both apply
    if [ -n "$total_cpus" ] && [ -n "$node_cpus" ]; then
        echo "ERROR: --cpus (cluster total) and --node-cpus (per node) conflict; pass only one" >&2; exit 1
    fi
    if [ -n "$total_memory_gib" ] && [ -n "$node_memory_gib" ]; then
        echo "ERROR: --memory (cluster total) and --node-memory (per node) conflict; pass only one" >&2; exit 1
    fi
    # minikube sizes every node the same, so split the cluster totals evenly
    # (rounding down) unless a per-node size was given; memory is split in MiB
    # so uneven splits don't lose whole GiBs
    local install_cpus install_memory_mib
    if [ -n "$node_cpus" ]; then
        install_cpus="$node_cpus"
    else
        install_cpus=$(( ${total_cpus:-8} / install_nodes ))
    fi
    if [ -n "$node_memory_gib" ]; then
        install_memory_mib=$(( node_memory_gib * 1024 ))
    else
        install_memory_mib=$(( ${total_memory_gib:-16} * 1024 / install_nodes ))
    fi
    # The scaler reserves 2 CPUs and 2 GiB on every node, so a smaller node
    # gives Thorium no capacity to run jobs on
    if [ "$install_cpus" -le 2 ] || [ "$install_memory_mib" -le 2048 ]; then
        echo "ERROR: each node needs more than 2 CPUs and 2 GiB of memory (the scaler reserves that much per node)," \
            "but $install_nodes node(s) would get $install_cpus CPUs and ${install_memory_mib} MiB each;" \
            "raise --cpus/--memory, lower --nodes, or set --node-cpus/--node-memory" >&2
        exit 1
    fi
    echo "Creating $install_nodes node(s) with $install_cpus CPUs and ${install_memory_mib} MiB each" \
        "($((install_nodes * install_cpus)) CPUs and $((install_nodes * install_memory_mib)) MiB total)"

    select_driver
    echo "Selected driver: $DRIVER"

    # Download and install minikube
    local tmp_dir
    tmp_dir=$(mktemp -d)
    # expanded now on purpose: the trap must remove this call's directory
    # shellcheck disable=SC2064
    trap "rm -rf '$tmp_dir'" RETURN

    case "$OS" in
        Darwin)
            if [ "$ARCH" = "arm64" ]; then
                curl -fL -o "$tmp_dir/minikube-darwin-arm64" https://storage.googleapis.com/minikube/releases/latest/minikube-darwin-arm64
                sudo install "$tmp_dir/minikube-darwin-arm64" /usr/local/bin/minikube
            else
                curl -fL -o "$tmp_dir/minikube-darwin-amd64" https://storage.googleapis.com/minikube/releases/latest/minikube-darwin-amd64
                sudo install "$tmp_dir/minikube-darwin-amd64" /usr/local/bin/minikube
            fi
            ;;
        Linux)
            if [ "$ARCH" = "x86_64" ]; then
                curl -fL -o "$tmp_dir/minikube-linux-amd64" https://storage.googleapis.com/minikube/releases/latest/minikube-linux-amd64
                sudo install "$tmp_dir/minikube-linux-amd64" /usr/local/bin/minikube
            elif [ "$ARCH" = "aarch64" ] || [ "$ARCH" = "arm64" ]; then
                curl -fL -o "$tmp_dir/minikube-linux-arm64" https://storage.googleapis.com/minikube/releases/latest/minikube-linux-arm64
                sudo install "$tmp_dir/minikube-linux-arm64" /usr/local/bin/minikube
            else
                echo "Unsupported Linux architecture: $ARCH"
                exit 1
            fi
            ;;
        *)
            echo "Unsupported OS: $OS"
            exit 1
            ;;
    esac

    touch ~/.bashrc
    if ! grep -q 'alias kubectl="minikube kubectl --"' ~/.bashrc 2>/dev/null; then
        echo 'alias kubectl="minikube kubectl --"' >> ~/.bashrc
    fi

    touch ~/.zshrc
    if ! grep -q 'alias kubectl="minikube kubectl --"' ~/.zshrc 2>/dev/null; then
        echo 'alias kubectl="minikube kubectl --"' >> ~/.zshrc
    fi

    # Persist NO_PROXY so interactive shells opened after this install (not
    # just minithor's own subcommands, which fix this up on every invocation
    # via ensure_minikube_running/minikube_start) can reach the minikube node
    # through the proxy-aware kubectl alias above.
    local persisted_no_proxy
    persisted_no_proxy="$(compute_no_proxy)"
    persist_no_proxy_rc ~/.bashrc "$persisted_no_proxy"
    persist_no_proxy_rc ~/.zshrc "$persisted_no_proxy"

    # the node count and sizes are passed as flags so they apply only to this
    # profile; minikube saves them with the profile for later restarts
    minikube_start --nodes="$install_nodes" --cpus="$install_cpus" --memory="$install_memory_mib"
    fix_container_config

    # Configure each node's container runtime to pull through the host proxy and,
    # if --certs was given, trust the (TLS-intercepting) proxy CA. This is what
    # lets external image pulls (quay.io/calico, ghcr.io/..., docker.io/...)
    # succeed on a proxied host; a no-op when the host has no proxy configured.
    setup_node_pull_env "$certs_path" "$force_node_config"

    # Nodes only turn Ready once the CNI images (pulled through the proxy set
    # up above) are running, so wait for every node before enabling addons
    kctl wait --for=condition=Ready node --all --timeout=600s

    kctl config view --minify

    minikube addons enable csi-hostpath-driver
    minikube addons enable ingress
    minikube addons enable ingress-dns
}

########################################
# Subcommand: minikube delete
########################################

cmd_minikube_delete() {
    local confirm=false

    local purge=false
    for arg in "$@"; do
        case "$arg" in
            -h|--help) usage_minikube_delete; return 0 ;;
            --confirm) confirm=true ;;
            --purge)   purge=true ;;
            *) echo "Unknown option: $arg"; usage_minikube_delete; exit 1 ;;
        esac
    done

    if [ "$confirm" = false ]; then
        echo "ERROR: --confirm flag is required to delete minikube." >&2
        echo "" >&2
        usage_minikube_delete >&2
        return 1
    fi

    # a broken install (e.g. docker daemon down) must still be deletable
    select_driver || true

    if [ -n "$DRIVER" ]; then
        echo "Detected available driver: $DRIVER"
    else
        echo "No working podman/docker/kvm2 driver detected."
    fi

    # Tear down any dev port-forwards and the loopback aliases they created
    # before destroying the cluster they point at.
    echo "Stopping dev port-forwards and removing loopback aliases..."
    stop_all_forwards || true
    remove_all_loopback_aliases || true

    # only this profile is deleted, so other minikube clusters on the host survive
    if command -v minikube >/dev/null 2>&1; then
        minikube delete || true
    else
        echo "minikube not found; skipping minikube delete."
    fi

    if [ "$purge" = false ]; then
        return 0
    fi
    if [ -n "$(minikube profile list -o json 2>/dev/null | grep -o '"Name":"[^"]*"' || true)" ]; then
        echo "Other minikube profiles remain; skipping --purge so they keep working" >&2
        return 0
    fi
    rm -rf ~/.minikube ~/.kube
    sudo rm -f /usr/local/bin/minikube
    sudo rm -f /usr/local/bin/kubectl

    if [ "$CONTAINER_CMD" = "podman" ]; then
        echo "Using podman for container cleanup..."
        podman system prune --force
        podman image prune -a --force
    elif [ "$CONTAINER_CMD" = "docker" ]; then
        echo "Using docker for container cleanup..."
        env -u DOCKER_HOST docker system prune --force
        env -u DOCKER_HOST docker image prune -a --force
    else
        echo "No working container runtime found; skipping container cleanup."
    fi
}

########################################
# Subcommand: minikube (dispatcher)
########################################

cmd_minikube() {
    if [ $# -eq 0 ]; then
        usage_minikube
        exit 1
    fi

    local subcmd="$1"
    shift

    case "$subcmd" in
        install) cmd_minikube_install "$@" ;;
        delete)  cmd_minikube_delete "$@" ;;
        -h|--help) usage_minikube; return 0 ;;
        *)
            echo "Unknown minikube subcommand: $subcmd" >&2
            echo "" >&2
            usage_minikube >&2
            exit 1
            ;;
    esac
}

########################################
# Subcommand: start
########################################

cmd_start() {
    for arg in "$@"; do
        case "$arg" in
            -h|--help) usage_start; return 0 ;;
        esac
    done

    # restart with the driver the cluster was created with, even if another one has become
    # available since; a profile that was never created is left to 'minikube install', which
    # sizes it
    if ! detect_profile_driver; then
        local opts=""
        [ "$MINIKUBE_PROFILE" != "minikube" ] && opts=" --profile $MINIKUBE_PROFILE"
        echo "ERROR: there is no minikube cluster for profile $MINIKUBE_PROFILE; create it with: minithor${opts} minikube install" >&2
        exit 1
    fi
    echo "Using the cluster's driver: $DRIVER"

    minikube_start
    fix_container_config

    # Re-assert the node's proxy drop-in (the docker driver's node restart can
    # drop it). Certs persist on the node filesystem, so no path is needed here.
    setup_node_pull_env ""

    log "Tuning minikube node kernel parameters on every node"
    tune_kernel_params

    sleep 30

    # Re-assert the registry hosts entry (lost when the node restarts) so pulls
    # resolve before we clear any stuck ImagePullBackOff pods below.
    ensure_registry_node_dns

    # Delete pods stuck in terminal failure states
    kctl get pods -A --no-headers 2>/dev/null \
        | grep -E 'CrashLoopBackOff|Error|ImagePullBackOff|ErrImagePull|InvalidImageName' \
        | awk '{print $2 " -n " $1}' \
        | while read -r line; do
            # $line is "<pod> -n <namespace>" and must split into arguments
            # shellcheck disable=SC2086
            kctl delete pod $line --ignore-not-found 2>/dev/null || true
        done
}

########################################
# Subcommand: stop
########################################

cmd_stop() {
    for arg in "$@"; do
        case "$arg" in
            -h|--help) usage_stop; return 0 ;;
        esac
    done

    ensure_minikube_running
    minikube stop
}

########################################
# Helm helpers
########################################

# Fail unless an option that takes a value was given one
#
#   need_value <option> <number of remaining args including the option>
need_value() {
    if [ "$2" -lt 2 ]; then
        echo "ERROR: $1 requires a value" >&2
        exit 1
    fi
}

# Fail unless an option's value is a positive whole number
#
#   need_number <option> <value>
need_number() {
    if ! [[ "$2" =~ ^[1-9][0-9]*$ ]]; then
        echo "ERROR: $1 requires a positive number of seconds" >&2
        exit 1
    fi
}

# Verify a file against a "<sha256>  <name>" line using whichever tool the host has
#
#   sha256_check <dir> <checksum line>
sha256_check() {
    if command -v sha256sum >/dev/null 2>&1; then
        (cd "$1" && sha256sum -c - <<< "$2" >/dev/null)
    else
        (cd "$1" && shasum -a 256 -c - <<< "$2" >/dev/null)
    fi
}

# Quote a string as a YAML (JSON) double-quoted scalar
yaml_str() {
    printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"
}

# Make a Helm binary that supports OCI charts (3.8+) available as $HELM: the helm on PATH if it
# is new enough, otherwise the pinned release, downloaded and checksum-verified on first use
ensure_helm() {
    if command -v helm >/dev/null 2>&1; then
        local version major minor
        version="$(helm version --template '{{.Version}}' 2>/dev/null || true)"
        major="$(echo "$version" | sed -n 's/^v\([0-9]*\)\..*/\1/p')"
        minor="$(echo "$version" | sed -n 's/^v[0-9]*\.\([0-9]*\)\..*/\1/p')"
        if [ -n "$major" ] && { [ "$major" -gt 3 ] || { [ "$major" -eq 3 ] && [ "$minor" -ge 8 ]; }; }; then
            HELM="$(command -v helm)"
            return 0
        fi
    fi
    local bin_dir="${MINITHOR_STATE_DIR}/bin/helm-${HELM_VERSION}"
    HELM="${bin_dir}/helm"
    [ -x "$HELM" ] && return 0
    local os arch
    case "$OS" in
        Linux)  os="linux" ;;
        Darwin) os="darwin" ;;
        *) echo "ERROR: unsupported OS for helm: $OS" >&2; exit 1 ;;
    esac
    case "$ARCH" in
        x86_64|amd64)  arch="amd64" ;;
        arm64|aarch64) arch="arm64" ;;
        *) echo "ERROR: unsupported architecture for helm: $ARCH" >&2; exit 1 ;;
    esac
    local archive="helm-${HELM_VERSION}-${os}-${arch}.tar.gz"
    echo "Downloading helm ${HELM_VERSION} (${os}/${arch})..."
    mkdir -p "$bin_dir"
    curl -fsSL -o "${bin_dir}/${archive}" "https://get.helm.sh/${archive}"
    curl -fsSL -o "${bin_dir}/${archive}.sha256sum" "https://get.helm.sh/${archive}.sha256sum"
    if ! sha256_check "$bin_dir" "$(cat "${bin_dir}/${archive}.sha256sum")"; then
        rm -f "${bin_dir}/${archive}"
        echo "ERROR: checksum verification failed for ${archive}" >&2
        exit 1
    fi
    tar -xzf "${bin_dir}/${archive}" -C "$bin_dir" --strip-components=1 "${os}-${arch}/helm"
    rm -f "${bin_dir}/${archive}" "${bin_dir}/${archive}.sha256sum"
    chmod +x "$HELM"
}

# Run helm against the selected profile's kube context only
helm_cmd() { "$HELM" --kube-context "$MINIKUBE_PROFILE" "$@"; }

# Resolve where the charts come from and set THORIUM_CHART/OPERATORS_CHART plus the extra helm
# arguments each needs (--version for OCI charts). Local charts are a chart directory or a
# packaged .tgz; when only --chart is local, infra-operators is looked up next to it.
#
#   resolve_charts <--chart value> <--operators-chart value> <--chart-version value>
resolve_charts() {
    local chart="$1" operators="$2" version="${3:-$CHART_VERSION}"
    THORIUM_CHART_ARGS=()
    OPERATORS_CHART_ARGS=()
    if [ -z "$chart" ]; then
        chart="${CHART_REPO}/thorium"
    fi
    if [[ "$chart" == oci://* ]]; then
        THORIUM_CHART_ARGS=(--version "$version")
        if [ -z "$operators" ]; then
            operators="${chart%/thorium}/infra-operators"
        fi
    else
        if [ ! -e "$chart" ]; then
            echo "ERROR: chart $chart does not exist (a chart directory, .tgz, or oci:// reference)" >&2
            exit 1
        fi
        chart="$(cd "$(dirname "$chart")" && pwd)/$(basename "$chart")"
        if [ -z "$operators" ]; then
            local dir
            dir="$(dirname "$chart")"
            if [ -d "$chart" ] && [ -f "$dir/infra-operators/Chart.yaml" ]; then
                operators="$dir/infra-operators"
            else
                operators="$(ls -t "$dir"/infra-operators-*.tgz 2>/dev/null | head -1 || true)"
            fi
            if [ -z "$operators" ]; then
                echo "ERROR: no infra-operators chart next to $chart; pass --operators-chart" >&2
                exit 1
            fi
        fi
    fi
    if [[ "$operators" == oci://* ]]; then
        OPERATORS_CHART_ARGS=(--version "$version")
    elif [ ! -e "$operators" ]; then
        echo "ERROR: chart $operators does not exist" >&2
        exit 1
    fi
    THORIUM_CHART="$chart"
    OPERATORS_CHART="$operators"
    echo "thorium chart:         $THORIUM_CHART ${THORIUM_CHART_ARGS[*]:-}"
    echo "infra-operators chart: $OPERATORS_CHART ${OPERATORS_CHART_ARGS[*]:-}"
}

# Print --set flags disabling each operator that already runs outside the infra-operators
# namespace (e.g. installed by another tool), found by its workloads' labels
operator_disable_flags() {
    local component name found
    for component in scylla-operator:scylla-operator eck-operator:elastic-operator kubegres:kubegres; do
        name="${component#*:}"
        found="$(kctl get deploy,statefulset -A -l "app.kubernetes.io/name=${name}" \
            -o jsonpath='{range .items[*]}{.metadata.namespace}{"\n"}{end}' 2>/dev/null \
            | grep -vx "$OPERATORS_NAMESPACE" | head -1 || true)"
        if [ -n "$found" ]; then
            echo "  ${component%%:*} already runs in namespace $found; not installing another" >&2
            printf -- '--set\n%s.enabled=false\n' "${component%%:*}"
        fi
    done
}

# The development defaults deploy layers under the generated values (each top-level key
# configures one subchart of the thorium chart)
embedded_values() {
    cat <<'EOF'
# minithor development defaults for the thorium chart
# every backing service runs in the cluster; pass --values with global.managed.<service>: false
# and the matching external settings to use an external one (see "Configure the Helm Charts", "External
# services")
global:
  managed:
    scylla: true
    elastic: true
    redis: true
    s3: true
    postgres: true
operator:
  ingress:
    type: nginx
    className: nginx
  toolbox:
    mode: overwrite
infra:
  elastic:
    javaOpts: -Xms1g -Xmx1g
    # dev machines often run with nearly full disks; don't let that block shard allocation
    config:
      cluster.routing.allocation.disk.threshold_enabled: false
EOF
}

# The thorctl config deploy logs in to: thorctl's default config for the default profile,
# and a separate one for any other profile so a deploy never replaces another cluster's login
thorctl_config_path() {
    echo "$HOME/.thorium/config$(profile_suffix).yml"
}

# Point a thorctl config at the API on a local port
#
#   set_thorctl_api <config> <port>
set_thorctl_api() {
    sed -i.tmp "s#^\(  api: \).*#\1http://localhost:$2#" "$1" && rm -f "$1.tmp"
}

# Install thorctl from the deployed API and log it in as the admin user, or only install it when
# no user is given. A private port-forward on a port kubectl picks is used so it never collides
# with `minithor expose`.
#
#   install_thorctl <bin dir> [user] [password]
install_thorctl() {
    local bin_dir="$1" user="${2:-}" password="${3:-}" pf_port="" _attempt
    PF_LOG=$(mktemp)
    kctl -n "$THORIUM_NAMESPACE" port-forward svc/thorium-api :80 >"$PF_LOG" 2>&1 &
    PF_PID=$!
    trap 'kill_tree "$PF_PID"; rm -f "$PF_LOG"; true' EXIT
    for _attempt in $(seq 1 20); do
        pf_port=$(sed -n 's/^Forwarding from 127\.0\.0\.1:\([0-9]*\) .*/\1/p' "$PF_LOG" | head -1)
        [ -n "$pf_port" ] && break
        kill -0 "$PF_PID" 2>/dev/null || break
        sleep 1
    done
    if [ -z "$pf_port" ]; then
        echo "ERROR: port-forward to thorium-api failed: $(cat "$PF_LOG")" >&2
        return 1
    fi
    wait_for_port_forward "$pf_port" 20
    local url="http://localhost:$pf_port" os hw sudo_cmd=""
    os=$(uname -s | awk '{print tolower($0)}')
    hw=$(uname -m | tr '_' '-')
    # create a missing --bin directory, with sudo when its parent isn't writable
    if [ ! -d "$bin_dir" ]; then
        echo "Creating $bin_dir for thorctl..."
        if ! mkdir -p "$bin_dir" 2>/dev/null && ! sudo mkdir -p "$bin_dir"; then
            echo "ERROR: could not create the thorctl directory $bin_dir" >&2
            return 1
        fi
    fi
    [ -w "$bin_dir" ] || sudo_cmd="sudo"
    echo "Downloading thorctl to $bin_dir/thorctl for $os/$hw..."
    if ! $sudo_cmd curl -fsS "$url/api/binaries/$os/$hw/thorctl" -o "$bin_dir/thorctl"; then
        echo "ERROR: failed to download thorctl from $url/api/binaries/$os/$hw/thorctl to $bin_dir/thorctl" >&2
        return 1
    fi
    $sudo_cmd chmod 755 "$bin_dir/thorctl" || return 1
    if [ -z "$user" ]; then
        kill_tree "$PF_PID"
        return 0
    fi
    THORCTL_CONFIG="$(thorctl_config_path)"
    mkdir -p "$(dirname "$THORCTL_CONFIG")"
    if [ -f "$THORCTL_CONFIG" ]; then
        cp -p "$THORCTL_CONFIG" "$THORCTL_CONFIG.bak"
        echo "Backed up the existing thorctl config to $THORCTL_CONFIG.bak"
    fi
    # thorctl login only takes a password on its command line or from a terminal prompt, so the
    # password is briefly visible to other local users in the process list while it runs
    "$bin_dir/thorctl" --config "$THORCTL_CONFIG" login "$url" --user "$user" --password "$password" || return 1
    # the port-forward above closes when deploy exits, so the config points at the API
    # 'minithor expose' serves by default; expose updates it to the port it actually uses
    set_thorctl_api "$THORCTL_CONFIG" 8080
    # the private port-forward is no longer needed
    kill_tree "$PF_PID"
}

# Fail unless deploying into THORIUM_NAMESPACE keeps the cluster at one Thorium deployment.
# Thorium supports one deployment per Kubernetes cluster (its scaler and operator act
# cluster-wide), and a namespace prefix only renames the namespaces, so a thorium release or
# ThoriumCluster in any other namespace means another deployment already owns this cluster. A
# ThoriumCluster Helm doesn't manage in THORIUM_NAMESPACE was made by the pre-Helm scripts and
# must be converted before the chart can take it over.
check_single_deployment() {
    local releases clusters ns name helm_release opts=""
    [ "$MINIKUBE_PROFILE" != "minikube" ] && opts=" --profile $MINIKUBE_PROFILE"
    # every thorium release on the cluster, whatever state it is in, as its namespace
    releases="$(helm_cmd list -A -a -f "^${THORIUM_RELEASE}\$" 2>/dev/null | awk 'NR > 1 {print $2}' || true)"
    for ns in $releases; do
        if [ "$ns" != "$THORIUM_NAMESPACE" ]; then
            local prefix="${ns%thorium}"
            prefix="${prefix%-}"
            echo "ERROR: a thorium release already exists in namespace $ns, and a cluster runs only one Thorium deployment" >&2
            echo "  Pass the namespace prefix it was deployed with:  minithor${opts}${prefix:+ --namespace-prefix $prefix} deploy" >&2
            echo "  or remove it first:  minithor${opts}${prefix:+ --namespace-prefix $prefix} cleanup --confirm" >&2
            exit 1
        fi
    done
    # ThoriumClusters as "<namespace> <name> <release annotation>"; none when the CRD is missing
    clusters="$(kctl get thoriumclusters.sandia.gov -A -o jsonpath='{range .items[*]}{.metadata.namespace}{" "}{.metadata.name}{" "}{.metadata.annotations.meta\.helm\.sh/release-name}{"\n"}{end}' 2>/dev/null || true)"
    while read -r ns name helm_release; do
        [ -n "$ns" ] || continue
        if [ "$ns" != "$THORIUM_NAMESPACE" ]; then
            echo "ERROR: ThoriumCluster $ns/$name already exists, and a cluster runs only one Thorium deployment" >&2
            echo "  Deploy with the namespace prefix of $ns, or remove that deployment first" >&2
            exit 1
        fi
        if [ -z "$helm_release" ]; then
            echo "ERROR: ThoriumCluster $ns/$name was deployed by a pre-Helm minithor or megathor and must be converted first" >&2
            echo "  See \"Existing minithor deployments\" in minithor/README.md and \"Converting a Pre-Helm" >&2
            echo "  Deployment\" in the Thorium deployment docs" >&2
            exit 1
        fi
    done <<< "$clusters"
}

# Wait until every ThoriumCluster in the Thorium namespace is Ready for its current spec,
# failing as soon as one reports the Error phase, the UpgradeRequired phase (its upgrade target,
# such as a targetRevision from --values or --set, is older than the operator's latest
# revision), or an upgrade step that is Blocked (such as one waiting for an approval), since none
# of these resolves by waiting. A status only counts once its
# observed_generation matches metadata.generation, so the phase left over from the previous
# spec is never mistaken for the result of this deploy. Every ThoriumCluster is checked because
# a deployment converted from the pre-Helm scripts keeps its old ThoriumCluster name.
#
#   wait_for_thorium_ready <timeout seconds>
wait_for_thorium_ready() {
    local timeout=$1 elapsed=0 rows name generation observed phase blocked ready
    local status_path='{range .items[*]}{.metadata.name}{"|"}{.metadata.generation}{"|"}{.status.observed_generation}{"|"}{.status.phase}{"|"}{.status.upgrade.steps[?(@.state=="Blocked")].step}{"\n"}{end}'
    while :; do
        rows="$(kctl -n "$THORIUM_NAMESPACE" get thoriumclusters.sandia.gov -o jsonpath="$status_path" 2>/dev/null || true)"
        ready=false
        [ -n "$rows" ] && ready=true
        while IFS='|' read -r name generation observed phase blocked; do
            [ -n "$name" ] || continue
            # a status written for an older spec says nothing about this one yet
            if [ "$observed" != "$generation" ]; then
                ready=false
                continue
            fi
            if [ "$phase" = "Error" ] || [ "$phase" = "UpgradeRequired" ] || [ -n "$blocked" ]; then
                if [ -n "$blocked" ]; then
                    echo "ERROR: ThoriumCluster $name has blocked upgrade steps:" >&2
                    kctl -n "$THORIUM_NAMESPACE" get thoriumclusters.sandia.gov "$name" \
                        -o jsonpath='{range .status.upgrade.steps[?(@.state=="Blocked")]}  {.step}: {.message}{"\n"}{end}' >&2 || true
                else
                    echo "ERROR: ThoriumCluster $name is in the $phase phase" >&2
                fi
                echo "  status.message: $(kctl -n "$THORIUM_NAMESPACE" get thoriumclusters.sandia.gov "$name" -o jsonpath='{.status.message}' 2>/dev/null || true)" >&2
                exit 1
            fi
            [ "$phase" = "Ready" ] || ready=false
        done <<< "$rows"
        [ "$ready" = true ] && return 0
        if [ "$elapsed" -ge "$timeout" ]; then
            echo "ERROR: Thorium did not become ready within ${timeout}s; status:" >&2
            kctl -n "$THORIUM_NAMESPACE" get thoriumclusters.sandia.gov -o jsonpath='{range .items[*]}{.metadata.name}: {.status}{"\n"}{end}' >&2 || true
            exit 1
        fi
        # a backend that never becomes reachable keeps the cluster provisioning until the
        # timeout, so show what it is waiting on every minute
        if [ "$elapsed" -gt 0 ] && [ $((elapsed % 60)) -eq 0 ]; then
            kctl -n "$THORIUM_NAMESPACE" get thoriumclusters.sandia.gov \
                -o jsonpath='{range .items[*]}{.metadata.name}{"|"}{.status.phase}{"|"}{.status.message}{"\n"}{end}' 2>/dev/null \
                | while IFS='|' read -r name phase message; do
                    [ -n "$name" ] || continue
                    echo "  still waiting after ${elapsed}s: $name is ${phase:-not reconciled yet}${message:+: ${message:0:300}}"
                done || true
        fi
        sleep 10
        elapsed=$((elapsed + 10))
    done
}

# Print "<secret>|<username key>|<literal username>|<password key>" for the admin bootstrap of
# the ThoriumCluster in the Thorium namespace, or nothing when its spec.bootstrap.admin is unset.
# The admin bootstrap is off in a deployment converted without an admin login, and then the
# thorium-admin secret the chart still renders names no real user.
admin_bootstrap() {
    kctl -n "$THORIUM_NAMESPACE" get thoriumclusters.sandia.gov \
        -o jsonpath='{range .items[*]}{.spec.bootstrap.admin.secret.name}{"|"}{.spec.bootstrap.admin.secret.username_key}{"|"}{.spec.bootstrap.admin.secret.username}{"|"}{.spec.bootstrap.admin.secret.password_key}{"\n"}{end}' 2>/dev/null \
        | awk -F'|' '$1 != "" {print; exit}' || true
}

# Print the admin bootstrap's username and password, one per line, read from the Secret the
# ThoriumCluster's spec.bootstrap.admin names; prints nothing when the bootstrap is off
admin_login() {
    local secret user_key literal password_key
    IFS='|' read -r secret user_key literal password_key <<< "$(admin_bootstrap)"
    [ -n "$secret" ] || return 0
    # the username key takes precedence over a literal username, as in the operator
    if [ -n "$user_key" ]; then
        kctl -n "$THORIUM_NAMESPACE" get secret "$secret" -o go-template="{{index .data \"$user_key\" | base64decode}}{{\"\\n\"}}"
    else
        echo "$literal"
    fi
    kctl -n "$THORIUM_NAMESPACE" get secret "$secret" -o go-template="{{index .data \"$password_key\" | base64decode}}{{\"\\n\"}}"
}

# Print the admin username and password to render into the chart values, one per line; an
# empty password lets the chart keep the stored one (or generate one on the first deploy). The
# operator creates the admin once and never changes an existing admin's password, so a redeploy
# keeps the login stored in thorium-credentials unless --user, --password, or --rand-password
# ask for another one.
#
#   resolve_admin_login <--user value> <--password value> <whether --rand-password was given>
resolve_admin_login() {
    local user="$1" password="$2" rand_password="$3" stored_user="" stored_password=""
    if kctl get secret thorium-credentials -n "$THORIUM_NAMESPACE" &>/dev/null; then
        stored_user="$(kctl get secret thorium-credentials -n "$THORIUM_NAMESPACE" \
            -o go-template='{{with index .data "adminUsername"}}{{. | base64decode}}{{end}}')"
        stored_password="$(kctl get secret thorium-credentials -n "$THORIUM_NAMESPACE" \
            -o go-template='{{with index .data "adminPassword"}}{{. | base64decode}}{{end}}')"
    fi
    [ -n "$user" ] || user="${stored_user:-test}"
    if [ "$rand_password" = true ]; then
        password=""
    elif [ -z "$password" ] && [ -z "$stored_password" ]; then
        password="INSECURE_DEV_PASSWORD"
    elif [ -n "$password" ] && [ -n "$stored_password" ] && [ "$password" != "$stored_password" ]; then
        echo "WARNING: --password changes the thorium-admin secret, but the operator doesn't change the" >&2
        echo "  password of the existing admin user; change it in Thorium too, or log in with the old one" >&2
    fi
    printf '%s\n%s\n' "$user" "$password"
}

########################################
# Subcommand: deploy
########################################

cmd_deploy() {
    local chart="" operators_chart="" chart_version="" user=""
    local password="" password_given=false rand_password=false version="" registry=false
    local registry_user="" toolbox="$DEFAULT_TOOLBOX_URL" banner="" docker_config=""
    local bin_dir="/usr/local/bin" kibana=true skip_operators=false thorctl=true
    local timeout=1800
    local proxy="${HTTPS_PROXY:-${https_proxy:-${HTTP_PROXY:-${http_proxy:-}}}}"
    local extra_no_proxy=""
    local -a user_values=() user_sets=()
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) usage_deploy; return 0 ;;
            --chart)           need_value "$1" $#; chart="$2"; shift ;;
            --operators-chart) need_value "$1" $#; operators_chart="$2"; shift ;;
            --chart-version)   need_value "$1" $#; chart_version="$2"; shift ;;
            --values)          need_value "$1" $#; user_values+=("$2"); shift ;;
            --set)             need_value "$1" $#; user_sets+=("$2"); shift ;;
            --user)            need_value "$1" $#; user="$2"; shift ;;
            --password)        need_value "$1" $#; password="$2"; password_given=true; shift ;;
            --rand-password)   rand_password=true ;;
            --version)         need_value "$1" $#; version="$2"; shift ;;
            --registry)        registry=true ;;
            --registry-user)   need_value "$1" $#; registry_user="$2"; registry=true; shift ;;
            --toolbox)         need_value "$1" $#; toolbox="$2"; shift ;;
            --no-toolbox)      toolbox="" ;;
            --banner)          need_value "$1" $#; banner="$2"; shift ;;
            --docker-config)   need_value "$1" $#; docker_config="$2"; shift ;;
            --bin)             need_value "$1" $#; bin_dir="$2"; shift ;;
            --no-thorctl)      thorctl=false ;;
            --no-kibana)       kibana=false ;;
            --proxy)           need_value "$1" $#; proxy="$2"; shift ;;
            --no-proxy)        need_value "$1" $#; extra_no_proxy="$2"; shift ;;
            --skip-operators)  skip_operators=true ;;
            --timeout)         need_value "$1" $#; need_number "$1" "$2"; timeout="$2"; shift ;;
            *) echo "Unknown option: $1"; usage_deploy; exit 1 ;;
        esac
        shift
    done
    # the admin password comes from one source: the given one or a generated one
    if [ "$password_given" = true ] && [ "$rand_password" = true ]; then
        echo "ERROR: --password and --rand-password can't be combined; pass one or the other" >&2
        exit 1
    fi
    ensure_minikube_running
    # the node's container runtime only pulls over HTTP from registries trusted at start
    [ "$registry" = true ] && check_registry_trusted
    ensure_state_dir
    # the values files and downloaded toolbox may hold credentials
    umask 077

    log "Tuning minikube node kernel parameters on every node"
    tune_kernel_params

    log "Preparing Helm and the charts"
    ensure_helm
    echo "Using helm $("$HELM" version --template '{{.Version}}') at $HELM"
    resolve_charts "$chart" "$operators_chart" "$chart_version"
    check_single_deployment

    # pick the admin login to render, keeping the stored one on a redeploy
    local login_values
    login_values="$(resolve_admin_login "$user" "$password" "$rand_password")"
    user="$(printf '%s\n' "$login_values" | sed -n 1p)"
    password="$(printf '%s\n' "$login_values" | sed -n 2p)"

    log "Writing deployment values"
    local defaults_file="${MINITHOR_STATE_DIR}/values-defaults.yaml"
    local values_file
    values_file="${MINITHOR_STATE_DIR}/values$(profile_suffix).yaml"
    embedded_values > "$defaults_file"
    {
        echo "# Generated by minithor deploy for namespace prefix '${NAMESPACE_PREFIX:-none}'"
        # the service and pod CIDRs, which the chart adds to the operator's noProxy when it
        # has a proxy set
        echo "global:"
        echo "  clusterCIDRs: [$(yaml_str "$(profile_service_cidr)"), $(yaml_str "$(profile_pod_cidr)")]"
        echo "secrets:"
        echo "  credentials:"
        echo "    adminUsername: $(yaml_str "$user")"
        # without a password the chart keeps the stored one, or generates one on the first deploy
        if [ -n "$password" ]; then
            echo "    adminPassword: $(yaml_str "$password")"
        fi
        if [ -n "$registry_user" ]; then
            echo "  registryBasicAuth:"
            echo "    username: $(yaml_str "$registry_user")"
        fi
        echo "infra:"
        echo "  registry:"
        echo "    enabled: $registry"
        if [ -n "$registry_user" ]; then
            echo "    htpasswdSecret: registry-auth"
        fi
        echo "  elastic:"
        echo "    kibana:"
        echo "      enabled: $kibana"
        echo "operator:"
        if [ -n "$version" ]; then
            echo "  image:"
            echo "    tag: $(yaml_str "$version")"
        fi
        echo "  ingress:"
        echo "    host: localhost"
        echo "  cluster:"
        if [ -n "$version" ]; then
            echo "    version: $(yaml_str "$version")"
        fi
        # dev clusters take every upgrade revision their operator ships
        echo "    upgrade:"
        echo "      autoTargetDev: true"
        if [ -n "$proxy" ] && [ "$proxy" != none ]; then
            # the scaler reaches registries through the proxy
            local no_proxy_value
            no_proxy_value="$(scaler_no_proxy "$extra_no_proxy")"
            echo "    components:"
            echo "      scaler:"
            echo "        env:"
            local var
            for var in http_proxy https_proxy HTTP_PROXY HTTPS_PROXY; do
                echo "          - { name: $var, value: $(yaml_str "$proxy") }"
            done
            for var in no_proxy NO_PROXY; do
                echo "          - { name: $var, value: $(yaml_str "$no_proxy_value") }"
            done
        fi
        if [ -n "$docker_config" ]; then
            echo "  createImagePullSecret: true"
        fi
    } > "$values_file"
    echo "Values written to $values_file"
    # embedded defaults, then the flag values, then the user's own values and --set flags
    local -a values_args=(-f "$defaults_file" -f "$values_file")
    local f s
    for f in ${user_values[@]+"${user_values[@]}"}; do values_args+=(-f "$f"); done
    if [ -n "$toolbox" ]; then
        # fetch the toolbox on this host (which has the proxy settings), not in the cluster
        local toolbox_file
        toolbox_file="${MINITHOR_STATE_DIR}/toolbox$(profile_suffix).json"
        if [[ "$toolbox" =~ ^https?:// ]]; then
            echo "Downloading toolbox from $toolbox..."
            curl -fsSL -o "$toolbox_file" "$toolbox"
        else
            cp "$toolbox" "$toolbox_file"
        fi
        values_args+=(--set-file "operator.toolbox.json=$toolbox_file")
    fi
    [ -n "$banner" ] && values_args+=(--set-file "operator.banner=$banner")
    [ -n "$docker_config" ] && values_args+=(--set-file "operator.dockerConfigJson=$docker_config")
    for s in ${user_sets[@]+"${user_sets[@]}"}; do values_args+=(--set "$s"); done

    log "Deploying cluster-wide operators"
    if [ "$skip_operators" = true ]; then
        echo "Skipping operators (--skip-operators)"
    else
        local -a disable_args=()
        local arg
        while IFS= read -r arg; do
            disable_args+=("$arg")
        done < <(operator_disable_flags)
        if [ "${#disable_args[@]}" -eq 6 ] && ! helm_cmd status infra-operators -n "$OPERATORS_NAMESPACE" &>/dev/null; then
            echo "Every operator already runs on this cluster"
        else
            helm_cmd upgrade --install infra-operators "$OPERATORS_CHART" ${OPERATORS_CHART_ARGS[@]+"${OPERATORS_CHART_ARGS[@]}"} \
                -n "$OPERATORS_NAMESPACE" --create-namespace ${disable_args[@]+"${disable_args[@]}"} \
                --reset-values --wait --timeout "${timeout}s"
        fi
    fi

    log "Deploying Thorium into $THORIUM_NAMESPACE"
    helm_cmd upgrade --install "$THORIUM_RELEASE" "$THORIUM_CHART" ${THORIUM_CHART_ARGS[@]+"${THORIUM_CHART_ARGS[@]}"} \
        -n "$THORIUM_NAMESPACE" --create-namespace "${values_args[@]}" --reset-values --timeout "${timeout}s"
    echo "Waiting for the ThoriumCluster to be ready (up to ${timeout}s)..."
    wait_for_thorium_ready "$timeout"
    if [ "$registry" = true ]; then
        ensure_registry_node_dns
    fi

    # the admin login the operator bootstraps, which a --values file (such as the converted
    # values) may have changed and a converted deployment may not have at all
    local admin_user="" admin_password="" login
    login="$(admin_login)"
    if [ -n "$login" ]; then
        admin_user="$(printf '%s\n' "$login" | sed -n 1p)"
        admin_password="$(printf '%s\n' "$login" | sed -n 2p)"
    fi
    if [ "$thorctl" = true ]; then
        log "Installing thorctl"
        install_thorctl "$bin_dir" "$admin_user" "$admin_password" \
            || echo "WARNING: thorctl was not installed (see above)" >&2
    fi

    log "Deployment complete!"
    if [ -n "$NAMESPACE_PREFIX" ]; then
        echo "Thorium is running in the ${NAMESPACE_PREFIX}-* namespaces."
    else
        echo "Thorium is running in the thorium, redis, scylla, elastic, seaweedfs, quickwit, and jaeger namespaces."
    fi
    echo ""
    local opts=""
    [ -n "$NAMESPACE_PREFIX" ] && opts=" --namespace-prefix $NAMESPACE_PREFIX"
    [ "$MINIKUBE_PROFILE" != "minikube" ] && opts+=" --profile $MINIKUBE_PROFILE"
    if [ -z "$admin_user" ]; then
        echo "The ThoriumCluster's admin bootstrap is off, so no admin user was created; log in"
        echo "with an existing Thorium account (thorctl: thorctl login http://localhost:8080)"
    elif [ "$admin_password" = INSECURE_DEV_PASSWORD ] \
        || { [ -n "$password" ] && [ "$admin_password" = "$password" ]; }; then
        echo "Admin user: $admin_user / $admin_password"
    else
        echo "Admin user: $admin_user (password: run 'minithor${opts} credentials')"
    fi
    if [ -n "$registry_user" ]; then
        echo "Registry user: $registry_user (password: run 'minithor${opts} credentials --all')"
    fi
    echo ""
    echo "Next steps:"
    echo "  minithor${opts} expose        # API on http://localhost:8080"
    echo "  minithor${opts} get-config    # writes ~/thorium$(profile_suffix).yml"
    if [ -n "${THORCTL_CONFIG:-}" ] && [ "$THORCTL_CONFIG" != "$HOME/.thorium/config.yml" ]; then
        echo "  thorctl --config $THORCTL_CONFIG <command>   # this cluster's thorctl login"
    fi
}

########################################
# Subcommand: credentials
########################################

cmd_credentials() {
    local show_all=false
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) usage_credentials; return 0 ;;
            --all) show_all=true ;;
            *) echo "Unknown option: $1"; usage_credentials; exit 1 ;;
        esac
        shift
    done
    ensure_minikube_running
    if ! kctl get secret thorium-credentials -n "$THORIUM_NAMESPACE" &>/dev/null; then
        echo "ERROR: Thorium is not deployed (no thorium-credentials secret in $THORIUM_NAMESPACE)" >&2
        exit 1
    fi
    # the admin login the ThoriumCluster bootstraps, if its admin bootstrap is on
    local login
    login="$(admin_login)"
    if [ -n "$login" ]; then
        printf '%s\n' "$login" | awk 'NR == 1 {print "username: " $0} NR == 2 {print "password: " $0}'
    else
        echo "The ThoriumCluster's admin bootstrap is off, so no admin user was created" >&2
    fi
    # every generated backend credential, from the canonical store the secrets subchart keeps
    if [ "$show_all" = true ]; then
        kctl get secret thorium-credentials -n "$THORIUM_NAMESPACE" \
            -o go-template='{{range $k, $v := .data}}{{$k}}: {{$v | base64decode}}{{"\n"}}{{end}}'
    fi
}

# Rewrite an extracted thorium.yml so a host process can reach the cluster's
# databases through the ports created by `minithor expose --dev`.
#
#   translate_config_local <file> [port_offset]
translate_config_local() {
    local file=$1 offset=${2:-0}

    # Swap in-cluster service DNS names for localhost and relax the elastic cert
    # check (the cluster cert's SAN doesn't cover localhost). Use temp-file + mv
    # rather than `sed -i` so this works with both GNU and BSD/macOS sed.
    # The local ports follow `expose --port-offset`; redis's port is the only
    # "port: 6379" line in the config.
    sed \
        -e "s#${ELASTIC_CLUSTER_HOST}:9200#localhost:$((9200 + offset))#g" \
        -e "s#${REDIS_CLUSTER_HOST}#localhost#g" \
        -e "s#^\\( *port: \\)6379\$#\\1$((6379 + offset))#" \
        -e "s#${SEAWEEDFS_CLUSTER_HOST}:8333#localhost:$((8333 + offset))#g" \
        -e 's/^\( *insecure_certificates: \)false/\1true/' \
        -e "s/^\(  port: \)80\$/\1${LOCAL_API_PORT}/" \
        "$file" > "${file}.tmp" && mv "${file}.tmp" "$file"

    # Point scylla.nodes at each node's advertised cluster IP (the address the
    # expose forwards are bound to via loopback aliases). The raw config lists
    # the aggregate client service once; replace that line with the real nodes.
    local scylla_lines
    scylla_lines=$(discover_scylla_nodes | awk -v p="$SCYLLA_CQL_PORT" '{printf "  - %s:%s\n", $2, p}')
    if [ -z "$scylla_lines" ]; then
        echo "ERROR: could not discover any Scylla nodes; is the cluster running?" >&2
        return 1
    fi
    # $(...) strips the trailing newline from scylla_lines, so re-add one with \n
    # (for multi-node repl the inner newlines are preserved and only the final
    # one was stripped, so printing one back yields exactly the right output).
    # The lines go through the environment because BSD/macOS awk rejects a -v
    # value containing newlines.
    MINITHOR_SCYLLA_LINES="$scylla_lines" awk -v host="  - $SCYLLA_CLUSTER_HOST" '
        $0 == host { printf "%s\n", ENVIRON["MINITHOR_SCYLLA_LINES"]; next }
        { print }
    ' "$file" > "${file}.tmp" && mv "${file}.tmp" "$file"

    # Null out thorium.tracing.external (the in-cluster collector is not reachable
    # from the host and only produces connection noise). Its block is every more
    # deeply indented (or blank) line after it, so whatever follows the block is
    # kept no matter which key comes next.
    awk '
        skip && (/^     / || /^[[:space:]]*$/) { next }
        { skip=0 }
        /^[^ ]/ || /^  [^ ]/ { tracing=0 }
        /^  tracing:[[:space:]]*$/ { tracing=1 }
        tracing && /^    external:/ { print "    external: null"; skip=1; next }
        { print }
    ' "$file" > "${file}.tmp" && mv "${file}.tmp" "$file"
}

cmd_get_config() {
    local local_mode=false port_offset=0
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) usage_get_config; return 0 ;;
            --local)   local_mode=true ;;
            --port-offset)
                shift
                if [ $# -eq 0 ] || ! [[ "$1" =~ ^[0-9]+$ ]]; then
                    echo "ERROR: --port-offset requires a numeric argument" >&2; exit 1
                fi
                port_offset="$1"
                ;;
            *) echo "Unknown option: $1"; usage_get_config; exit 1 ;;
        esac
        shift
    done

    ensure_minikube_running
    # every file written here holds backend credentials, so keep them owner-only
    umask 077

    local output
    output="${HOME}/thorium$(profile_suffix).yml"
    [ "$local_mode" = true ] && output="${HOME}/thorium$(profile_suffix).local.yml"

    echo "Extracting Thorium config from cluster secret..."
    # The config holds every backend credential: build it in a private temp file
    # next to the destination and only replace the destination once it succeeds
    local tmp_output
    tmp_output=$(mktemp "${output}.XXXXXX")
    if ! kctl get secret thorium -n "$THORIUM_NAMESPACE" \
        -o go-template='{{index .data "thorium.yml" | base64decode}}' \
        > "$tmp_output"; then
        rm -f "$tmp_output"
        echo "ERROR: failed to read the thorium secret; is Thorium deployed?" >&2
        return 1
    fi

    if [ "$local_mode" = true ]; then
        echo "Translating config for local access via exposed ports..."
        if ! translate_config_local "$tmp_output" "$port_offset"; then
            rm -f "$tmp_output"
            echo "ERROR: failed to translate config for local use" >&2
            return 1
        fi
    fi
    mv "$tmp_output" "$output"

    if [ "$local_mode" = true ]; then
        echo "Local config written to $output"
        echo "Run 'minithor expose --dev' (if you haven't) then start the API with:"
        echo "  thorium-api --config $output     (listens on port ${LOCAL_API_PORT})"
    else
        echo "Config written to $output"
    fi
}

########################################
# Subcommand: expose
########################################

cmd_expose() {
    local DEV_MODE=false
    local STOP_MODE=false
    local STATUS_MODE=false
    local NO_API=false
    local API_PORT=""
    local port_offset=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --dev)    DEV_MODE=true ;;
            --no-api) NO_API=true ;;
            --stop)   STOP_MODE=true ;;
            --status) STATUS_MODE=true ;;
            --port)
                shift
                if [ $# -eq 0 ] || ! [[ "$1" =~ ^[0-9]+$ ]]; then
                    echo "ERROR: --port requires a numeric argument" >&2
                    exit 1
                fi
                API_PORT="$1"
                ;;
            --port-offset)
                shift
                if [ $# -eq 0 ] || ! [[ "$1" =~ ^[0-9]+$ ]]; then
                    echo "ERROR: --port-offset requires a numeric argument" >&2
                    exit 1
                fi
                port_offset="$1"
                ;;
            -h|--help) usage_expose; return 0 ;;
            *) echo "Unknown option: $1"; usage_expose; exit 1 ;;
        esac
        shift
    done

    ensure_minikube_running
    ensure_state_dir

    ########################################
    # Main expose logic
    #
    # Port-forward + loopback helpers live at the top of this script so that
    # expose --stop, cleanup, and minikube delete can reuse them.
    ########################################

    if [ "$STOP_MODE" = true ]; then
        echo "Stopping all port-forwards..."
        stop_all_forwards
        remove_all_loopback_aliases
        return 0
    fi

    if [ "$STATUS_MODE" = true ]; then
        echo "Port-forward status:"
        show_status
        return 0
    fi

    echo "Starting port-forwards..."
    EXPOSE_FAILURES=0
    # every local port is shifted by --port-offset so two profiles can be
    # exposed at once (Scylla binds to each node's own advertised IP instead)
    local es_port=$((9200 + port_offset)) kb_port=$((5601 + port_offset))
    local redis_port=$((6379 + port_offset)) s3_port=$((8333 + port_offset))
    API_PORT="${API_PORT:-$((8080 + port_offset))}"
    local has_registry=false
    if kctl get svc docker-registry -n "$THORIUM_NAMESPACE" &>/dev/null; then
        has_registry=true
    fi

    # every forward that runs, so the summary only lists what is actually reachable
    local api_up=false registry_up=false es_up=false kb_up=false redis_up=false s3_up=false
    SCYLLA_FORWARDS=""
    # --no-api forwards only the backing services so a locally-run API can use them
    if [ "$NO_API" = false ]; then
        if run_forward "${NAMESPACE_PREFIX:+$NAMESPACE_PREFIX-}thorium-api" "$THORIUM_NAMESPACE" thorium-api "$API_PORT:80"; then
            api_up=true
        fi
        # keep this cluster's thorctl login pointed at the port it is exposed on; a config for
        # any non-local Thorium is left alone
        local thorctl_config
        thorctl_config="$(thorctl_config_path)"
        if [ -f "$thorctl_config" ] && grep -q '^  api: http://localhost:' "$thorctl_config"; then
            set_thorctl_api "$thorctl_config" "$API_PORT"
        fi
        # the registry is optional (deploy --registry), so only forward it when deployed
        if [ "$has_registry" = true ] \
            && run_forward docker-registry "$THORIUM_NAMESPACE" docker-registry "$((5000 + port_offset)):5000"; then
            registry_up=true
        fi
    fi

    # forward the backing services for --dev or when only the infrastructure is wanted
    if [ "$DEV_MODE" = true ] || [ "$NO_API" = true ]; then
        # a service the chart doesn't manage (global.managed.<service>: false, or a deployment
        # converted from the pre-Helm scripts, whose databases stay in their old namespaces) has
        # nothing to forward, so each one is only forwarded when its service exists in the
        # selected namespaces
        if kctl get svc elastic-es-http -n "$ELASTIC_NAMESPACE" &>/dev/null \
            && run_forward "${NAMESPACE_PREFIX:+$NAMESPACE_PREFIX-}elastic" "$ELASTIC_NAMESPACE" elastic-es-http "$es_port:9200"; then
            es_up=true
        fi
        # Kibana is optional (deploy --no-kibana)
        if kctl get svc elastic-kb-http -n "$ELASTIC_NAMESPACE" &>/dev/null \
            && run_forward "${NAMESPACE_PREFIX:+$NAMESPACE_PREFIX-}kibana" "$ELASTIC_NAMESPACE" elastic-kb-http "$kb_port:5601"; then
            kb_up=true
        fi
        if kctl get svc redis -n "$REDIS_NAMESPACE" &>/dev/null \
            && run_forward "${NAMESPACE_PREFIX:+$NAMESPACE_PREFIX-}redis" "$REDIS_NAMESPACE" redis "$redis_port:6379"; then
            redis_up=true
        fi
        if kctl get svc seaweedfs -n "$SEAWEEDFS_NAMESPACE" &>/dev/null \
            && run_forward "${NAMESPACE_PREFIX:+$NAMESPACE_PREFIX-}seaweedfs" "$SEAWEEDFS_NAMESPACE" seaweedfs "$s3_port:8333"; then
            s3_up=true
        fi
        # Scylla needs per-node loopback-aliased forwards (see forward_scylla_dev)
        forward_scylla_dev
    fi

    echo ""
    echo "Port-forward status:"
    show_status
    echo ""
    [ "$api_up" = false ] || echo "Thorium API available at http://localhost:$API_PORT"
    [ "$registry_up" = false ] || echo "Registry at http://localhost:$((5000 + port_offset))"
    [ "$es_up" = false ] || echo "Elasticsearch at https://localhost:$es_port"
    [ "$kb_up" = false ] || echo "Kibana at https://localhost:$kb_port"
    [ "$redis_up" = false ] || echo "Redis at localhost:$redis_port"
    [ "$s3_up" = false ] || echo "SeaweedFS S3 at http://localhost:$s3_port"
    if [ -n "$SCYLLA_FORWARDS" ]; then
        local scy_svc scy_ip
        while read -r scy_svc scy_ip; do
            [ -n "$scy_svc" ] || continue
            echo "Scylla CQL ($scy_svc) at ${scy_ip}:${SCYLLA_CQL_PORT}"
        done <<< "$SCYLLA_FORWARDS"
        echo "  (Scylla is bound to its advertised cluster IP via a loopback alias;"
        echo "   point scylla.nodes at the address above, or use 'minithor get-config --local')"
    fi
    echo ""
    echo "Logs: $EXPOSE_LOG_DIR/"
    echo "Run 'minithor expose --status' to check, 'minithor expose --stop' to stop all"
    if [ "$EXPOSE_FAILURES" -gt 0 ]; then
        echo "WARNING: $EXPOSE_FAILURES port-forward(s) failed to start (see above)" >&2
        return 1
    fi
}

########################################
# Subcommand: cleanup
########################################

# Wait for Thorium's namespaces to finish terminating, force-clearing only those of them
# that get stuck (other users of the cluster are left alone)
#
#   wait_for_thorium_ns_gone <timeout seconds>
wait_for_thorium_ns_gone() {
    local timeout=$1 elapsed=0 ns remaining
    while true; do
        remaining=""
        for ns in "${THORIUM_NAMESPACES[@]}"; do
            kctl get ns "$ns" &>/dev/null && remaining+=" $ns"
        done
        [ -z "$remaining" ] && return 0
        if [ "$elapsed" -ge "$timeout" ]; then
            echo "WARNING: namespaces still terminating after ${timeout}s:${remaining}; force-clearing them" >&2
            for ns in $remaining; do
                force_delete_ns "$ns" || true
            done
            return 1
        fi
        sleep 5
        elapsed=$((elapsed + 5))
    done
}

cmd_cleanup() {
    local confirm=false operators=false cleanup_timeout=300
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help)   usage_cleanup; return 0 ;;
            --confirm)   confirm=true ;;
            --operators) operators=true ;;
            --timeout)   need_value "$1" $#; need_number "$1" "$2"; cleanup_timeout="$2"; shift ;;
            *) echo "Unknown option: $1"; usage_cleanup; exit 1 ;;
        esac
        shift
    done
    if [ "$confirm" = false ]; then
        echo "ERROR: --confirm flag is required to remove Thorium ($THORIUM_NAMESPACE) and its data." >&2
        echo "" >&2
        usage_cleanup >&2
        return 1
    fi
    ensure_minikube_running
    ensure_state_dir
    ensure_helm
    FAILURES=0

    log "Stopping port-forwards into Thorium's namespaces"
    stop_thorium_forwards || true

    log "Removing the ThoriumCluster"
    # delete it while the operator still runs so it can tear down the Thorium components
    if ! kctl delete thoriumclusters.sandia.gov --all -n "$THORIUM_NAMESPACE" --ignore-not-found \
        --timeout="${cleanup_timeout}s"; then
        echo "  The operator did not finish cleanup in time; removing its finalizer"
        clear_finalizers_and_delete thoriumclusters.sandia.gov thoriumclusters.sandia.gov "$THORIUM_NAMESPACE"
    fi

    log "Removing the thorium release from $THORIUM_NAMESPACE"
    local release_found=false
    if helm_cmd status "$THORIUM_RELEASE" -n "$THORIUM_NAMESPACE" &>/dev/null; then
        release_found=true
        run_step helm_cmd uninstall "$THORIUM_RELEASE" -n "$THORIUM_NAMESPACE" --wait \
            --timeout "${cleanup_timeout}s"
    fi

    log "Deleting Thorium's namespaces (PVCs and credentials)"
    local ns
    for ns in "${THORIUM_NAMESPACES[@]}"; do
        run_step kctl delete ns "$ns" --ignore-not-found --wait=false
    done
    # a cluster runs one Thorium deployment, so every namespace its scaler created for a group
    # (and the job data in it) belongs to the deployment being removed. The scaler's namespaces
    # carry no namespace prefix, so they are only deleted when the selected release existed;
    # otherwise a wrong or missing --namespace-prefix would delete another deployment's jobs.
    if [ "$release_found" = true ]; then
        log "Deleting the group namespaces the k8s scaler created"
        run_step kctl delete ns -l app.kubernetes.io/managed-by=thorium-scaler --ignore-not-found \
            --wait=false
    else
        echo "No thorium release in $THORIUM_NAMESPACE, so the k8s scaler's group namespaces are left alone"
        echo "  (pass the deployment's --namespace-prefix to remove them)"
    fi
    wait_for_thorium_ns_gone "$cleanup_timeout" || true

    if [ "$operators" = true ]; then
        log "Removing cluster-wide operators"
        if helm_cmd status infra-operators -n "$OPERATORS_NAMESPACE" &>/dev/null; then
            run_step helm_cmd uninstall infra-operators -n "$OPERATORS_NAMESPACE" --wait \
                --timeout "${cleanup_timeout}s"
            # helm leaves CRDs from a chart's crds/ directory installed, and the ECK CRDs
            # (labelled with the release) carry helm.sh/resource-policy: keep
            local crd
            for crd in $( { kctl get crd -o name 2>/dev/null \
                | grep -E '\.scylla\.scylladb\.com$|^customresourcedefinition\.apiextensions\.k8s\.io/kubegres\.kubegres\.reactive-tech\.io$|^customresourcedefinition\.apiextensions\.k8s\.io/thoriumclusters\.sandia\.gov$'
                kctl get crd -l app.kubernetes.io/instance=infra-operators -o name 2>/dev/null; } | sort -u); do
                run_step kctl delete "$crd" --ignore-not-found
            done
            run_step kctl delete ns "$OPERATORS_NAMESPACE" --ignore-not-found --wait=false
        else
            echo "The operators were not installed by minithor (no infra-operators release); leaving them"
        fi
    fi

    log "Cleanup complete"
    echo "Thorium ($THORIUM_NAMESPACE) removed. The minikube cluster is preserved."
    if [ "$FAILURES" -gt 0 ]; then
        echo "WARNING: $FAILURES step(s) failed (see above)" >&2
        return 1
    fi
}

# the pre-Helm minithor's MINITHOR_INSTANCE, which would otherwise be ignored silently and leave
# every command on the unprefixed namespaces
if [ -n "${MINITHOR_INSTANCE:-}" ]; then
    echo "ERROR: MINITHOR_INSTANCE was replaced by MINITHOR_NAMESPACE_PREFIX (or --namespace-prefix), which" >&2
    echo "  names the same namespaces; unset MINITHOR_INSTANCE. A deployment made by the pre-Helm minithor" >&2
    echo "  must be converted before this minithor manages it; see \"Converting a Pre-Helm Deployment\" in" >&2
    echo "  the Thorium deployment docs" >&2
    exit 1
fi

# --namespace-prefix and --profile may appear anywhere on the command line (before or after
# the subcommand), so pull them out before dispatching
args=()
while [ $# -gt 0 ]; do
    case "$1" in
        --namespace-prefix)
            if [ $# -lt 2 ]; then
                echo "ERROR: --namespace-prefix requires a prefix" >&2
                exit 1
            fi
            set_namespace_prefix "$2"
            shift 2
            ;;
        --namespace-prefix=*)
            set_namespace_prefix "${1#--namespace-prefix=}"
            shift
            ;;
        --profile)
            if [ $# -lt 2 ]; then
                echo "ERROR: --profile requires a name" >&2
                exit 1
            fi
            set_profile "$2"
            shift 2
            ;;
        --profile=*)
            set_profile "${1#--profile=}"
            shift
            ;;
        # the pre-Helm minithor's instance option, whose namespaces --namespace-prefix now names
        --instance|--instance=*)
            echo "ERROR: --instance was replaced by --namespace-prefix, which names the same namespaces" >&2
            echo "  (<prefix>-thorium, <prefix>-redis, ...). A deployment made by the pre-Helm minithor" >&2
            echo "  must be converted before this minithor manages it; see \"Existing minithor deployments\"" >&2
            echo "  in minithor/README.md and \"Converting a Pre-Helm Deployment\" in the Thorium deployment docs" >&2
            exit 1
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done
set -- ${args[@]+"${args[@]}"}

if [ $# -eq 0 ]; then
    usage
    exit 1
fi

command="$1"
shift

case "$command" in
    minikube)   cmd_minikube "$@" ;;
    start)      cmd_start "$@" ;;
    deploy)     cmd_deploy "$@" ;;
    credentials) cmd_credentials "$@" ;;
    get-config) cmd_get_config "$@" ;;
    expose)     cmd_expose "$@" ;;
    stop)       cmd_stop "$@" ;;
    cleanup)    cmd_cleanup "$@" ;;
    -h|--help)  usage; exit 0 ;;
    *)
        echo "Unknown command: $command" >&2
        echo "" >&2
        usage >&2
        exit 1
        ;;
esac
