    ########################################
    # Kubegres + Quickwit
    ########################################
    CURRENT_SECTION="Kubegres + Quickwit"

    log "Deploying Kubegres"
    kctl apply -f https://raw.githubusercontent.com/reactive-tech/kubegres/v1.19/kubegres.yaml
    kctl wait --for condition=established \
        crd/kubegres.kubegres.reactive-tech.io --timeout="${deploy_timeout}s"
    wait_for_rollout deployment.apps/kubegres-controller-manager kubegres-system "$deploy_timeout"

    log "Deploying Quickwit Postgres"
    kctl apply -f - <<EOF
---
apiVersion: v1
kind: Namespace
metadata:
  name: $QUICKWIT_NAMESPACE
---
apiVersion: v1
kind: Secret
metadata:
  name: postgres-cluster-auth
  namespace: $QUICKWIT_NAMESPACE
type: Opaque
stringData:
  superUserPassword: $PG_PASS
  replicationUserPassword: $PG_PASS
---
apiVersion: kubegres.reactive-tech.io/v1
kind: Kubegres
metadata:
  name: postgres
  namespace: $QUICKWIT_NAMESPACE
spec:
  replicas: 1
  image: docker.io/postgres:17
  database:
    storageClassName: csi-hostpath-sc
    size: 32Gi
  resources:
    requests:
      memory: "0"
      cpu: "0"
    limits:
      memory: "2Gi"
      cpu: "1"
  env:
    - name: POSTGRES_PASSWORD
      valueFrom:
        secretKeyRef:
          name: postgres-cluster-auth
          key: superUserPassword
    - name: POSTGRES_REPLICATION_PASSWORD
      valueFrom:
        secretKeyRef:
          name: postgres-cluster-auth
          key: replicationUserPassword
EOF
    wait_for_resource statefulset postgres-1 "$QUICKWIT_NAMESPACE" "$deploy_timeout"
    wait_for_pods_ready "$QUICKWIT_NAMESPACE" app=postgres "$deploy_timeout"

    log "Creating Quickwit metastore database"
    # Kubegres requires password auth even on the local socket, so the saved
    # password is sent over stdin into PGPASSWORD inside the pod (never on a host
    # command line). POSTGRES_PASSWORD only applies when the data directory is
    # first created, so this also confirms the saved credential still matches.
    pg_exec() {
        kctl -n "$QUICKWIT_NAMESPACE" exec -i pod/postgres-1-0 -- \
            sh -c 'IFS= read -r pw; export PGPASSWORD="$pw"; '"$1" <<< "$PG_PASS"
    }
    local pg_ready=false
    for attempt in $(seq 1 30); do
        if pg_exec 'psql -U postgres -c "SELECT 1"' &>/dev/null; then
            pg_ready=true
            break
        fi
        echo "Waiting for Postgres to accept connections (attempt $attempt/30)..."
        sleep 5
    done
    if [ "$pg_ready" = false ]; then
        echo "ERROR: Postgres not accepting logins with the saved password after 150s" >&2
        echo "  If Postgres is running, its password no longer matches the minithor-credentials secret;" >&2
        echo "  run 'minithor cleanup --confirm' and deploy again." >&2
        exit 1
    fi
    pg_exec 'psql -U postgres -tAc "SELECT 1 FROM pg_database WHERE datname='"'quickwit-metastore'"'" | grep -q 1 || createdb -U postgres quickwit-metastore'

    log "Deploying Quickwit"
    QUICKWIT_VALUES=$(mktemp)
    cat > "$QUICKWIT_VALUES" <<EOF
image:
  repository: docker.io/quickwit/quickwit
  pullPolicy: IfNotPresent

config:
  default_index_root_uri: s3://quickwit/quickwit-indexes
  metastore_uri: postgres://postgres:$PG_PASS@${POSTGRES_CLUSTER_HOST}:5432/quickwit-metastore
  storage:
    s3:
      region: us-east-1
      endpoint: http://${SEAWEEDFS_CLUSTER_HOST}:8333
      force_path_style_access: true
      access_key_id: "$S3_AK"
      secret_access_key: "$S3_SK"

metastore:
  replicaCount: 1

searcher:
  replicaCount: 1
EOF
    helm upgrade --install quickwit quickwit/quickwit --version "$QUICKWIT_CHART_VERSION" \
        -n "$QUICKWIT_NAMESPACE" -f "$QUICKWIT_VALUES"
    rm -f "$QUICKWIT_VALUES"

    ########################################
    # Wait for all rollouts
    ########################################
    CURRENT_SECTION="Wait for all rollouts"
    log "Waiting for all services"
    wait_for_pods_ready "$SCYLLA_NAMESPACE" scylla/cluster=scylla "$deploy_timeout"
    wait_for_rollout statefulset/seaweedfs "$SEAWEEDFS_NAMESPACE" "$deploy_timeout"
    wait_for_rollout statefulset/redis "$REDIS_NAMESPACE" "$deploy_timeout"
    wait_for_pods_ready "$QUICKWIT_NAMESPACE" app=postgres "$deploy_timeout"
    wait_for_rollout statefulset/quickwit-searcher "$QUICKWIT_NAMESPACE" "$deploy_timeout"
    wait_for_rollout statefulset/quickwit-indexer "$QUICKWIT_NAMESPACE" "$deploy_timeout"
    wait_for_resource statefulset elastic-es-default "$ELASTIC_NAMESPACE" "$deploy_timeout"
    wait_for_pods_ready "$ELASTIC_NAMESPACE" elasticsearch.k8s.elastic.co/cluster-name=elastic "$deploy_timeout"

    ########################################
    # Post-deploy configuration
    ########################################
    CURRENT_SECTION="Post-deploy configuration"

    ### Scylla DB init
    log "Configuring Scylla"
    # Runs inside the Scylla pod. Credentials go into temporary cqlshrc files so
    # they never appear on a cqlsh command line, and any failure aborts the exec
    # (and so the deploy) instead of being silently ignored.
    kctl -n "$SCYLLA_NAMESPACE" exec -i --tty=false pod/scylla-us-east-1-us-east-1a-0 -c scylla -- /bin/bash <<EOF
set -euo pipefail
HOST='scylla-us-east-1-us-east-1a-0.${SCYLLA_NAMESPACE}.svc.cluster.local'
RC_DIR=\$(mktemp -d)
trap 'rm -rf "\$RC_DIR"' EXIT
printf '[authentication]\nusername = thorium\npassword = %s\n' '$SCYLLA_PASS' > "\$RC_DIR/thorium"
printf '[authentication]\nusername = cassandra\npassword = cassandra\n' > "\$RC_DIR/cassandra"

# Find working credentials: thorium (redeploy) or the default cassandra (first
# run). CQL can lag behind pod readiness, so retry before giving up.
AUTH=""
for attempt in \$(seq 1 30); do
    for candidate in thorium cassandra; do
        if cqlsh "\$HOST" --cqlshrc="\$RC_DIR/\$candidate" -e "DESCRIBE CLUSTER" >/dev/null 2>&1; then
            AUTH=\$candidate
            break 2
        fi
    done
    echo "Waiting for Scylla to accept logins (attempt \$attempt/30)..."
    sleep 5
done
if [ -z "\$AUTH" ]; then
    echo "ERROR: neither the saved thorium credentials nor the default cassandra login work" >&2
    exit 1
fi
cql() { cqlsh "\$HOST" --cqlshrc="\$RC_DIR/\$AUTH" -e "\$1"; }

cql "CREATE ROLE IF NOT EXISTS admin WITH SUPERUSER = true"
cql "CREATE ROLE IF NOT EXISTS thorium WITH PASSWORD = '$SCYLLA_PASS' AND LOGIN = true AND SUPERUSER = true"
# keep an existing role's password in step with the saved credential
cql "ALTER ROLE thorium WITH PASSWORD = '$SCYLLA_PASS'"
cql "CREATE KEYSPACE IF NOT EXISTS thorium WITH REPLICATION = {'class': 'SimpleStrategy', 'replication_factor': 1}"
# grants may already be in place (or implied by superuser), so their errors are ignored
cql "GRANT admin TO thorium" 2>/dev/null || true
cql "GRANT ALL ON KEYSPACE thorium TO thorium" 2>/dev/null || true
cql "GRANT CREATE ON ALL KEYSPACES TO thorium" 2>/dev/null || true

# Drop the default cassandra role on first run only
if [ "\$AUTH" = "cassandra" ]; then
    cqlsh "\$HOST" --cqlshrc="\$RC_DIR/thorium" -e "DROP ROLE IF EXISTS cassandra"
fi
EOF

    ### Elastic index/role/user
    log "Configuring Elasticsearch"
    wait_for_resource secret elastic-es-elastic-user "$ELASTIC_NAMESPACE" "$deploy_timeout"
    ESPASS=$(kctl get secret -n "$ELASTIC_NAMESPACE" elastic-es-elastic-user -o go-template='{{index .data "elastic" | base64decode}}')
    kctl -n "$ELASTIC_NAMESPACE" exec -i --tty=false pod/elastic-es-default-0 -- /bin/bash <<ESEOF
# Create index (ignore 400 = already exists)
HTTP_CODE=\$(curl -s -o /dev/null -w '%{http_code}' -k -X PUT -u elastic:$ESPASS "https://localhost:9200/thorium")
if [ "\$HTTP_CODE" = "200" ]; then
    echo "Elasticsearch index 'thorium' created"
elif [ "\$HTTP_CODE" = "400" ]; then
    echo "Elasticsearch index 'thorium' already exists, skipping"
else
    echo "WARNING: Unexpected HTTP \$HTTP_CODE creating Elasticsearch index"
fi

curl -k -X POST -u elastic:$ESPASS "https://localhost:9200/_security/role/thorium?pretty" -H 'Content-Type: application/json' -d'
{
  "indices": [
    {
      "names": ["thorium*"],
      "privileges": ["all"]
    }
  ]
}
'
curl -k -X POST -u elastic:$ESPASS "https://localhost:9200/_security/user/thorium?pretty" -H 'Content-Type: application/json' -d'
{
  "password" : "$ES_PASS",
  "roles" : ["thorium"],
  "full_name" : "Thorium",
  "email" : "thorium@localhost"
}
'
ESEOF

    ### SeaweedFS quickwit bucket
    # Thorium's own buckets are created by the operator; only Quickwit's is made
    # here. `s3.bucket.create` fails if the bucket exists, so check the listing
    # first to keep redeploys idempotent, then confirm the bucket is present.
    # The app=seaweedfs-admin label is what the NetworkPolicy lets through to
    # the master/filer ports.
    log "Creating Quickwit S3 bucket"
    kctl delete job create-quickwit-bucket -n "$SEAWEEDFS_NAMESPACE" --ignore-not-found
    kctl apply -f - <<EOF
apiVersion: batch/v1
kind: Job
metadata:
  name: create-quickwit-bucket
  namespace: $SEAWEEDFS_NAMESPACE
spec:
  backoffLimit: 4
  template:
    metadata:
      labels:
        app: seaweedfs-admin
    spec:
      restartPolicy: Never
      containers:
      - name: weed-shell
        image: $SEAWEEDFS_IMAGE
        command:
        - /bin/sh
        - -c
        - |
          set -e
          shell() { echo "\$1" | weed shell -master=${SEAWEEDFS_CLUSTER_HOST}:9333 -filer=${SEAWEEDFS_CLUSTER_HOST}:8888; }
          # match the exact bucket name (the first field of each listing line)
          has_bucket() { shell "s3.bucket.list" | awk '\$1 == "quickwit" { found = 1 } END { exit !found }'; }
          if has_bucket; then
            echo "Bucket quickwit already exists"
          else
            shell "s3.bucket.create -name quickwit"
          fi
          has_bucket
EOF
    wait_for_job "$SEAWEEDFS_NAMESPACE" create-quickwit-bucket "$deploy_timeout"

    ########################################
    # Thorium
    ########################################
    CURRENT_SECTION="Thorium deployment"

    log "Deploying Thorium"
    kctl create ns "$THORIUM_NAMESPACE" --dry-run=client -o yaml | kctl apply -f -

    local banner_file="$banner_path"
    local banner_tmp=""
    if [ ! -f "$banner_file" ]; then
        banner_tmp=$(mktemp)
        echo "Welcome to Thorium. <Please place your banner here>" > "$banner_tmp"
        banner_file="$banner_tmp"
    fi
    kctl create cm banner --from-file="banner.txt=$banner_file" -n "$THORIUM_NAMESPACE" \
        --dry-run=client -o yaml | kctl apply -f -
    [ -n "$banner_tmp" ] && rm -f "$banner_tmp"
    # each instance has its own "thorium" service account, which its scaler (and
    # the operator, when deployed here) runs as; the ClusterRole is shared
    kctl apply -f - <<EOF
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: thorium
  namespace: $THORIUM_NAMESPACE
imagePullSecrets:
  - name: registry-token
automountServiceAccountToken: true
---
apiVersion: v1
kind: Secret
metadata:
  name: thorium-account-token
  namespace: $THORIUM_NAMESPACE
  annotations:
    kubernetes.io/service-account.name: thorium
type: kubernetes.io/service-account-token
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: thorium-operator
rules:
- apiGroups: ["apiextensions.k8s.io"]
  resources: ["customresourcedefinitions"]
  verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
- apiGroups: ["sandia.gov"]
  resources: ["*"]
  verbs: ["*"]
- apiGroups: ["apps"]
  resources: ["deployments"]
  verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
- apiGroups: ["networking.k8s.io"]
  resources: ["networkpolicies"]
  verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
- apiGroups: ["events.k8s.io"]
  resources: ["events"]
  verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
- apiGroups: [""]
  resources: ["pods", "services", "secrets", "configmaps", "nodes", "namespaces", "events"]
  verbs: ["get", "list", "watch", "create", "update", "patch", "delete"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: $THORIUM_BINDING
subjects:
- kind: ServiceAccount
  name: thorium
  namespace: $THORIUM_NAMESPACE
roleRef:
  kind: ClusterRole
  name: thorium-operator
  apiGroup: "rbac.authorization.k8s.io"
EOF

    local pull_secrets=""
    if [ -f "$docker_config" ]; then
        kctl create secret docker-registry registry-token -n "$THORIUM_NAMESPACE" \
            --from-file=".dockerconfigjson=$docker_config" \
            --dry-run=client -o yaml | kctl apply -f -
        pull_secrets='
      imagePullSecrets:
      - name: registry-token'
    fi

    # The operator manages every ThoriumCluster in the cluster, so instances
    # share one: reuse an operator another instance already runs (identified by
    # its app=operator label and "thorium" service account) instead of starting
    # a second one that would fight it
    local operator_ns
    operator_ns=$(kctl get deploy -A -l app=operator \
        -o jsonpath='{range .items[*]}{.metadata.namespace}{" "}{.spec.template.spec.serviceAccountName}{"\n"}{end}' 2>/dev/null \
        | awk -v ns="$THORIUM_NAMESPACE" '$2 == "thorium" && $1 != ns { print $1; exit }') || true
    if [ -n "$operator_ns" ]; then
        echo "Using the Thorium operator already running in namespace $operator_ns"
    else
        operator_ns="$THORIUM_NAMESPACE"
        kctl apply -f - <<EOF
apiVersion: apps/v1
kind: Deployment
metadata:
  name: operator
  namespace: $THORIUM_NAMESPACE
  labels:
    app: operator
spec:
  replicas: 1
  selector:
    matchLabels:
      app: operator
  template:
    metadata:
      labels:
        app: operator
    spec:
      serviceAccountName: thorium
      automountServiceAccountToken: true
      containers:
        - name: operator
          image: ${THORIUM_REGISTRY}:${thorium_version}
          imagePullPolicy: Always
          resources:
            requests:
              memory: 0
              cpu: 0
            limits:
              memory: 1Gi
              cpu: 256m
          env:
            - name: "http_proxy"
            - name: "https_proxy"
            - name: "HTTP_PROXY"
            - name: "HTTPS_PROXY"${pull_secrets}
EOF
    fi

    kctl apply -f - <<EOF
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: thorium-default-ingress
  namespace: $THORIUM_NAMESPACE
  annotations:
    kubernetes.io/ingress.class: nginx
    nginx.ingress.kubernetes.io/ssl-redirect: "false"
    nginx.ingress.kubernetes.io/proxy-body-size: 100m
spec:
  ingressClassName: nginx
  rules:
    - host: $INGRESS_HOST
      http:
        paths:
          - path: "/"
            pathType: Prefix
            backend:
              service:
                name: thorium-api
                port:
                  number: 80
EOF

    wait_for_rollout deployment.apps/operator "$operator_ns" "$deploy_timeout"

    log "Waiting for operator to register ThoriumCluster CRD"
    wait_for_resource crd thoriumclusters.sandia.gov "" "$deploy_timeout"
    kctl wait --for condition=established \
        crd/thoriumclusters.sandia.gov --timeout="${deploy_timeout}s"

    ########################################
    # ThoriumCluster CRD
    ########################################
    CURRENT_SECTION="ThoriumCluster CRD"
    log "Creating ThoriumCluster resource"
    if [ -f "$cluster_config" ]; then
        # fill the credential placeholders (see thorium-cluster.yml.example) with
        # the credentials the backends were configured with
        local rendered_config
        rendered_config=$(mktemp)
        render_cluster_config "$cluster_config" "$rendered_config"
        kctl apply -f "$rendered_config" -n "$THORIUM_NAMESPACE"
        rm -f "$rendered_config"
    else
        echo "No cluster config found at $cluster_config, using built-in default" >&2
        local default_config
        default_config=$(mktemp)
        cat > "$default_config" <<DEFEOF
apiVersion: sandia.gov/v1
kind: ThoriumCluster
metadata:
  name: dev
  namespace: $THORIUM_NAMESPACE
spec:
  registry: "$THORIUM_REGISTRY"
  version: "$thorium_version"
  image_pull_policy: Always
  components:
    api:
      replicas: 1
      resources:
        cpu: 0
        memory: 0
    scaler:
      service_account: true
      resources:
        cpu: 0
        memory: 0
    search_streamer:
      resources:
        cpu: 0
        memory: 0
      cmd:
        - "/app/thorium-search-streamer"
      args:
        - "--config"
        - "/conf/thorium.yml"
        - "--keys"
        - "/keys/keys.yml"
    event_handler:
      resources:
        cpu: 0
        memory: 0
  config:
    thorium:
      secret_key: "$THORIUM_SECRET"
      tracing:
        external:
          Grpc:
            endpoint: "http://${QUICKWIT_INDEXER_HOST}:7281"
            level: "Info"
        local:
          level: "Info"
      cors:
        insecure: true
      files:
        bucket: "thorium-files"
        earliest: 1610596807
        partition_size: 3600
      repos:
        bucket: "thorium-repos"
        partition_size: 3600
      attachments:
        bucket: "thorium-attachments"
      results:
        bucket: "thorium-results"
        earliest: 1610596807
        partition_size: 3600
      ephemeral:
        bucket: "thorium-ephemeral"
      s3:
        access_key: "$S3_AK"
        secret_token: "$S3_SK"
        endpoint: "http://${SEAWEEDFS_CLUSTER_HOST}:8333"
        region: "us-east-1"
        use_path_style: true
      auth:
      scaler:
        crane:
          insecure: true
        k8s:
          clusters:
            kubernetes-admin@cluster.local:
              alias: "dev"
              nodes:
                - "minikube"
    redis:
      host: "${REDIS_CLUSTER_HOST}"
      port: 6379
      password: "$REDIS_PASS"
    scylla:
      nodes:
        - "${SCYLLA_CLUSTER_HOST}"
      replication: 1
      auth:
        username: "thorium"
        password: "$SCYLLA_PASS"
    elastic:
      node: "https://${ELASTIC_CLUSTER_HOST}:9200"
      username: "thorium"
      password: "$ES_PASS"
      results:
        repos: thorium_repo_results
        samples: thorium_sample_results
      tags:
        repos: thorium_repo_tags
        samples: thorium_sample_tags
DEFEOF
        kctl apply -f "$default_config" -n "$THORIUM_NAMESPACE"
        rm -f "$default_config"
    fi

    ########################################
    # Wait for Thorium components
    ########################################
    CURRENT_SECTION="Wait for Thorium components"

    log "Waiting for Thorium components to start"

    echo "Waiting for API deployment..."
    wait_for_resource deployment api "$THORIUM_NAMESPACE" "$deploy_timeout"
    wait_for_rollout deployment.apps/api "$THORIUM_NAMESPACE" "$deploy_timeout"

    echo "Waiting for scaler deployment..."
    wait_for_resource deployment scaler "$THORIUM_NAMESPACE" "$deploy_timeout"
    wait_for_rollout deployment.apps/scaler "$THORIUM_NAMESPACE" "$deploy_timeout"

    echo "Waiting for event-handler deployment..."
    wait_for_resource deployment event-handler "$THORIUM_NAMESPACE" "$deploy_timeout"
    wait_for_rollout deployment.apps/event-handler "$THORIUM_NAMESPACE" "$deploy_timeout"

    echo "Waiting for search-streamer deployment..."
    wait_for_resource deployment search-streamer "$THORIUM_NAMESPACE" "$deploy_timeout"
    wait_for_rollout deployment.apps/search-streamer "$THORIUM_NAMESPACE" "$deploy_timeout"

    log "All Thorium components are running"

    ########################################
    # Create test user
    ########################################
    CURRENT_SECTION="Create test user"
    log "Creating test admin user"
    local api_pod create_resp http_code body user_json
    api_pod=$(kctl get pod -n "$THORIUM_NAMESPACE" -l app=api -o jsonpath='{.items[0].metadata.name}')
    user_json=$(printf '{"username":"%s","password":"%s","email":"%s@localhost","role":"Admin","local":true,"skip_verification":true}' \
        "$(json_escape "$deploy_user")" "$(json_escape "$deploy_pass")" "$(json_escape "$deploy_user")")
    # The secret key (first line) and JSON body (the rest) go over stdin so
    # neither lands on a host command line
    create_resp=$(printf '%s\n%s\n' "$THORIUM_SECRET" "$user_json" \
        | kctl -n "$THORIUM_NAMESPACE" exec -i "pod/$api_pod" -- sh -c \
            'IFS= read -r key; curl -s -w "\n%{http_code}" -X POST http://localhost/api/users/ -H "Content-Type: application/json" -H "secret-key: $key" -d @-')
    http_code=$(echo "$create_resp" | tail -1)
    body=$(echo "$create_resp" | sed '$d')
    if [ "$http_code" = "200" ]; then
        echo "Admin user created successfully"
        echo "  Username: $deploy_user"
        echo "  Password: $deploy_pass"
    elif echo "$body" | grep -q "already exists"; then
        echo "Test admin user already exists, skipping"
    else
        echo "WARNING: Failed to create test user (HTTP $http_code): $body"
    fi

    ########################################
    # Install thorctl & import toolbox
    ########################################
    CURRENT_SECTION="Install thorctl & import toolbox"

    log "Installing thorctl"

    # A private forward on a port kubectl picks, so it never collides with (or
    # tears down) a forward started by `minithor expose`
    # PF_PID/PF_LOG are globals because the EXIT trap runs after this function
    local pf_port=""
    PF_LOG=$(mktemp)
    kctl -n "$THORIUM_NAMESPACE" port-forward svc/thorium-api :80 >"$PF_LOG" 2>&1 &
    PF_PID=$!
    trap 'pkill -P "$PF_PID" 2>/dev/null; kill "$PF_PID" 2>/dev/null; rm -f "$PF_LOG"; true' EXIT
    for attempt in $(seq 1 20); do
        pf_port=$(sed -n 's/^Forwarding from 127\.0\.0\.1:\([0-9]*\) .*/\1/p' "$PF_LOG" | head -1)
        [ -n "$pf_port" ] && break
        if ! kill -0 "$PF_PID" 2>/dev/null; then
            break
        fi
        sleep 1
    done
    if [ -z "$pf_port" ]; then
        echo "ERROR: port-forward to thorium-api failed: $(cat "$PF_LOG")" >&2
        exit 1
    fi
    wait_for_port_forward "$pf_port" 20

    THORCTL_URL="http://localhost:$pf_port"

    local thorctl_os thorctl_hw
    thorctl_os=$(uname -s | awk '{print tolower($0)}')
    thorctl_hw=$(uname -m | tr '_' '-')

    THORCTL_BIN="$bin_dir/thorctl"
    echo "Downloading thorctl to $THORCTL_BIN for $thorctl_os/$thorctl_hw..."
    sudo curl -sf "$THORCTL_URL/api/binaries/$thorctl_os/$thorctl_hw/thorctl" -o "$THORCTL_BIN"
    sudo chmod +x "$THORCTL_BIN"

    log "Logging into Thorium via thorctl"
    "$THORCTL_BIN" login "$THORCTL_URL" --user "$deploy_user" --password "$deploy_pass"

    log "Creating 'static' group and 'allow-all' network policy"
    # GNU base64 wraps long output, which would split the header value
    local basic_auth
    basic_auth=$(printf '%s' "$deploy_user:$deploy_pass" | base64 | tr -d '\n')
    # POST a JSON body as the admin user; the auth header (first stdin line) and
    # body (the rest) go over stdin so neither lands on a host command line.
    # Failures are tolerated because both objects may already exist.
    api_post_as_admin() {
        printf '%s\n%s\n' "$basic_auth" "$2" \
            | kctl -n "$THORIUM_NAMESPACE" exec -i "pod/$api_pod" -- sh -c \
                'IFS= read -r auth; curl -sf -X POST "http://localhost$1" -H "Authorization: Basic $auth" -H "Content-Type: application/json" -d @-' \
                sh "$1" || true
    }
    api_post_as_admin /api/groups/ '{"name":"static"}'
    api_post_as_admin /api/network-policies '{"name":"allow-all","groups":["static"],"ingress":[],"egress":null,"forced_policy":false,"default_policy":false}'
    echo

    log "Importing toolbox"
    curl -o "$toolbox_path" https://raw.githubusercontent.com/cisagov/thorium/refs/heads/main/tools/toolbox.json
    echo "Toolbox downloaded to $toolbox_path"
    "$THORCTL_BIN" toolbox import "$toolbox_path" --overwrite

    ########################################
    # Optional: Container Registry
    ########################################
    if [ "$deploy_registry" = true ]; then
        CURRENT_SECTION="Container Registry"
        log "Deploying Container Registry"

        local reg_auth_env=""
        local reg_auth_vol=""
        local reg_auth_mount=""
        local reg_auth_config=""
        local REGISTRY_PASS=""

        if [ -n "$registry_user" ]; then
            REGISTRY_PASS=$(generate_password)
            echo "Configuring registry basic auth for user '$registry_user'..."

            # The credentials go to htpasswd over stdin so they aren't recorded in
            # the pod spec, and the secret manifest is piped for the same reason
            local htpasswd_entry
            htpasswd_entry=$(printf '%s\n%s\n' "$registry_user" "$REGISTRY_PASS" \
                | kctl run htpasswd-gen --rm -i --restart=Never -n thorium \
                    --image=docker.io/httpd:2-alpine \
                    -- sh -c 'IFS= read -r u; IFS= read -r p; htpasswd -Bbn "$u" "$p"' 2>/dev/null \
                | grep -v '^pod ' | tr -d '\r' | sed '/^$/d')
            if [ -z "$htpasswd_entry" ]; then
                echo "ERROR: failed to generate the registry htpasswd entry" >&2
                exit 1
            fi

            kctl apply -f - <<SECEOF
apiVersion: v1
kind: Secret
metadata:
  name: registry-auth
  namespace: thorium
type: Opaque
stringData:
  htpasswd: "$htpasswd_entry"
  username: "$(json_escape "$registry_user")"
  password: "$REGISTRY_PASS"
SECEOF

            reg_auth_config='
    auth:
      htpasswd:
        realm: "Thorium Registry"
        path: /auth/htpasswd'
            reg_auth_env='
            - name: REGISTRY_AUTH
              value: "htpasswd"
            - name: REGISTRY_AUTH_HTPASSWD_REALM
              value: "Thorium Registry"
            - name: REGISTRY_AUTH_HTPASSWD_PATH
              value: "/auth/htpasswd"'
            reg_auth_vol='
        - name: auth
          secret:
            secretName: registry-auth
            items:
              - key: htpasswd
                path: htpasswd'
            reg_auth_mount='
            - name: auth
              mountPath: /auth
              readOnly: true'
        fi

        kctl apply -f - <<REGEOF
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: registry-config
  namespace: thorium
data:
  config.yml: |
    version: 0.1
    log:
      fields:
        service: registry
    storage:
      filesystem:
        rootdirectory: /var/lib/registry
      delete:
        enabled: true
    http:
      addr: :5000
      headers:
        X-Content-Type-Options: [nosniff]${reg_auth_config}
    health:
      storagedriver:
        enabled: true
        interval: 10s
        threshold: 3
---
apiVersion: v1
kind: Service
metadata:
  name: registry
  namespace: thorium
  labels:
    app: registry
spec:
  type: ClusterIP
  selector:
    app: registry
  ports:
  - name: registry
    port: 5000
    targetPort: 5000
    protocol: TCP
---
apiVersion: apps/v1
kind: StatefulSet
metadata:
  name: registry
  namespace: thorium
  labels:
    app: registry
spec:
  serviceName: registry
  replicas: 1
  selector:
    matchLabels:
      app: registry
  template:
    metadata:
      labels:
        app: registry
    spec:
      containers:
        - name: registry
          image: docker.io/registry:2
          imagePullPolicy: IfNotPresent
          ports:
            - containerPort: 5000
              name: registry
          env:
            - name: REGISTRY_STORAGE_FILESYSTEM_ROOTDIRECTORY
              value: "/var/lib/registry"${reg_auth_env}
          resources:
            requests:
              cpu: 0
              memory: 0
            limits:
              cpu: 500m
              memory: 512Mi
          volumeMounts:
            - name: registry-data
              mountPath: /var/lib/registry
            - name: config
              mountPath: /etc/docker/registry
              readOnly: true${reg_auth_mount}
          livenessProbe:
            httpGet:
              path: /
              port: 5000
            initialDelaySeconds: 5
            periodSeconds: 10
          readinessProbe:
            httpGet:
              path: /
              port: 5000
            initialDelaySeconds: 3
            periodSeconds: 5
      volumes:
        - name: config
          configMap:
            name: registry-config${reg_auth_vol}
  volumeClaimTemplates:
    - metadata:
        name: registry-data
        labels:
          app: registry
      spec:
        storageClassName: csi-hostpath-sc
        accessModes:
          - ReadWriteOnce
        resources:
          requests:
            storage: 20Gi
REGEOF

        wait_for_rollout statefulset/registry thorium "$deploy_timeout"

        # The node must resolve REGISTRY_HOST to pull images from the registry.
        ensure_registry_node_dns

        log "Verifying registry"
        local catalog_response
        catalog_response=$(kctl -n thorium exec "pod/registry-0" -- \
            wget -qO- "http://localhost:5000/v2/_catalog" 2>/dev/null) || true
        if echo "$catalog_response" | grep -q "repositories"; then
            echo "Registry is healthy: $catalog_response"
        else
            echo "Registry is up (auth may be required for catalog access)"
        fi

        if [ -n "$registry_user" ]; then
            echo ""
            echo "Registry auth credentials:"
            echo "  Username: $registry_user"
            echo "  Password: $REGISTRY_PASS"
        fi

        echo ""
        echo "Registry:"
        echo "  Internal (Thorium): registry.thorium.svc.cluster.local:5000"
        echo "  External (host):    localhost:5000  (requires 'minithor expose')"
    fi

    log "Deployment complete!"
    echo ""
    echo "Access Thorium:"
    echo "  1. Run 'minithor${INSTANCE:+ --instance $INSTANCE} expose' in a separate terminal"
    echo "  2. Open http://localhost:8080 in your browser (with --port-offset <n>, 8080 + <n>)"
    echo "  3. Login with username '$deploy_user' and password '$deploy_pass'"
    echo "  4. Service passwords were randomly generated — run 'minithor${INSTANCE:+ --instance $INSTANCE} get-config' to view"
}

########################################
# Subcommand: get-config
########################################

# Rewrite an extracted thorium.yml so a host process can reach the cluster's
# databases through the ports created by `minithor expose --dev`.
#
#   translate_config_local <file> [port_offset]
translate_config_local() {
    local file=$1 offset=${2:-0}

    # Swap in-cluster service DNS names for localhost and relax the elastic cert
    # check (the cluster cert's SAN doesn't cover localhost). Use temp-file + mv
    # rather than `sed -i` so this works with both GNU and BSD/macOS sed.
    # The local ports follow `expose --port-offset`; redis's port is the only
    # "port: 6379" line in the config.
    sed \
        -e "s#${ELASTIC_CLUSTER_HOST}:9200#localhost:$((9200 + offset))#g" \
        -e "s#${REDIS_CLUSTER_HOST}#localhost#g" \
        -e "s#^\\( *port: \\)6379\$#\\1$((6379 + offset))#" \
        -e "s#${SEAWEEDFS_CLUSTER_HOST}:8333#localhost:$((8333 + offset))#g" \
        -e 's/^\( *insecure_certificates: \)false/\1true/' \
        -e "s/^\(  port: \)80\$/\1${LOCAL_API_PORT}/" \
        "$file" > "${file}.tmp" && mv "${file}.tmp" "$file"

    # Point scylla.nodes at each node's advertised cluster IP (the address the
    # expose forwards are bound to via loopback aliases). The raw config lists
    # the aggregate client service once; replace that line with the real nodes.
    local scylla_lines
    scylla_lines=$(discover_scylla_nodes | awk -v p="$SCYLLA_CQL_PORT" '{printf "  - %s:%s\n", $2, p}')
    if [ -z "$scylla_lines" ]; then
        echo "ERROR: could not discover any Scylla nodes; is the cluster running?" >&2
        return 1
    fi
    # $(...) strips the trailing newline from scylla_lines, so re-add one with \n
    # (for multi-node repl the inner newlines are preserved and only the final
    # one was stripped, so printing one back yields exactly the right output).
    awk -v repl="$scylla_lines" -v host="  - $SCYLLA_CLUSTER_HOST" '
        $0 == host { printf "%s\n", repl; next }
        { print }
    ' "$file" > "${file}.tmp" && mv "${file}.tmp" "$file"

    # Null out external tracing (the in-cluster collector is not reachable from
    # the host and only produces connection noise).
    awk '
        /^    external:$/ { print "    external: null"; skip=1; next }
        skip && /^    local:$/ { skip=0 }
        skip { next }
        { print }
    ' "$file" > "${file}.tmp" && mv "${file}.tmp" "$file"
}

cmd_get_config() {
    local local_mode=false port_offset=0
    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) usage_get_config; return 0 ;;
            --local)   local_mode=true ;;
            --port-offset)
                shift
                if [ $# -eq 0 ] || ! [[ "$1" =~ ^[0-9]+$ ]]; then
                    echo "ERROR: --port-offset requires a numeric argument" >&2; exit 1
                fi
                port_offset="$1"
                ;;
            *) echo "Unknown option: $1"; usage_get_config; exit 1 ;;
        esac
        shift
    done

    ensure_minikube_running
    # every file written here holds backend credentials, so keep them owner-only
    umask 077

    local output="${HOME}/${CONFIG_NAME}.yml"
    [ "$local_mode" = true ] && output="${HOME}/${CONFIG_NAME}.local.yml"

    echo "Extracting Thorium config from cluster secret..."
    # The config holds every backend credential: build it in a private temp file
    # next to the destination and only replace the destination once it succeeds
    local tmp_output
    tmp_output=$(mktemp "${output}.XXXXXX")
    if ! kctl get secret thorium -n "$THORIUM_NAMESPACE" \
        -o go-template='{{index .data "thorium.yml" | base64decode}}' \
        > "$tmp_output"; then
        rm -f "$tmp_output"
        echo "ERROR: failed to read the thorium secret; is Thorium deployed?" >&2
        return 1
    fi

    if [ "$local_mode" = true ]; then
        echo "Translating config for local access via exposed ports..."
        if ! translate_config_local "$tmp_output" "$port_offset"; then
            rm -f "$tmp_output"
            echo "ERROR: failed to translate config for local use" >&2
            return 1
        fi
    fi
    mv "$tmp_output" "$output"

    if [ "$local_mode" = true ]; then
        echo "Local config written to $output"
        echo "Run 'minithor expose --dev' (if you haven't) then start the API with:"
        echo "  thorium-api --config $output     (listens on port ${LOCAL_API_PORT})"
    else
        echo "Config written to $output"
    fi
}

########################################
# Subcommand: expose
########################################

cmd_expose() {
    local DEV_MODE=false
    local STOP_MODE=false
    local STATUS_MODE=false
    local NO_API=false
    local API_PORT=""
    local port_offset=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --dev)    DEV_MODE=true ;;
            --no-api) NO_API=true ;;
            --stop)   STOP_MODE=true ;;
            --status) STATUS_MODE=true ;;
            --port)
                shift
                if [ $# -eq 0 ] || ! [[ "$1" =~ ^[0-9]+$ ]]; then
                    echo "ERROR: --port requires a numeric argument" >&2
                    exit 1
                fi
                API_PORT="$1"
                ;;
            --port-offset)
                shift
                if [ $# -eq 0 ] || ! [[ "$1" =~ ^[0-9]+$ ]]; then
                    echo "ERROR: --port-offset requires a numeric argument" >&2
                    exit 1
                fi
                port_offset="$1"
                ;;
            -h|--help) usage_expose; return 0 ;;
            *) echo "Unknown option: $1"; usage_expose; exit 1 ;;
        esac
        shift
    done

    ensure_minikube_running
    ensure_state_dir

    ########################################
    # Main expose logic
    #
    # Port-forward + loopback helpers live at the top of this script so that
    # expose --stop, cleanup, and minikube delete can reuse them.
    ########################################

    if [ "$STOP_MODE" = true ]; then
        echo "Stopping all port-forwards..."
        stop_all_forwards
        remove_all_loopback_aliases
        return 0
    fi

    if [ "$STATUS_MODE" = true ]; then
        echo "Port-forward status:"
        show_status
        return 0
    fi

    echo "Starting port-forwards..."
    EXPOSE_FAILURES=0
    # every local port is shifted by --port-offset so several instances can be
    # exposed at once (Scylla binds to each node's own advertised IP instead)
    local es_port=$((9200 + port_offset)) kb_port=$((5601 + port_offset))
    local redis_port=$((6379 + port_offset)) s3_port=$((8333 + port_offset))
    API_PORT="${API_PORT:-$((8080 + port_offset))}"
    local has_registry=false
    if kctl get svc registry -n "$THORIUM_NAMESPACE" &>/dev/null; then
        has_registry=true
    fi

    # --no-api forwards only the backing services so a locally-run API can use them
    if [ "$NO_API" = false ]; then
        run_forward "${INSTANCE:+$INSTANCE-}thorium-api" "$THORIUM_NAMESPACE" thorium-api "$API_PORT:80"
        # the registry is optional (deploy --registry), so only forward it when deployed
        if [ "$has_registry" = true ]; then
            run_forward registry "$THORIUM_NAMESPACE" registry 5000
        fi
    fi

    # forward the backing services for --dev or when only the infrastructure is wanted
    if [ "$DEV_MODE" = true ] || [ "$NO_API" = true ]; then
        run_forward "${INSTANCE:+$INSTANCE-}elastic" "$ELASTIC_NAMESPACE" elastic-es-http "$es_port:9200"
        run_forward "${INSTANCE:+$INSTANCE-}kibana" "$ELASTIC_NAMESPACE" elastic-kb-http "$kb_port:5601"
        run_forward "${INSTANCE:+$INSTANCE-}redis" "$REDIS_NAMESPACE" redis "$redis_port:6379"
        run_forward "${INSTANCE:+$INSTANCE-}seaweedfs" "$SEAWEEDFS_NAMESPACE" seaweedfs "$s3_port:8333"
        # Scylla needs per-node loopback-aliased forwards (see forward_scylla_dev)
        forward_scylla_dev
    fi

    echo ""
    echo "Port-forward status:"
    show_status
    echo ""
    if [ "$NO_API" = false ]; then
        echo "Thorium API available at http://localhost:$API_PORT"
        if [ "$has_registry" = true ]; then
            echo "Registry at http://localhost:5000"
        fi
    fi
    if [ "$DEV_MODE" = true ] || [ "$NO_API" = true ]; then
        echo "Elasticsearch at https://localhost:$es_port"
        echo "Kibana at https://localhost:$kb_port"
        echo "Redis at localhost:$redis_port"
        echo "SeaweedFS S3 at http://localhost:$s3_port"
        local scy_svc scy_ip
        while read -r scy_svc scy_ip; do
            [ -n "$scy_svc" ] || continue
            echo "Scylla CQL ($scy_svc) at ${scy_ip}:${SCYLLA_CQL_PORT}"
        done <<< "$(discover_scylla_nodes)"
        echo "  (Scylla is bound to its advertised cluster IP via a loopback alias;"
        echo "   point scylla.nodes at the address above, or use 'minithor get-config --local')"
    fi
    echo ""
    echo "Logs: $EXPOSE_LOG_DIR/"
    echo "Run 'minithor expose --status' to check, 'minithor expose --stop' to stop all"
    if [ "$EXPOSE_FAILURES" -gt 0 ]; then
        echo "WARNING: $EXPOSE_FAILURES port-forward(s) failed to start (see above)" >&2
        return 1
    fi
}

########################################
# Subcommand: cleanup
########################################

cmd_cleanup() {
    local confirm=false force=false
    local cleanup_timeout=300
    FAILURES=0

    while [ $# -gt 0 ]; do
        case "$1" in
            -h|--help) usage_cleanup; return 0 ;;
            --confirm) confirm=true ;;
            --force) force=true ;;
            --timeout)
                shift
                if [ $# -eq 0 ] || ! [[ "$1" =~ ^[0-9]+$ ]]; then
                    echo "ERROR: --timeout requires a numeric argument (seconds)" >&2; exit 1
                fi
                cleanup_timeout="$1"
                ;;
            *) echo "Unknown option: $1"; usage_cleanup; exit 1 ;;
        esac
        shift
    done

    if [ "$confirm" = false ]; then
        echo "ERROR: --confirm flag is required to clean up resources." >&2
        echo "" >&2
        usage_cleanup >&2
        return 1
    fi

    CURRENT_SECTION="startup"
    trap 'echo "FATAL: Failed in \"$CURRENT_SECTION\" at line $LINENO (command: $BASH_COMMAND)" >&2' ERR

    ensure_minikube_running

    # Other instances still in the cluster keep the shared operators and CRDs
    # alive; only the last instance's cleanup removes them
    local other_instances remove_shared=true
    other_instances=$(kctl get thoriumclusters -A \
        -o jsonpath='{range .items[*]}{.metadata.namespace}{"\n"}{end}' 2>/dev/null \
        | grep -vx "$THORIUM_NAMESPACE" | sort -u | tr '\n' ' ') || true
    if [ -n "$other_instances" ]; then
        remove_shared=false
        echo "Other Thorium instances remain (namespaces: $other_instances); keeping the shared operators and CRDs"
        # the Thorium operator serves every instance, so removing the namespace
        # it runs in would leave the others unmanaged
        if kctl get deploy operator -n "$THORIUM_NAMESPACE" &>/dev/null && [ "$force" = false ]; then
            echo "ERROR: the shared Thorium operator runs in $THORIUM_NAMESPACE and the other instances depend on it." >&2
            echo "  Clean up the other instances first, or pass --force to remove it anyway." >&2
            return 1
        fi
    fi

    ########################################
    # Dev port-forwards + loopback aliases
    ########################################
    CURRENT_SECTION="Stopping dev port-forwards"
    log "Stopping dev port-forwards and loopback aliases"
    run_step stop_instance_forwards

    ########################################
    # Container Registry (default instance only)
    ########################################
    if [ "$THORIUM_NAMESPACE" = "$REGISTRY_NAMESPACE" ]; then
        CURRENT_SECTION="Removing Container Registry"
        log "Removing Container Registry"
        run_step kctl delete statefulset registry -n "$REGISTRY_NAMESPACE" --ignore-not-found --timeout="${cleanup_timeout}s"
        run_step kctl delete svc registry -n "$REGISTRY_NAMESPACE" --ignore-not-found --timeout="${cleanup_timeout}s"
        run_step kctl delete secret registry-auth -n "$REGISTRY_NAMESPACE" --ignore-not-found --timeout="${cleanup_timeout}s"
        run_step kctl delete configmap registry-config -n "$REGISTRY_NAMESPACE" --ignore-not-found --timeout="${cleanup_timeout}s"
        run_step kctl delete pvc registry-data-registry-0 -n "$REGISTRY_NAMESPACE" --ignore-not-found --timeout="${cleanup_timeout}s"
    fi

    ########################################
    # Thorium
    ########################################
    CURRENT_SECTION="Removing Thorium"
    log "Removing Thorium"
    run_step kctl delete deployment operator -n "$THORIUM_NAMESPACE" --ignore-not-found --timeout="${cleanup_timeout}s"
    clear_finalizers_and_delete thoriumclusters.sandia.gov thoriumclusters.sandia.gov "$THORIUM_NAMESPACE"
    run_step kctl delete ns "$THORIUM_NAMESPACE" --ignore-not-found --timeout="${cleanup_timeout}s"
    run_step kctl delete clusterrolebinding "$THORIUM_BINDING" --ignore-not-found --timeout="${cleanup_timeout}s"
    if [ "$remove_shared" = true ]; then
        run_step kctl delete clusterrole thorium-operator --ignore-not-found --timeout="${cleanup_timeout}s"
    fi

    ########################################
    # Quickwit
    ########################################
    CURRENT_SECTION="Removing Quickwit"
    log "Removing Quickwit"
    helm_uninstall quickwit "$QUICKWIT_NAMESPACE"

    ########################################
    # Kubegres + Postgres
    ########################################
    CURRENT_SECTION="Removing Kubegres + Postgres"
    log "Removing Kubegres + Postgres"
    clear_finalizers_and_delete kubegres.kubegres.reactive-tech.io kubegres.kubegres.reactive-tech.io "$QUICKWIT_NAMESPACE"
    run_step kctl delete statefulsets,deployments,services,pods --all -n "$QUICKWIT_NAMESPACE" --force --grace-period=0 --ignore-not-found --timeout="${cleanup_timeout}s"
    run_step kctl delete ns "$QUICKWIT_NAMESPACE" --ignore-not-found --timeout="${cleanup_timeout}s"
    if [ "$remove_shared" = true ]; then
        run_step kctl delete deployment kubegres-controller-manager -n kubegres-system --ignore-not-found --timeout="${cleanup_timeout}s"
        run_step kctl delete ns kubegres-system --ignore-not-found --timeout="${cleanup_timeout}s"
        run_step kctl delete clusterrole kubegres-kubegres-editor-role kubegres-kubegres-viewer-role kubegres-manager-role kubegres-metrics-auth-role kubegres-metrics-reader --ignore-not-found --timeout="${cleanup_timeout}s"
        run_step kctl delete clusterrolebinding kubegres-manager-rolebinding kubegres-metrics-auth-rolebinding --ignore-not-found --timeout="${cleanup_timeout}s"
    fi

    ########################################
    # Jaeger
    ########################################
    CURRENT_SECTION="Removing Jaeger"
    log "Removing Jaeger"
    run_step kctl delete ns "$JAEGER_NAMESPACE" --ignore-not-found --timeout="${cleanup_timeout}s"

    ########################################
    # SeaweedFS
    ########################################
    CURRENT_SECTION="Removing SeaweedFS"
    log "Removing SeaweedFS"
    run_step kctl delete ns "$SEAWEEDFS_NAMESPACE" --ignore-not-found --timeout="${cleanup_timeout}s"
    # also remove a legacy minio namespace if one is present
    if [ -z "$INSTANCE" ]; then
        run_step kctl delete ns minio --ignore-not-found --timeout="${cleanup_timeout}s"
    fi

    ########################################
    # Scylla
    ########################################
    CURRENT_SECTION="Removing Scylla"
    log "Removing Scylla"
    clear_finalizers_and_delete scyllaclusters.scylla.scylladb.com scyllaclusters.scylla.scylladb.com "$SCYLLA_NAMESPACE"
    run_step kctl delete statefulsets,deployments,services,pods --all -n "$SCYLLA_NAMESPACE" --force --grace-period=0 --ignore-not-found --timeout="${cleanup_timeout}s"
    run_step kctl delete ns "$SCYLLA_NAMESPACE" --ignore-not-found --timeout="${cleanup_timeout}s"
    if [ "$remove_shared" = true ]; then
        run_step kctl delete deployment scylla-operator -n "$SCYLLA_OPERATOR_NAMESPACE" --ignore-not-found --timeout="${cleanup_timeout}s"
        run_step kctl delete deployment webhook-server -n "$SCYLLA_OPERATOR_NAMESPACE" --ignore-not-found --timeout="${cleanup_timeout}s"
        helm_uninstall scylla-operator "$SCYLLA_OPERATOR_NAMESPACE"
        run_step kctl delete ns "$SCYLLA_OPERATOR_NAMESPACE" --ignore-not-found --timeout="${cleanup_timeout}s"
    fi

    ########################################
    # cert-manager
    ########################################
    if [ "$remove_shared" = true ]; then
        CURRENT_SECTION="Removing cert-manager"
        log "Removing cert-manager"
        helm_uninstall cert-manager cert-manager
        run_step kctl delete ns cert-manager --ignore-not-found --timeout="${cleanup_timeout}s"
    fi

    ########################################
    # Elasticsearch
    ########################################
    CURRENT_SECTION="Removing Elasticsearch"
    log "Removing Elasticsearch"
    if [ "$remove_shared" = true ]; then
        helm_uninstall elastic-operator "$ELASTIC_OPERATOR_NAMESPACE"
    fi
    clear_finalizers_and_delete elasticsearches.elasticsearch.k8s.elastic.co elasticsearches.elasticsearch.k8s.elastic.co "$ELASTIC_NAMESPACE"
    clear_finalizers_and_delete kibanas.kibana.k8s.elastic.co kibanas.kibana.k8s.elastic.co "$ELASTIC_NAMESPACE"
    if [ "$ELASTIC_NAMESPACE" != "$ELASTIC_OPERATOR_NAMESPACE" ] || [ "$remove_shared" = true ]; then
        run_step kctl delete statefulsets,deployments,services,pods --all -n "$ELASTIC_NAMESPACE" --force --grace-period=0 --ignore-not-found --timeout="${cleanup_timeout}s"
        run_step kctl delete ns "$ELASTIC_NAMESPACE" --ignore-not-found --timeout="${cleanup_timeout}s"
    else
        # the default instance shares elastic-system with the ECK operator the
        # other instances still use, so only its data is removed
        run_step kctl delete pvc -l elasticsearch.k8s.elastic.co/cluster-name=elastic -n "$ELASTIC_NAMESPACE" --ignore-not-found --timeout="${cleanup_timeout}s"
    fi

    ########################################
    # Redis
    ########################################
    CURRENT_SECTION="Removing Redis"
    log "Removing Redis"
    run_step kctl delete ns "$REDIS_NAMESPACE" --ignore-not-found --timeout="${cleanup_timeout}s"

    ########################################
    # Saved credentials
    ########################################
    CURRENT_SECTION="Removing saved credentials"
    log "Removing saved credentials"
    run_step kctl delete ns "$CREDENTIALS_NAMESPACE" --ignore-not-found --timeout="${cleanup_timeout}s"

    ########################################
    # Leftover CRDs
    ########################################
    if [ "$remove_shared" = true ]; then
        CURRENT_SECTION="Cleaning up CRDs"
        log "Cleaning up leftover CRDs"
        CRDS=$(kctl get crds -o name 2>/dev/null | grep -E 'cert-manager|elastic|scylla|kubegres|sandia' || true)
        if [ -n "$CRDS" ]; then
            # one CRD name per word
            # shellcheck disable=SC2086
            run_step kctl delete $CRDS --timeout="${cleanup_timeout}s"
        fi
    fi

    ########################################
    # Wait for namespace termination
    ########################################
    CURRENT_SECTION="Waiting for namespace termination"
    log "Waiting for namespaces to terminate"
    run_step wait_for_ns_termination "$cleanup_timeout"

    ########################################
    # Summary
    ########################################
    if [ "$FAILURES" -gt 0 ]; then
        log "Cleanup finished with $FAILURES failure(s)"
        kctl get ns
        return 1
    else
        log "Cleanup complete"
        kctl get ns
    fi
}

########################################
# Dispatch
########################################

# --instance may appear anywhere on the command line (before or after the
# subcommand), so pull it out before dispatching
args=()
while [ $# -gt 0 ]; do
    case "$1" in
        --instance)
            if [ $# -lt 2 ]; then
                echo "ERROR: --instance requires a name" >&2
                exit 1
            fi
            set_instance "$2"
            shift 2
            ;;
        --instance=*)
            set_instance "${1#--instance=}"
            shift
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done
set -- ${args[@]+"${args[@]}"}

if [ $# -eq 0 ]; then
    usage
    exit 1
fi

command="$1"
shift

case "$command" in
    minikube)   cmd_minikube "$@" ;;
    start)      cmd_start "$@" ;;
    deploy)     cmd_deploy "$@" ;;
    get-config) cmd_get_config "$@" ;;
    expose)     cmd_expose "$@" ;;
    stop)       cmd_stop "$@" ;;
    cleanup)    cmd_cleanup "$@" ;;
    -h|--help)  usage; exit 0 ;;
    *)
        echo "Unknown command: $command" >&2
        echo "" >&2
        usage >&2
        exit 1
        ;;
esac
