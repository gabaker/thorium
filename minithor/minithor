#!/usr/bin/env bash
# Single-quoted `sh -c` scripts are expanded inside pods (so secrets arrive over
# stdin instead of host command lines), not by this shell
# shellcheck disable=SC2016
# -E makes ERR traps fire inside functions (kctl and every helper is one)
set -Eeuo pipefail

########################################
# Shared utilities
########################################

OS="$(uname -s)"
ARCH="$(uname -m)"
DRIVER=""
CONTAINER_CMD=""

# In-cluster container registry, referenced by its Kubernetes service DNS name.
REGISTRY_HOST="docker-registry.thorium.svc.cluster.local"
REGISTRY_PORT=5000
# The critical hosts and CIDR ranges that must never traverse an HTTP proxy so
# the minikube node and host can reach them directly: the node subnet (docker
# driver), the service and pod CIDRs, the control-plane host, loopback, and the
# cluster-internal registry/DNS suffixes (CoreDNS is pod-facing only, so the
# node's container runtime can't route these through a proxy). Leading-dot
# entries match subdomains in Go's httpproxy matcher used by the runtime. This
# is unioned with the host's own NO_PROXY by compute_no_proxy().
MINIKUBE_NO_PROXY="control-plane.minikube.internal,192.168.49.0/24,10.96.0.0/12,10.244.0.0/16,localhost,127.0.0.1,${REGISTRY_HOST},.svc,.svc.cluster.local,cluster.local"

# Union the host's existing NO_PROXY/no_proxy with MINIKUBE_NO_PROXY, emitting
# each entry exactly once (order preserved). This is the single source of truth
# for the NO_PROXY handed to minikube and baked into the node, so install,
# start, and expose stay consistent. HTTP_PROXY/HTTPS_PROXY are always taken
# as-is from the host environment and never constructed here.
compute_no_proxy() {
    # the selected profile's node subnet (each additional profile gets its own /24)
    local node_ip node_cidr=""
    node_ip="$(minikube ip 2>/dev/null)" || true
    if [[ "$node_ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        node_cidr="${node_ip%.*}.0/24"
    fi
    printf '%s,%s,%s,%s' "${NO_PROXY:-}" "${no_proxy:-}" "$MINIKUBE_NO_PROXY" "$node_cidr" \
        | tr ',' '\n' \
        | awk 'NF && !seen[$0]++' \
        | paste -sd, -
}

# Persist the computed NO_PROXY into a shell rc file so ad-hoc kubectl/curl
# use in interactive shells (outside minithor, which fixes this up itself on
# every cluster-touching command via ensure_minikube_running/minikube_start)
# also bypasses the proxy for the minikube node. Manages its own marked block
# so re-running install on an existing rc file only replaces that block and
# never touches any other proxy settings the user has in the file.
persist_no_proxy_rc() {
    local rc_file="$1"
    local no_proxy_value="$2"
    local marker_start="# >>> minithor NO_PROXY (managed, do not edit) >>>"
    local marker_end="# <<< minithor NO_PROXY (managed, do not edit) <<<"

    touch "$rc_file"
    if grep -qF "$marker_start" "$rc_file" 2>/dev/null; then
        # Delete the managed block along with the single blank separator line
        # this function prepends, so repeated installs don't accumulate blank
        # lines at the removal site.
        awk -v s="$marker_start" -v e="$marker_end" '
            $0 == s { if (buffered_blank) buffered_blank=0; in_block=1; next }
            in_block { if ($0 == e) in_block=0; next }
            $0 == "" { if (buffered_blank) print ""; buffered_blank=1; next }
            { if (buffered_blank) { print ""; buffered_blank=0 }; print }
            END { if (buffered_blank) print "" }
        ' "$rc_file" > "${rc_file}.tmp"
        # Write back through the existing file rather than mv so a symlinked rc
        # file (e.g. managed by a dotfile manager) stays a symlink
        cat "${rc_file}.tmp" > "$rc_file"
        rm -f "${rc_file}.tmp"
    fi

    {
        echo ""
        echo "$marker_start"
        echo "# Required for minikube (192.168.49.0/24 etc.) to bypass the proxy."
        echo "export NO_PROXY=\"$no_proxy_value\""
        echo "export no_proxy=\"\$NO_PROXY\""
        echo "$marker_end"
    } >> "$rc_file"
}

# kubectl for the selected profile; the context is pinned so a kubeconfig whose current
# context points at another cluster is never used by accident
kctl() { minikube kubectl -- --context "$MINIKUBE_PROFILE" "$@"; }

log() { echo -e "\n====== $1 ======\n"; }

########################################
# Port-forward + loopback alias helpers (shared)
#
# Used by `expose`, `expose --stop`, `cleanup`, and `minikube delete` so that
# dev port-forwards and the loopback aliases they create are always torn down
# together.
########################################

# Where expose writes its logs and tracks the loopback aliases it created. This
# is per-user and private: the alias list is later fed to `sudo ip addr del`, so
# it must not live in a shared location another user could write to.
MINITHOR_STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/minithor"
EXPOSE_LOG_DIR="${MINITHOR_STATE_DIR}/expose-logs"
LOOPBACK_STATE_FILE="${MINITHOR_STATE_DIR}/loopback-aliases"
CURRENT_UID="$(id -u)"

# Create the private state directories used by expose
ensure_state_dir() {
    mkdir -p "$EXPOSE_LOG_DIR"
    chmod 700 "$MINITHOR_STATE_DIR" "$EXPOSE_LOG_DIR"
}

SCYLLA_CQL_PORT=9042
# Local API listen port written into a `--local` config (80 needs root)
LOCAL_API_PORT=8888

# The minikube profile every command targets (see --profile). Exported so plain `minikube`
# invocations pick it up too.
MINIKUBE_PROFILE="${MINITHOR_PROFILE:-minikube}"
export MINIKUBE_PROFILE

# The Thorium Helm charts deploy installs by default: the published charts at this version.
# Use --chart/--operators-chart for a local chart directory or packaged .tgz instead.
CHART_REPO="${MINITHOR_CHART_REPO:-oci://ghcr.io/cisagov/thorium/charts}"
CHART_VERSION="${MINITHOR_CHART_VERSION:-1.8.1}"
# The namespace the cluster-wide infra-operators chart is installed into
OPERATORS_NAMESPACE="infra-operators"
# The Helm release name of each instance's thorium chart
THORIUM_RELEASE="thorium"
# The pinned Helm release downloaded when helm is missing or too old for OCI charts
HELM_VERSION="v3.22.0"
# The toolbox deploy imports unless --toolbox or --no-toolbox is given
DEFAULT_TOOLBOX_URL="https://raw.githubusercontent.com/cisagov/thorium/refs/heads/main/tools/toolbox.json"


# The optional in-cluster registry only exists for the default instance, since the node's
# container runtime trusts REGISTRY_HOST from cluster creation
REGISTRY_NAMESPACE="thorium"

# Select which Thorium instance the namespace and service DNS variables below describe. The
# default instance (no name) uses the plain namespaces (thorium, redis, ...); a named instance
# prefixes each with "<name>-" so several instances can share the cluster. The cluster-wide
# operators (Scylla, ECK, Kubegres) are shared by all instances; each instance runs its own
# namespace-scoped Thorium operator.
#
#   set_instance [name]
set_instance() {
    INSTANCE="${1:-}"
    if [ -n "$INSTANCE" ] && ! [[ "$INSTANCE" =~ ^[a-z0-9]([-a-z0-9]{0,30}[a-z0-9])?$ ]]; then
        echo "ERROR: --instance must be a lowercase DNS label of at most 32 characters" >&2
        exit 1
    fi
    local prefix="${INSTANCE:+$INSTANCE-}"
    THORIUM_NAMESPACE="${prefix}thorium"
    REDIS_NAMESPACE="${prefix}redis"
    SCYLLA_NAMESPACE="${prefix}scylla"
    ELASTIC_NAMESPACE="${prefix}elastic"
    SEAWEEDFS_NAMESPACE="${prefix}seaweedfs"
    QUICKWIT_NAMESPACE="${prefix}quickwit"
    JAEGER_NAMESPACE="${prefix}jaeger"
    INSTANCE_NAMESPACES=("$THORIUM_NAMESPACE" "$REDIS_NAMESPACE" "$SCYLLA_NAMESPACE" \
        "$ELASTIC_NAMESPACE" "$SEAWEEDFS_NAMESPACE" "$QUICKWIT_NAMESPACE" "$JAEGER_NAMESPACE")
    # In-cluster service DNS names baked into the thorium secret. Also used by
    # `get-config --local` to rewrite the config for host access via exposed ports.
    ELASTIC_CLUSTER_HOST="elastic-es-http.${ELASTIC_NAMESPACE}.svc.cluster.local"
    REDIS_CLUSTER_HOST="redis.${REDIS_NAMESPACE}.svc.cluster.local"
    SEAWEEDFS_CLUSTER_HOST="seaweedfs.${SEAWEEDFS_NAMESPACE}.svc.cluster.local"
    SCYLLA_CLUSTER_HOST="scylla-client.${SCYLLA_NAMESPACE}.svc.cluster.local"
    # nginx routes on host, so each instance's ingress needs its own
    INGRESS_HOST="${INSTANCE:+$INSTANCE.}localhost"
    # get-config writes ~/thorium.yml for the default instance, ~/thorium-<name>.yml otherwise
    CONFIG_NAME="thorium${INSTANCE:+-$INSTANCE}"
    # the values deploy generates from the embedded defaults and its flags
    VALUES_FILE="${MINITHOR_STATE_DIR}/values${INSTANCE:+-$INSTANCE}.yaml"
}
set_instance "${MINITHOR_INSTANCE:-}"

# List the minikube kubectl port-forward processes on this host as
# "<uid> <pid> <args...>". The `[p]ort` trick keeps grep from matching itself;
# `.*svc/` tolerates an interspersed `--address` flag (used for the Scylla
# forwards). The uid is used for ownership because procps truncates long user
# names. `-ww` stops BSD/macOS ps from truncating args to the terminal width.
find_forwards() {
    ps -A -ww -o uid= -o pid= -o args= 2>/dev/null \
        | grep 'minikube kubectl.*[p]ort-forward.*svc/' \
        || true
}

# List only the port-forwards owned by the invoking user
# This user's forwards into the selected profile. kctl always passes --context, so forwards
# started by other tools (e.g. minithor) or for other profiles are never matched.
find_own_forwards() {
    find_forwards | awk -v u="$CURRENT_UID" -v c="--context $MINIKUBE_PROFILE " '$1 == u && index($0, c)'
}

parse_service() { echo "$1" | sed -n 's/.*svc\/\([^ ]*\).*/\1/p'; }
parse_ports()   { echo "$1" | awk '{print $NF}'; }

# Print a user name for a uid, falling back to the raw uid
uid_name() { id -nu "$1" 2>/dev/null || echo "uid $1"; }

# Stop a process started by this user along with its children (the minikube
# wrapper spawns the real kubectl as a child)
kill_own_process() {
    local pid=$1
    pkill -P "$pid" 2>/dev/null || true
    kill "$pid" 2>/dev/null || true
}

# Is a port-forward to this service already running? Services are matched with
# their namespace since every instance uses the same service names.
#
#   is_forward_alive <service> <namespace>
is_forward_alive() { find_forwards | grep -qE "svc/$1 -n $2( |$)"; }

parse_namespace() { echo "$1" | sed -n 's/.* -n \([^ ]*\).*/\1/p'; }

stop_all_forwards() {
    local found=false line uid pid service others
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        found=true
        read -r uid pid _ <<< "$line"
        service=$(parse_service "$line")
        kill_own_process "$pid"
        echo "Stopped $service (PID $pid)"
    done < <(find_own_forwards)
    if [ "$found" = false ]; then
        echo "No port-forwards running"
    fi
    # Other users' forwards are theirs to manage; only report them
    others=$(find_forwards | awk -v u="$CURRENT_UID" '$1 != u' | wc -l | tr -d ' ')
    if [ "$others" -gt 0 ]; then
        echo "Left $others port-forward(s) owned by other users running"
    fi
}

# Stop this user's port-forwards into the selected instance's namespaces and
# remove the Scylla loopback aliases they used, leaving other instances' alone
stop_instance_forwards() {
    local line pid ns service
    local namespaces=" $THORIUM_NAMESPACE $ELASTIC_NAMESPACE $REDIS_NAMESPACE $SEAWEEDFS_NAMESPACE $SCYLLA_NAMESPACE "
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        ns=$(parse_namespace "$line")
        [[ "$namespaces" == *" $ns "* ]] || continue
        read -r _ pid _ <<< "$line"
        service=$(parse_service "$line")
        kill_own_process "$pid"
        echo "Stopped $service ($ns, PID $pid)"
    done < <(find_own_forwards)
    # the instance's Scylla nodes advertise the addresses its aliases were made for
    local svc ip
    while read -r svc ip; do
        [ -n "$ip" ] || continue
        loopback_alias_del "$ip"
        if [ -f "$LOOPBACK_STATE_FILE" ]; then
            grep -vxF "$ip" "$LOOPBACK_STATE_FILE" > "${LOOPBACK_STATE_FILE}.tmp" || true
            mv "${LOOPBACK_STATE_FILE}.tmp" "$LOOPBACK_STATE_FILE"
        fi
    done <<< "$(discover_scylla_nodes)"
}

show_status() {
    local found=false line uid pid service ports
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        found=true
        read -r uid pid _ <<< "$line"
        service=$(parse_service "$line")
        ports=$(parse_ports "$line")
        echo "  $service ($(parse_namespace "$line")): running as $(uid_name "$uid") (PID $pid) -> $ports"
    done < <(find_forwards)
    if [ "$found" = false ]; then
        echo "  No port-forwards running"
    fi
}

# Start a single port-forward. Accepts an optional leading `--address <ip>` to
# bind the forward to a specific local IP (used for Scylla, see forward_scylla_dev).
#
#   start_forward [--address <ip>] <name> <namespace> <service> <ports...>
start_forward() {
    local bind_addr=""
    if [ "${1:-}" = "--address" ]; then
        bind_addr="$2"
        shift 2
    fi
    local name=$1 namespace=$2 service=$3
    shift 3
    local ports=("$@")

    if is_forward_alive "$service" "$namespace"; then
        local existing uid pid
        existing=$(find_forwards | grep -E "svc/$service -n $namespace( |$)" | head -1)
        read -r uid pid _ <<< "$existing"
        echo "  $name: already running as $(uid_name "$uid") (PID $pid), skipping"
        return 0
    fi

    if ! kctl get svc "$service" -n "$namespace" &>/dev/null; then
        echo "  $name: SKIPPED (service $service not found in namespace $namespace)"
        return 1
    fi

    # Find any process holding the local port. When bound to a specific address,
    # scope the check to that address so sibling forwards on the same port (e.g.
    # multiple Scylla nodes on :9042) aren't matched.
    local local_port="${ports[0]%%:*}"
    local holder_pid=""
    if command -v ss &>/dev/null; then
        if [ -n "$bind_addr" ]; then
            holder_pid=$(ss -tlnp "src ${bind_addr}:${local_port}" 2>/dev/null | sed -n 's/.*pid=\([0-9]*\).*/\1/p' | head -1 || true)
        else
            holder_pid=$(ss -tlnp "sport = :$local_port" 2>/dev/null | sed -n 's/.*pid=\([0-9]*\).*/\1/p' | head -1 || true)
        fi
    elif [ -n "$bind_addr" ]; then
        holder_pid=$(lsof -nP -ti "TCP@${bind_addr}:${local_port}" -sTCP:LISTEN 2>/dev/null | head -1 || true)
    else
        holder_pid=$(lsof -nP -ti "TCP:$local_port" -sTCP:LISTEN 2>/dev/null | head -1 || true)
    fi
    if [ -n "$holder_pid" ]; then
        # Only a stale port-forward of our own is safe to replace; anything else
        # (a local Redis, another user's forward, ...) is left alone
        local holder_uid holder_args
        holder_uid=$(ps -o uid= -p "$holder_pid" 2>/dev/null | tr -d ' ' || true)
        holder_args=$(ps -ww -o args= -p "$holder_pid" 2>/dev/null || true)
        if [ "$holder_uid" = "$CURRENT_UID" ] && [[ "$holder_args" == *port-forward* ]]; then
            echo "  $name: replacing stale port-forward on port ${bind_addr:+$bind_addr:}$local_port (PID $holder_pid)"
            kill_own_process "$holder_pid"
            sleep 1
        else
            echo "  $name: FAILED (port ${bind_addr:+$bind_addr:}$local_port is in use by PID $holder_pid, owner $(uid_name "${holder_uid:-?}"))"
            return 1
        fi
    fi

    local addr_flag=()
    [ -n "$bind_addr" ] && addr_flag=(--address "$bind_addr")

    local log_file="$EXPOSE_LOG_DIR/$name.log"
    kctl port-forward ${addr_flag[@]+"${addr_flag[@]}"} "svc/$service" -n "$namespace" "${ports[@]}" >/dev/null 2>"$log_file" &
    local pid=$!

    sleep 1
    if is_forward_alive "$service" "$namespace"; then
        echo "  $name: forwarding ${bind_addr:+$bind_addr }${ports[*]} (PID $pid)"
    else
        echo "  $name: FAILED to start (port-forward exited immediately)"
        if [ -s "$log_file" ]; then
            echo "  $name: log: $(cat "$log_file")"
        fi
        return 1
    fi
}

# Is the given IP currently configured as a loopback alias?
loopback_alias_present() {
    local ip=$1
    case "$OS" in
        Linux)  ip addr show dev lo 2>/dev/null | grep -qw "$ip" ;;
        Darwin) ifconfig lo0 2>/dev/null | grep -qw "$ip" ;;
        *) return 1 ;;
    esac
}

# Add an IP as a loopback alias so a port-forward can bind to it, recording it
# in the state file so teardown knows to remove it. Idempotent.
loopback_alias_add() {
    local ip=$1
    ensure_state_dir
    if ! { [ -f "$LOOPBACK_STATE_FILE" ] && grep -qxF "$ip" "$LOOPBACK_STATE_FILE"; }; then
        echo "$ip" >> "$LOOPBACK_STATE_FILE"
    fi
    if loopback_alias_present "$ip"; then
        return 0
    fi
    case "$OS" in
        Linux)  sudo ip addr add "$ip/32" dev lo ;;
        Darwin) sudo ifconfig lo0 alias "$ip" 255.255.255.255 ;;
        *) echo "  WARNING: don't know how to add a loopback alias on $OS" >&2; return 1 ;;
    esac
}

# Remove a single loopback alias if present.
loopback_alias_del() {
    local ip=$1
    if loopback_alias_present "$ip"; then
        case "$OS" in
            Linux)  sudo ip addr del "$ip/32" dev lo 2>/dev/null || true ;;
            Darwin) sudo ifconfig lo0 -alias "$ip" 2>/dev/null || true ;;
        esac
        echo "  Removed loopback alias $ip"
    fi
}

# Remove every loopback alias expose created and clear the state file.
remove_all_loopback_aliases() {
    [ -f "$LOOPBACK_STATE_FILE" ] || return 0
    local ip
    while IFS= read -r ip; do
        [ -n "$ip" ] || continue
        loopback_alias_del "$ip"
    done < "$LOOPBACK_STATE_FILE"
    rm -f "$LOOPBACK_STATE_FILE"
}

# Discover Thorium's Scylla nodes and the address each advertises to clients
# (its broadcast_rpc_address, which the Scylla driver re-dials after the initial
# connection). With scylla-operator each node gets a per-pod ClusterIP "member"
# service whose name matches the pod and whose ClusterIP is that advertised
# address. Prints "<member-service-name> <advertised-ip>" per node.
discover_scylla_nodes() {
    local pods pod ip
    pods=$(kctl get pods -n "$SCYLLA_NAMESPACE" \
        -l app.kubernetes.io/name=scylla \
        -o jsonpath='{.items[*].metadata.name}' 2>/dev/null) || true
    for pod in $pods; do
        ip=$(kctl get svc "$pod" -n "$SCYLLA_NAMESPACE" \
            -o jsonpath='{.spec.clusterIP}' 2>/dev/null) || true
        if [ -n "$ip" ] && [ "$ip" != "None" ]; then
            echo "$pod $ip"
        fi
    done
}

# Start a port-forward without aborting the caller on failure, counting the
# failure in EXPOSE_FAILURES so expose can report it and exit non-zero at the end
run_forward() {
    start_forward "$@" || EXPOSE_FAILURES=$((EXPOSE_FAILURES + 1))
}

# Set up dev port-forwards for Scylla. A plain localhost forward does NOT work:
# the driver connects to the seed, learns each node's advertised
# broadcast_rpc_address (the per-pod ClusterIP) and re-dials *that* address,
# which a localhost tunnel can't satisfy. So for each node we add its advertised
# IP as a loopback alias and bind the forward to that exact IP, so both the seed
# connection and the driver's re-dial land on the forward.
forward_scylla_dev() {
    local nodes
    nodes=$(discover_scylla_nodes)
    if [ -z "$nodes" ]; then
        echo "  scylla: SKIPPED (no Scylla nodes found in namespace $SCYLLA_NAMESPACE)"
        return 1
    fi
    local svc ip
    while read -r svc ip; do
        [ -n "$svc" ] || continue
        if ! loopback_alias_add "$ip"; then
            echo "  scylla[$svc]: FAILED to add loopback alias $ip"
            EXPOSE_FAILURES=$((EXPOSE_FAILURES + 1))
            continue
        fi
        run_forward --address "$ip" "${INSTANCE:+$INSTANCE-}scylla-$svc" "$SCYLLA_NAMESPACE" "$svc" \
            "$SCYLLA_CQL_PORT:$SCYLLA_CQL_PORT"
    done <<< "$nodes"
}

has_podman() {
    command -v podman >/dev/null 2>&1 &&
    podman info >/dev/null 2>&1
}

has_docker() {
    command -v docker >/dev/null 2>&1 &&
    env -u DOCKER_HOST docker info >/dev/null 2>&1
}

has_kvm2() {
    [ "$OS" = "Linux" ] || return 1
    command -v virsh >/dev/null 2>&1 &&
    [ -e /dev/kvm ] &&
    (
        systemctl is-active --quiet libvirtd 2>/dev/null ||
        systemctl is-active --quiet virtqemud 2>/dev/null
    )
}

select_driver() {
    if has_podman; then
        DRIVER="podman"
        CONTAINER_CMD="podman"
    elif has_docker; then
        DRIVER="docker"
        CONTAINER_CMD="docker"
    elif has_kvm2; then
        DRIVER="kvm2"
        CONTAINER_CMD=""
    else
        echo "No supported and working minikube driver found."
        return 1
    fi
}

# Set DRIVER/CONTAINER_CMD from the existing minikube profile, which is the
# driver the cluster was actually created with. Returns 1 when no profile exists.
detect_profile_driver() {
    local profile_driver
    profile_driver=$(minikube profile list -o json 2>/dev/null \
        | grep -o '"Driver": *"[^"]*"' | head -1 | sed 's/.*"\([^"]*\)"$/\1/') || true
    [ -n "$profile_driver" ] || return 1
    DRIVER="$profile_driver"
    case "$DRIVER" in
        docker|podman) CONTAINER_CMD="$DRIVER" ;;
        *) CONTAINER_CMD="" ;;
    esac
}

minikube_start() {
    # Trust the in-cluster registry as insecure (HTTP) at cluster-creation time.
    # The node's container runtime defaults to HTTPS for every registry; without
    # this, pulling from the HTTP-only internal registry fails the TLS handshake
    # with "unexpected EOF" -> ErrImagePull/ImagePullBackOff. The flag must be set
    # when the node is created since it bakes into the runtime's daemon config.
    local insecure_registry="${REGISTRY_HOST}:${REGISTRY_PORT}"

    # Hand minikube a clean, deduped NO_PROXY (host entries + critical cluster
    # hosts/CIDRs). HTTP_PROXY/HTTPS_PROXY are inherited from the host env as-is.
    # Note: minikube's own propagation of these into the node runtime is
    # unreliable (it can bake empty values), so setup_node_pull_env() re-asserts
    # the proxy directly on the node after start — this just keeps what minikube
    # sees consistent.
    NO_PROXY="$(compute_no_proxy)"
    export NO_PROXY
    export no_proxy="$NO_PROXY"

    if [ "$DRIVER" = "docker" ]; then
        env -u DOCKER_HOST minikube start --cni calico --driver="$DRIVER" --insecure-registry="$insecure_registry"
    elif [ "$DRIVER" = "podman" ]; then
        minikube start --cni calico --container-runtime=containerd --driver="$DRIVER" --insecure-registry="$insecure_registry"
    else
        minikube start --cni calico --driver="$DRIVER" --insecure-registry="$insecure_registry"
    fi
}

fix_container_config() {
    if [ -n "$CONTAINER_CMD" ]; then
        local api_port cluster
        api_port="$($CONTAINER_CMD port "$MINIKUBE_PROFILE" 8443/tcp | awk -F: '{print $2}')"
        cluster="$(kctl config view --minify -o jsonpath='{.contexts[0].context.cluster}')"
        kctl config set-cluster "$cluster" --server="https://127.0.0.1:${api_port}"
    fi
}

ensure_minikube_running() {
    # Every subcommand that reaches the cluster calls this first, so fixing up
    # NO_PROXY here (rather than in each cmd_* function) guarantees local
    # kubectl/port-forward traffic to the node bypasses any configured HTTP
    # proxy, regardless of what the invoking shell happened to have set.
    NO_PROXY="$(compute_no_proxy)"
    export NO_PROXY
    export no_proxy="$NO_PROXY"

    local status_output
    status_output="$(minikube status 2>/dev/null)" || true
    local host_status
    host_status="$(echo "$status_output" | awk '/^host:/ {print $2}')" || true
    if [[ "$host_status" != "Running" ]]; then
        echo "ERROR: minikube is not running. Start it with: minithor start" >&2
        exit 1
    fi
    # Auto-fix stale kubeconfig (e.g. after host reboot changed the container port mapping)
    local kube_status
    kube_status="$(echo "$status_output" | awk '/^kubeconfig:/ {print $2}')" || true
    if [[ "$kube_status" != "Configured" ]]; then
        echo "Kubeconfig is stale, updating context..." >&2
        minikube update-context >/dev/null 2>&1
        # update-context points container drivers at the node's internal IP,
        # which isn't reachable from macOS hosts, so re-apply the published port
        if detect_profile_driver; then
            fix_container_config >/dev/null
        fi
    fi
}

wait_for_rollout() {
    local resource=$1 namespace=$2 timeout=${3:-300}
    kctl rollout status --watch --timeout="${timeout}s" "$resource" -n "$namespace"
}

wait_for_resource() {
    local resource_type=$1 resource_name=$2 namespace=$3 timeout=${4:-300}
    local elapsed=0
    local ns_flag=()
    if [ -n "$namespace" ]; then
        ns_flag=(-n "$namespace")
    fi
    echo "Waiting for $resource_type/$resource_name${namespace:+ in $namespace} (timeout: ${timeout}s)..."
    until kctl get "$resource_type" "$resource_name" ${ns_flag[@]+"${ns_flag[@]}"} &>/dev/null; do
        sleep 5
        elapsed=$((elapsed + 5))
        if [ "$elapsed" -ge "$timeout" ]; then
            echo "ERROR: Timed out waiting for $resource_type/$resource_name${namespace:+ in $namespace}" >&2
            return 1
        fi
    done
}

# Wait until at least one pod matching a selector exists and all matching pods
# are Ready. A bare `kubectl wait -l` fails immediately with "no matching
# resources" when the controller hasn't created the pods yet.
#
#   wait_for_pods_ready <namespace> <selector> [timeout]
wait_for_pods_ready() {
    local namespace=$1 selector=$2 timeout=${3:-300}
    local elapsed=0
    echo "Waiting for pods ($selector) in $namespace to be Ready (timeout: ${timeout}s)..."
    until [ -n "$(kctl get pods -n "$namespace" -l "$selector" -o name 2>/dev/null)" ]; do
        sleep 5
        elapsed=$((elapsed + 5))
        if [ "$elapsed" -ge "$timeout" ]; then
            echo "ERROR: Timed out waiting for pods ($selector) in $namespace to be created" >&2
            return 1
        fi
    done
    kctl wait --for=condition=Ready pod -l "$selector" -n "$namespace" --timeout="$((timeout - elapsed))s"
}

# Wait for a Job to succeed, failing fast (with its logs) once the Job is marked
# Failed instead of waiting out the whole timeout
#
#   wait_for_job <namespace> <job> [timeout]
wait_for_job() {
    local namespace=$1 job=$2 timeout=${3:-300}
    local elapsed=0 succeeded failed
    while :; do
        succeeded=$(kctl get job "$job" -n "$namespace" -o jsonpath='{.status.succeeded}' 2>/dev/null || true)
        if [ "${succeeded:-0}" -ge 1 ]; then
            return 0
        fi
        failed=$(kctl get job "$job" -n "$namespace" \
            -o jsonpath='{.status.conditions[?(@.type=="Failed")].status}' 2>/dev/null || true)
        if [ "$failed" = "True" ] || [ "$elapsed" -ge "$timeout" ]; then
            if [ "$failed" = "True" ]; then
                echo "ERROR: job/$job in $namespace failed; last logs:" >&2
            else
                echo "ERROR: Timed out after ${timeout}s waiting for job/$job in $namespace; last logs:" >&2
            fi
            kctl logs -n "$namespace" "job/$job" --tail=50 >&2 || true
            return 1
        fi
        sleep 5
        elapsed=$((elapsed + 5))
    done
}

wait_for_port_forward() {
    local port=$1 max_attempts=${2:-20}
    for attempt in $(seq 1 "$max_attempts"); do
        if curl -sf -o /dev/null "http://localhost:$port" 2>/dev/null; then return 0; fi
        sleep 1
    done
    echo "ERROR: Port-forward on port $port not ready after ${max_attempts}s" >&2
    return 1
}

# Error-tolerant execution — uses FAILURES global set by the caller
run_step() {
    if ! "$@"; then
        FAILURES=$((FAILURES + 1))
        echo "ERROR: Command failed (continuing): $*" >&2
    fi
}

tune_kernel_params() {
    local target="${1:-host}"
    # fs.aio-max-nr is kernel-wide and each Scylla node reserves a large share,
    # so a second instance's Scylla fails to start at the 65536 default
    local params=(
        "fs.aio-max-nr=2097152"
        "fs.inotify.max_user_instances=1024"
        "fs.file-max=2097152"
        "fs.nr_open=1048576"
        "vm.max_map_count=262144"
    )
    local persisted=()
    for param in "${params[@]}"; do
        local key="${param%%=*}"
        local desired="${param#*=}"
        local current
        if [ "$target" = "minikube" ]; then
            current=$(minikube ssh -- /sbin/sysctl -n "$key" 2>/dev/null | tr -d '\r') || true
        else
            current=$(sysctl -n "$key" 2>/dev/null) || true
        fi
        if [ -z "$current" ]; then
            echo "  $key: could not read current value, skipping"
            continue
        fi
        if [ "$current" -ge "$desired" ] 2>/dev/null; then
            echo "  $key = $current (already >= $desired)"
            # persist the higher current value so a reboot never lowers it
            persisted+=("$key=$current")
        else
            persisted+=("$param")
            echo "  $key: $current -> $desired"
            if [ "$target" = "minikube" ]; then
                minikube ssh -- sudo /sbin/sysctl -w "$param" >/dev/null 2>&1 || echo "    WARNING: failed to set $key on minikube node"
            else
                sudo sysctl -w "$param" >/dev/null 2>&1 || echo "    WARNING: failed to set $key (may require root)"
            fi
        fi
    done
    if [ "$target" = "host" ] && [ "$OS" = "Linux" ] && [ "${#persisted[@]}" -gt 0 ]; then
        local conf="/etc/sysctl.d/99-minithor.conf"
        echo "  Persisting to $conf"
        printf '%s\n' "${persisted[@]}" | sudo tee "$conf" >/dev/null 2>&1 || echo "    WARNING: failed to write $conf"
    fi
}

# Map the in-cluster registry's service DNS name to its ClusterIP in the minikube
# node's /etc/hosts. The node's container runtime pulls images using the node's
# resolver (not CoreDNS), so without this it cannot resolve REGISTRY_HOST and
# image pulls fail with "no such host". Idempotent; no-op when the registry isn't
# deployed. The docker driver regenerates /etc/hosts on node restart, so this is
# re-asserted on every `minithor start`.
ensure_registry_node_dns() {
    local ip
    ip="$(kctl get svc docker-registry -n "$REGISTRY_NAMESPACE" -o jsonpath='{.spec.clusterIP}' 2>/dev/null)" || return 0
    [ -n "$ip" ] || return 0
    echo "  Mapping ${REGISTRY_HOST} -> ${ip} on the minikube node"
    # /etc/hosts is a bind-mount in the node; rewrite in place (rename-based edits
    # like `sed -i` fail with "Device or resource busy").
    minikube ssh -- "sudo cp /etc/hosts /tmp/minithor-hosts && \
        grep -v ' ${REGISTRY_HOST}\$' /tmp/minithor-hosts | sudo tee /etc/hosts >/dev/null && \
        echo '${ip} ${REGISTRY_HOST}' | sudo tee -a /etc/hosts >/dev/null" >/dev/null 2>&1 \
        || echo "    WARNING: failed to set registry hosts entry on the minikube node"
}

# Make the minikube node able to pull images through the host's HTTP proxy and,
# behind a TLS-intercepting proxy, trust its CA. This is required because
# minikube's own proxy propagation into the node runtime is unreliable (it can
# bake empty HTTP_PROXY/HTTPS_PROXY), so the container runtime otherwise dials
# external registries (quay.io, ghcr.io, ...) directly and times out.
#
#   setup_node_pull_env [certs_path] [force]
#
# certs_path (optional): a .crt file, or a directory of *.crt files, to install
# into the node's trust store. Gated — cert injection only happens when given.
# force (optional, "true"/"false", default false): when true, overwrite the CA
# and the runtime proxy drop-in on the node even if they already exist. By
# default an existing file is left in place so a manual fix isn't clobbered.
# Proxy config is driven entirely by the host's HTTP_PROXY/HTTPS_PROXY and is a
# no-op on unproxied hosts. The drop-in targets whichever runtime pulls images on
# the node: dockerd for the docker/kvm2 drivers' default runtime, containerd for
# podman (started with --container-runtime=containerd). Files are copied with
# `minikube cp` (piping through `minikube ssh` stdin hangs), which also keeps
# proxy URLs (which may embed credentials) off command lines and out of shell
# quoting. Driver-agnostic: everything goes through `minikube cp` / `minikube
# ssh`, so it works for docker, podman, and kvm2.
setup_node_pull_env() {
    local certs_path="${1:-}"
    local force="${2:-false}"
    local changed=false

    # The node reports its runtime as e.g. "docker://28.1.1" or "containerd://1.7"
    local runtime_service
    runtime_service=$(kctl get node minikube -o jsonpath='{.status.nodeInfo.containerRuntimeVersion}' 2>/dev/null | cut -d: -f1) || true
    case "$runtime_service" in
        docker|containerd) ;;
        *)
            echo "  WARNING: could not detect the node's container runtime, assuming containerd" >&2
            runtime_service=containerd
            ;;
    esac

    # --- Certs (gated on a caller-supplied path) ---
    if [ -n "$certs_path" ]; then
        local certs=()
        if [ -f "$certs_path" ]; then
            certs=("$certs_path")
        elif [ -d "$certs_path" ]; then
            local f
            for f in "$certs_path"/*.crt; do
                [ -e "$f" ] && certs+=("$f")
            done
        else
            echo "  WARNING: --certs path '$certs_path' is not a file or directory, skipping cert install" >&2
        fi
        if [ "${#certs[@]}" -eq 0 ]; then
            echo "  No .crt files found at '$certs_path', skipping cert install"
        else
            local cert base
            for cert in "${certs[@]}"; do
                base="$(basename "$cert")"
                # Existence gate: leave an already-installed CA alone so a
                # manual fix on the node isn't clobbered (unless --force-node-config).
                if [ "$force" != true ] \
                    && minikube ssh -- "test -f /usr/local/share/ca-certificates/$base" >/dev/null 2>&1; then
                    echo "  CA '$base' already present on the minikube node, leaving it in place (use --force-node-config to overwrite)"
                    continue
                fi
                echo "  Installing CA '$base' into the minikube node trust store"
                if minikube cp "$cert" "/tmp/$base" >/dev/null 2>&1 \
                    && minikube ssh -- "sudo cp /tmp/$base /usr/local/share/ca-certificates/$base" >/dev/null 2>&1; then
                    changed=true
                else
                    echo "    WARNING: failed to copy '$base' to the minikube node" >&2
                fi
            done
            if [ "$changed" = true ]; then
                minikube ssh -- "sudo update-ca-certificates" >/dev/null 2>&1 \
                    || echo "    WARNING: update-ca-certificates failed on the minikube node" >&2
            fi
        fi
    fi

    # --- Proxy (driven by the host env; no-op when unset) ---
    if [ -n "${HTTP_PROXY:-}${HTTPS_PROXY:-}${http_proxy:-}${https_proxy:-}" ]; then
        local http_p="${HTTP_PROXY:-${http_proxy:-}}"
        local https_p="${HTTPS_PROXY:-${https_proxy:-${HTTP_PROXY:-${http_proxy:-}}}}"
        local no_p
        no_p="$(compute_no_proxy)"
        local dropin_dir="/etc/systemd/system/${runtime_service}.service.d"
        local dropin="${dropin_dir}/http-proxy.conf"
        # Existence gate: if the drop-in is already on the node, leave it alone so
        # a manual fix to minikube's proxy propagation isn't clobbered (unless
        # --force-node-config).
        if [ "$force" != true ] \
            && minikube ssh -- "test -f $dropin" >/dev/null 2>&1; then
            echo "  ${runtime_service} proxy drop-in already present on the minikube node, leaving it in place (use --force-node-config to overwrite)"
        else
            # systemd expands % specifiers in Environment=, so URL-encoded
            # characters in the proxy URLs must be written as %%
            local dropin_tmp
            dropin_tmp=$(umask 077; mktemp)
            printf '[Service]\nEnvironment="HTTP_PROXY=%s"\nEnvironment="HTTPS_PROXY=%s"\nEnvironment="NO_PROXY=%s"\n' \
                "${http_p//\%/%%}" "${https_p//\%/%%}" "${no_p//\%/%%}" > "$dropin_tmp"
            if minikube cp "$dropin_tmp" /tmp/minithor-http-proxy.conf >/dev/null 2>&1 \
                && minikube ssh -- "sudo mkdir -p $dropin_dir && \
                    sudo install -m 600 /tmp/minithor-http-proxy.conf $dropin && \
                    rm -f /tmp/minithor-http-proxy.conf" >/dev/null 2>&1; then
                echo "  Configured the minikube node's ${runtime_service} to use the host HTTP proxy"
                changed=true
            else
                echo "    WARNING: failed to write the ${runtime_service} proxy drop-in on the minikube node" >&2
            fi
            rm -f "$dropin_tmp"
        fi
    fi

    # --- Apply (reload + restart the runtime only if something changed) ---
    if [ "$changed" = true ]; then
        echo "  Reloading and restarting ${runtime_service} on the minikube node"
        minikube ssh -- "sudo systemctl daemon-reload && sudo systemctl restart ${runtime_service}" >/dev/null 2>&1 \
            || echo "    WARNING: failed to restart ${runtime_service} on the minikube node" >&2
    fi
}

clear_finalizers_and_delete() {
    local crd=$1 resource_type=$2 namespace=$3
    if kctl get crd "$crd" &>/dev/null; then
        for item in $(kctl get "$resource_type" -n "$namespace" -o name 2>/dev/null); do
            run_step kctl patch "$item" -n "$namespace" --type merge -p '{"metadata":{"finalizers":[]}}'
        done
        run_step kctl delete "$resource_type" --all -n "$namespace" --ignore-not-found --timeout=60s
    fi
}

force_delete_ns() {
    local ns=$1
    echo "Force-clearing finalizers on stuck namespace '$ns'..."
    # kubectl pretty-prints JSON across lines, so flatten it before blanking every
    # finalizers array with a single-line pattern
    kctl get ns "$ns" -o json \
        | tr -d '\n' \
        | sed 's/"finalizers": *\[[^]]*\]/"finalizers": []/g' \
        | kctl replace --raw "/api/v1/namespaces/$ns/finalize" -f -
}

