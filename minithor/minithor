kind: Kibana
metadata:
  name: elastic
  namespace: $ELASTIC_NAMESPACE
spec:
  version: 8.19.2
  count: 1
  elasticsearchRef:
    name: elastic
  podTemplate:
    spec:
      containers:
      - name: kibana
        resources:
