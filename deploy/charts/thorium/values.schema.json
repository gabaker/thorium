{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Thorium umbrella chart values",
  "type": "object",
  "properties": {
    "global": {
      "type": "object",
      "properties": {
        "clusterDomain": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "clusterCIDRs": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string",
            "pattern": "^[0-9a-fA-F:.]+/[0-9]{1,3}$"
          }
        },
        "imageRegistry": {
          "type": "string",
          "pattern": "^([^/\\s]+(/[^\\s]*[^/\\s])?)?$"
        },
        "managed": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "scylla": {
              "type": "boolean"
            },
            "elastic": {
              "type": "boolean"
            },
            "redis": {
              "type": "boolean"
            },
            "s3": {
              "type": "boolean"
            },
            "postgres": {
              "type": "boolean"
            }
          }
        },
        "quickwit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "s3Endpoint": {
              "type": "string",
              "pattern": "^(https?://.*)?$"
            },
            "metastoreUri": {
              "type": "string",
              "pattern": "^(postgres(ql)?://.*)?$"
            }
          }
        },
        "elasticIndices": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sampleResults": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "repoResults": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "sampleTags": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            },
            "repoTags": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]*$"
            }
          }
        },
        "credentials": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "thoriumSecretKey": {
              "type": "string"
            },
            "redisPassword": {
              "type": "string"
            },
            "scyllaUsername": {
              "type": "string",
              "minLength": 1
            },
            "scyllaPassword": {
              "type": "string"
            },
            "elasticUsername": {
              "type": "string",
              "minLength": 1
            },
            "elasticPassword": {
              "type": "string"
            },
            "s3AccessKey": {
              "type": "string"
            },
            "s3SecretToken": {
              "type": "string"
            },
            "postgresPassword": {
              "type": "string"
            },
            "adminUsername": {
              "type": "string",
              "minLength": 1
            },
            "adminPassword": {
              "type": "string"
            },
            "registryPassword": {
              "type": "string"
            }
          }
        },
        "manageSecretUpdates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "redis": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "s3": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "postgres": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "scylla": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object"
    },
    "infra": {
      "type": "object"
    },
    "quickwit": {
      "type": "object"
    },
    "operator": {
      "type": "object"
    }
  }
}
