{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Thorium chart values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "cluster": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "imagePullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "config": {
          "type": "object"
        },
        "configSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "key": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "none",
            "nginx",
            "traefik"
          ]
        }
      }
    },
    "toolbox": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https?://.*)?$"
        },
        "json": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "skip-conflicts",
            "overwrite"
          ]
        },
        "groupOverride": {
          "type": "string"
        }
      }
    }
  }
}
