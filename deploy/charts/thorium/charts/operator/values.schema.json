{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Thorium chart values",
  "type": "object",
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecret": {
      "type": "object",
      "properties": {
        "create": {
          "type": "boolean"
        },
        "dockerconfigjson": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "cluster": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "imagePullPolicy": {
          "enum": [
            "",
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "namespaceBlacklist": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "config": {
          "type": "object"
        },
        "configSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "key": {
                "type": "string"
              }
            }
          }
        },
        "bootstrap": {
          "type": "object",
          "properties": {
            "admin": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "secretName": {
                  "type": "string"
                }
              }
            },
            "scylla": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "dropDefaultRole": {
                  "type": "boolean"
                },
                "adminSecret": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "username": {
                      "type": "string"
                    },
                    "usernameKey": {
                      "type": "string"
                    },
                    "passwordKey": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "elastic": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "adminSecret": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "username": {
                      "type": "string"
                    },
                    "usernameKey": {
                      "type": "string"
                    },
                    "passwordKey": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "uninstallHook": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 10
        },
        "resources": {
          "type": ["object", "null"]
        },
        "podSecurityContext": {
          "type": ["object", "null"]
        },
        "securityContext": {
          "type": ["object", "null"]
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "none",
            "nginx",
            "traefik"
          ]
        }
      }
    },
    "toolbox": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https?://.*)?$"
        },
        "json": {
          "type": "string"
        },
        "mode": {
          "enum": [
            "skip-conflicts",
            "overwrite"
          ]
        },
        "groupOverride": {
          "type": "string"
        }
      }
    }
  }
}
