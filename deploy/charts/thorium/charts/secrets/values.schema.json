{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Thorium secrets subchart values",
  "type": "object",
  "properties": {
    "createNamespaces": {
      "type": "boolean"
    },
    "renderOnly": {
      "type": "boolean"
    },
    "allowRegenerate": {
      "type": "boolean"
    },
    "registryBasicAuth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "username": {
          "type": "string",
          "pattern": "^[^:\\s]*$"
        },
        "htpasswd": {
          "type": "string"
        }
      }
    }
  }
}
