{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Thorium secrets subchart values",
  "type": "object",
  "properties": {
    "createNamespaces": {
      "type": "boolean"
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "thoriumSecretKey": {
          "type": "string"
        },
        "redisPassword": {
          "type": "string"
        },
        "scyllaUsername": {
          "type": "string",
          "minLength": 1
        },
        "scyllaPassword": {
          "type": "string"
        },
        "elasticUsername": {
          "type": "string",
          "minLength": 1
        },
        "elasticPassword": {
          "type": "string"
        },
        "s3AccessKey": {
          "type": "string"
        },
        "s3SecretToken": {
          "type": "string"
        },
        "postgresPassword": {
          "type": "string"
        },
        "adminUsername": {
          "type": "string",
          "minLength": 1
        },
        "adminPassword": {
          "type": "string"
        },
        "registryPassword": {
          "type": "string"
        }
      }
    },
    "renderOnly": {
      "type": "boolean"
    },
    "allowRegenerate": {
      "type": "boolean"
    },
    "registryBasicAuth": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "username": {
          "type": "string",
          "pattern": "^[^:\\s]*$"
        },
        "htpasswd": {
          "type": "string"
        }
      }
    }
  }
}
